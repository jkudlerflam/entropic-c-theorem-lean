import ModularCTheorem.GeometryExtra
import ModularCTheorem.Araki.MutualInfo

/-!
# N. The net of diamond algebras, wedge algebras, type I ladders, finiteness (T7)

`CNet H` packages exactly the hypotheses on the net used by the proof of the c-theorem (note,
Thm. 1): isotony, locality, boost covariance with a boost-invariant vector, generation of a diamond
algebra by the algebras of diamonds compactly inside it, split inclusions and finite mutual
information across a gap (Assumption 1). Positive energy, translations and uniqueness of the vacuum
are never used. Separability of `H` is not part of the structure; it enters only through the
four-term inequality for type I factors (`TypeI/SSA.lean`).

## Main results

* `CNet.AL a`, `CNet.AR b`, the wedge algebras `𝒜(L_a)`, `𝒜(R_b)`, generated by the algebras of
  the diamonds inside the wedge, with `AL_anti`, `AR_anti` (monotonicity in the parameter).
* `CNet.AL_le_commutant`, `CNet.A_le_commutant_AR`, locality between a wedge and a diamond in the
  opposite wedge.
* `CNet.exists_boost`, boost covariance `U 𝒜(L_a) U⋆ = 𝒜(L_{μ a})`, `U 𝒜(R_b) U⋆ = 𝒜(R_{b/μ})`.
* `CNet.A_eq_generated_exhaustion`, `CNet.AL_eq_generated_leftExhaust`,
  `CNet.AR_eq_generated_rightExhaust`, exhaustions by `CompactIn`-chains of diamonds.
* `HasTypeILadder B S` and `CNet.hasTypeILadder_AL`, `CNet.hasTypeILadder_AR`,
  `CNet.hasTypeILadder_A`, increasing type I factors `X' k ≤ X k` generating `S ≤ B`.
* `CNet.mutualInfo_AL_ne_top`, `CNet.mutualInfo_AL_ne_bot` (T7). `I(L_a : Y)` is finite for a
  diamond `Y ⊆ R_b` and `a, b > 0`. Mirror statements `mutualInfo_AR_ne_top`,
  `mutualInfo_AR_ne_bot`.
-/

open scoped VonNeumannAlgebra
open VonNeumannAlgebra

namespace CTheorem

noncomputable section

/-- A net `D ↦ 𝒜(D)` of von Neumann algebras on the diamonds of 1+1 Minkowski space with a vector
`Ω`, satisfying the hypotheses of the entropic c-theorem (and nothing else). -/
structure CNet (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] where
  /-- The algebra `𝒜(D)` of a diamond. -/
  A : Diamond → VonNeumannAlgebra H
  /-- The vacuum vector. -/
  Ω : H
  /-- Isotony. -/
  isotony : ∀ D D' : Diamond, D.toSet ⊆ D'.toSet → A D ≤ A D'
  /-- Locality. -/
  locality : ∀ D D' : Diamond, SpacelikeSets D.toSet D'.toSet → A D ≤ (A D')′
  /-- Boost covariance, with a boost-invariant vacuum. -/
  covariance : ∀ (μ : ℝ) (hμ : 0 < μ), ∃ U : H ≃ₗᵢ[ℂ] H, U Ω = Ω ∧
    ∀ D : Diamond, conj U (A D) = A (D.boost μ hμ)
  /-- Generation: `𝒜(Y)` is generated by the `𝒜(D)`, `D ⋐ Y`. -/
  generation : ∀ Y : Diamond,
    A Y = generated (⋃ D : Diamond, ⋃ (_ : D.CompactIn Y), (A D : Set (H →L[ℂ] H)))
  /-- Assumption 1 (split property). -/
  split : ∀ D D' : Diamond, D.CompactIn D' → IsSplitInclusion (A D) (A D')
  /-- Assumption 1 (finite mutual information across a gap). -/
  finiteMI : ∀ D D' : Diamond, D.CompactIn D' → mutualInfo Ω (A D) (A D')′ ≠ ⊤

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-! ### Generic facts -/

/-- For commuting algebras the mutual information is never `⊥`: it is `⊤` or the relative entropy
with respect to the product functional, which is `≠ ⊥`. -/
theorem mutualInfo_ne_bot_of_le_commutant {Ω : H} {X Z : VonNeumannAlgebra H}
    (hXZ : X ≤ Z′) : mutualInfo Ω X Z ≠ ⊥ := by
  by_cases h : mutualInfo Ω X Z = ⊤
  · rw [h]
    exact top_ne_bot
  · obtain ⟨φ, hφ⟩ := exists_isProduct_of_ne_top h
    rw [mutualInfo_eq_arakiEntropy hXZ hφ]
    exact arakiEntropy_ne_bot _ _

/-- A **type I ladder** for an inclusion `S ≤ B`: increasing type I factors `X' k ≤ X k` with
`B = (⋃ X k)''` and `S = (⋃ X' k)''`. -/
def HasTypeILadder (B S : VonNeumannAlgebra H) : Prop :=
  ∃ X X' : ℕ → VonNeumannAlgebra H, Monotone X ∧ Monotone X' ∧
    (∀ k, IsTypeIFactor (X k)) ∧ (∀ k, IsTypeIFactor (X' k)) ∧ (∀ k, X' k ≤ X k) ∧
    B = generated (⋃ k, (X k : Set (H →L[ℂ] H))) ∧
    S = generated (⋃ k, (X' k : Set (H →L[ℂ] H)))

/-- **Type I ladders from split chains.** If `P n ≤ P (n+1)` and `P' n ≤ P' (n+1)` are split and
every `P' n` lies in some `P m`, then `(⋃ P')'' ≤ (⋃ P)''` has a type I ladder. The ladder is
`X' k = T' k` and `X k = T (j k)`, where `P n ≤ T n ≤ P (n+1)` and `P' n ≤ T' n ≤ P' (n+1)` are the
interpolating type I factors and `j` is a monotone reindexing with `P' (k+1) ≤ P (j k)`. -/
theorem hasTypeILadder_of_split {P P' : ℕ → VonNeumannAlgebra H}
    (hP : ∀ n, IsSplitInclusion (P n) (P (n + 1)))
    (hP' : ∀ n, IsSplitInclusion (P' n) (P' (n + 1)))
    (hcof : ∀ n, ∃ m, P' n ≤ P m) :
    HasTypeILadder (generated (⋃ n, (P n : Set (H →L[ℂ] H))))
      (generated (⋃ n, (P' n : Set (H →L[ℂ] H)))) := by
  choose T hT hPT hTP using hP
  choose T' hT' hPT' hTP' using hP'
  have hPm : Monotone P := monotone_nat_of_le_succ fun n => (hPT n).trans (hTP n)
  have hTm : Monotone T := monotone_nat_of_le_succ fun n => (hTP n).trans (hPT (n + 1))
  have hT'm : Monotone T' := monotone_nat_of_le_succ fun n => (hTP' n).trans (hPT' (n + 1))
  choose f hf using fun n => hcof (n + 1)
  let j : ℕ → ℕ := fun k => k + ∑ i ∈ Finset.range (k + 1), f i
  have hjm : Monotone j := monotone_nat_of_le_succ fun k => by
    simp only [j, Finset.sum_range_succ]
    omega
  have hfj : ∀ k, f k ≤ j k := fun k => by
    have : f k ≤ ∑ i ∈ Finset.range (k + 1), f i :=
      Finset.single_le_sum (fun i _ => Nat.zero_le (f i)) (Finset.self_mem_range_succ k)
    simp only [j]
    omega
  have hkj : ∀ k, k ≤ j k := fun k => Nat.le_add_right _ _
  refine ⟨fun k => T (j k), T', hTm.comp hjm, hT'm, fun k => hT (j k), hT', ?_, ?_, ?_⟩
  · intro k
    exact (hTP' k).trans ((hf k).trans ((hPm (hfj k)).trans (hPT (j k))))
  · apply le_antisymm
    · apply generated_mono
      refine Set.iUnion_subset fun n => ?_
      intro x hx
      exact Set.mem_iUnion.mpr ⟨n, hTm (hkj n) (hPT n hx)⟩
    · apply generated_le
      refine Set.iUnion_subset fun k => ?_
      intro x hx
      exact mem_generated_of_mem (Set.mem_iUnion.mpr ⟨j k + 1, hTP (j k) hx⟩)
  · apply le_antisymm
    · apply generated_mono
      refine Set.iUnion_subset fun n => ?_
      intro x hx
      exact Set.mem_iUnion.mpr ⟨n, hPT' n hx⟩
    · apply generated_le
      refine Set.iUnion_subset fun k => ?_
      intro x hx
      exact mem_generated_of_mem (Set.mem_iUnion.mpr ⟨k + 1, hTP' k hx⟩)

namespace CNet

variable (N : CNet H)

/-! ### Wedge algebras -/

/-- The left wedge algebra `𝒜(L_a)`, generated by the `𝒜(D)` with `D ⊆ L_a`. -/
def AL (a : ℝ) : VonNeumannAlgebra H :=
  generated (⋃ D : Diamond, ⋃ (_ : D.toSet ⊆ leftWedge a), (N.A D : Set (H →L[ℂ] H)))

/-- The right wedge algebra `𝒜(R_b)`, generated by the `𝒜(D)` with `D ⊆ R_b`. -/
def AR (b : ℝ) : VonNeumannAlgebra H :=
  generated (⋃ D : Diamond, ⋃ (_ : D.toSet ⊆ rightWedge b), (N.A D : Set (H →L[ℂ] H)))

theorem A_le_AL {a : ℝ} {D : Diamond} (hD : D.toSet ⊆ leftWedge a) : N.A D ≤ N.AL a :=
  fun _ hx => mem_generated_of_mem (Set.mem_iUnion₂.mpr ⟨D, hD, hx⟩)

theorem A_le_AR {b : ℝ} {D : Diamond} (hD : D.toSet ⊆ rightWedge b) : N.A D ≤ N.AR b :=
  fun _ hx => mem_generated_of_mem (Set.mem_iUnion₂.mpr ⟨D, hD, hx⟩)

theorem AL_le {a : ℝ} {M : VonNeumannAlgebra H}
    (h : ∀ D : Diamond, D.toSet ⊆ leftWedge a → N.A D ≤ M) : N.AL a ≤ M :=
  generated_le (Set.iUnion₂_subset fun D hD _ hx => h D hD hx)

theorem AR_le {b : ℝ} {M : VonNeumannAlgebra H}
    (h : ∀ D : Diamond, D.toSet ⊆ rightWedge b → N.A D ≤ M) : N.AR b ≤ M :=
  generated_le (Set.iUnion₂_subset fun D hD _ hx => h D hD hx)

/-- `L_A ⊆ L_a` for `a ≤ A`, hence `𝒜(L_A) ≤ 𝒜(L_a)`. -/
theorem AL_anti {a A : ℝ} (h : a ≤ A) : N.AL A ≤ N.AL a :=
  N.AL_le fun _ hD => N.A_le_AL (hD.trans (leftWedge_anti h))

/-- `R_B ⊆ R_b` for `b ≤ B`, hence `𝒜(R_B) ≤ 𝒜(R_b)`. -/
theorem AR_anti {b B : ℝ} (h : b ≤ B) : N.AR B ≤ N.AR b :=
  N.AR_le fun _ hD => N.A_le_AR (hD.trans (rightWedge_anti h))

/-! ### Locality between a wedge and a diamond in the opposite wedge -/

theorem AL_le_commutant {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) {Y : Diamond}
    (hY : Y.toSet ⊆ rightWedge b) : N.AL a ≤ (N.A Y)′ :=
  N.AL_le fun D hD => N.locality D Y ((spacelike_leftWedge_rightWedge ha hb).mono hD hY)

theorem AR_le_commutant {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) {X : Diamond}
    (hX : X.toSet ⊆ leftWedge a) : N.AR b ≤ (N.A X)′ :=
  N.AR_le fun D hD => N.locality D X ((spacelike_leftWedge_rightWedge ha hb).symm.mono hD hX)

theorem A_le_commutant_AR {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) {X : Diamond}
    (hX : X.toSet ⊆ leftWedge a) : N.A X ≤ (N.AR b)′ :=
  le_commutant_comm (N.AR_le_commutant ha hb hX)

/-! ### Boost covariance of the wedge algebras -/

theorem conj_AL {μ : ℝ} (hμ : 0 < μ) {U : H ≃ₗᵢ[ℂ] H}
    (hU : ∀ D : Diamond, conj U (N.A D) = N.A (D.boost μ hμ)) (a : ℝ) :
    conj U (N.AL a) = N.AL (μ * a) := by
  rw [AL, AL, conj_generated, Set.image_iUnion₂]
  congr 1
  ext x
  simp only [Set.mem_iUnion]
  constructor
  · rintro ⟨D, hD, hx⟩
    refine ⟨D.boost μ hμ, (D.boost_subset_leftWedge_iff hμ).mpr hD, ?_⟩
    rw [← hU D, coe_conj]
    exact hx
  · rintro ⟨D', hD', hx⟩
    obtain ⟨D, hD, rfl⟩ := D'.exists_boost_of_subset_leftWedge hμ hD'
    refine ⟨D, hD, ?_⟩
    rw [← hU D, coe_conj] at hx
    exact hx

theorem conj_AR {μ : ℝ} (hμ : 0 < μ) {U : H ≃ₗᵢ[ℂ] H}
    (hU : ∀ D : Diamond, conj U (N.A D) = N.A (D.boost μ hμ)) (b : ℝ) :
    conj U (N.AR b) = N.AR (b / μ) := by
  rw [AR, AR, conj_generated, Set.image_iUnion₂]
  congr 1
  ext x
  simp only [Set.mem_iUnion]
  constructor
  · rintro ⟨D, hD, hx⟩
    refine ⟨D.boost μ hμ, (D.boost_subset_rightWedge_iff hμ).mpr hD, ?_⟩
    rw [← hU D, coe_conj]
    exact hx
  · rintro ⟨D', hD', hx⟩
    obtain ⟨D, hD, rfl⟩ := D'.exists_boost_of_subset_rightWedge hμ hD'
    refine ⟨D, hD, ?_⟩
    rw [← hU D, coe_conj] at hx
    exact hx

/-- **Boost covariance.** For `μ > 0` there is a unitary `U` with `U Ω = Ω`,
`U 𝒜(D) U⋆ = 𝒜(Λ_μ D)`, `U 𝒜(L_a) U⋆ = 𝒜(L_{μ a})` and `U 𝒜(R_b) U⋆ = 𝒜(R_{b/μ})`. -/
theorem exists_boost (μ : ℝ) (hμ : 0 < μ) :
    ∃ U : H ≃ₗᵢ[ℂ] H, U N.Ω = N.Ω ∧ (∀ D : Diamond, conj U (N.A D) = N.A (D.boost μ hμ)) ∧
      (∀ a, conj U (N.AL a) = N.AL (μ * a)) ∧ (∀ b, conj U (N.AR b) = N.AR (b / μ)) := by
  obtain ⟨U, hUΩ, hU⟩ := N.covariance μ hμ
  exact ⟨U, hUΩ, hU, N.conj_AL hμ hU, N.conj_AR hμ hU⟩

/-! ### Exhaustions -/

/-- A diamond algebra is generated by the algebras of any cofinal family of diamonds compactly
inside the diamond (generation axiom). -/
theorem A_eq_generated_exhaustion {Y : Diamond} {E : ℕ → Diamond} (hE : ∀ n, (E n).CompactIn Y)
    (hcof : ∀ Z : Diamond, Z.CompactIn Y → ∃ n, Z.toSet ⊆ (E n).toSet) :
    N.A Y = generated (⋃ n, (N.A (E n) : Set (H →L[ℂ] H))) := by
  apply le_antisymm
  · rw [N.generation Y]
    apply generated_le
    refine Set.iUnion₂_subset fun D hD => ?_
    obtain ⟨n, hn⟩ := hcof D hD
    intro x hx
    exact mem_generated_of_mem (Set.mem_iUnion.mpr ⟨n, N.isotony D (E n) hn hx⟩)
  · apply generated_le
    refine Set.iUnion_subset fun n => ?_
    intro x hx
    exact N.isotony (E n) Y (hE n).subset hx

/-- `𝒜(L_a)` is generated by the algebras of the explicit exhaustion `leftExhaust a`. -/
theorem AL_eq_generated_leftExhaust (a : ℝ) :
    N.AL a = generated (⋃ n, (N.A (leftExhaust a n) : Set (H →L[ℂ] H))) := by
  apply le_antisymm
  · refine N.AL_le fun D hD => ?_
    rw [N.generation D]
    apply generated_le
    refine Set.iUnion₂_subset fun D' hD' => ?_
    obtain ⟨n, hn⟩ := exists_subset_leftExhaust (hD'.compactInLeft hD)
    intro x hx
    exact mem_generated_of_mem (Set.mem_iUnion.mpr ⟨n, N.isotony D' _ hn hx⟩)
  · apply generated_le
    refine Set.iUnion_subset fun n => ?_
    intro x hx
    exact N.A_le_AL (leftExhaust_subset a n) hx

/-- `𝒜(R_b)` is generated by the algebras of the explicit exhaustion `rightExhaust b`. -/
theorem AR_eq_generated_rightExhaust (b : ℝ) :
    N.AR b = generated (⋃ n, (N.A (rightExhaust b n) : Set (H →L[ℂ] H))) := by
  apply le_antisymm
  · refine N.AR_le fun D hD => ?_
    rw [N.generation D]
    apply generated_le
    refine Set.iUnion₂_subset fun D' hD' => ?_
    obtain ⟨n, hn⟩ := exists_subset_rightExhaust (hD'.compactInRight hD)
    intro x hx
    exact mem_generated_of_mem (Set.mem_iUnion.mpr ⟨n, N.isotony D' _ hn hx⟩)
  · apply generated_le
    refine Set.iUnion_subset fun n => ?_
    intro x hx
    exact N.A_le_AR (rightExhaust_subset b n) hx

/-! ### Type I ladders -/

/-- Type I ladders from two `CompactIn`-chains of diamonds, the second cofinal in the first. -/
theorem hasTypeILadder_of_chains {E E' : ℕ → Diamond} (hE : ∀ n, (E n).CompactIn (E (n + 1)))
    (hE' : ∀ n, (E' n).CompactIn (E' (n + 1)))
    (hcof : ∀ n, ∃ m, (E' n).toSet ⊆ (E m).toSet) :
    HasTypeILadder (generated (⋃ n, (N.A (E n) : Set (H →L[ℂ] H))))
      (generated (⋃ n, (N.A (E' n) : Set (H →L[ℂ] H)))) :=
  hasTypeILadder_of_split (fun n => N.split _ _ (hE n)) (fun n => N.split _ _ (hE' n))
    fun n => (hcof n).imp fun _ hm => N.isotony _ _ hm

/-- **Type I ladder for `𝒜(L_A) ≤ 𝒜(L_a)`**, `a ≤ A`. -/
theorem hasTypeILadder_AL {a A : ℝ} (h : a ≤ A) : HasTypeILadder (N.AL a) (N.AL A) := by
  rw [N.AL_eq_generated_leftExhaust a, N.AL_eq_generated_leftExhaust A]
  exact N.hasTypeILadder_of_chains (leftExhaust_compactIn_succ a) (leftExhaust_compactIn_succ A)
    fun n => exists_subset_leftExhaust ((leftExhaust_compactInLeft A n).anti h)

/-- **Type I ladder for `𝒜(R_B) ≤ 𝒜(R_b)`**, `b ≤ B`. -/
theorem hasTypeILadder_AR {b B : ℝ} (h : b ≤ B) : HasTypeILadder (N.AR b) (N.AR B) := by
  rw [N.AR_eq_generated_rightExhaust b, N.AR_eq_generated_rightExhaust B]
  exact N.hasTypeILadder_of_chains (rightExhaust_compactIn_succ b)
    (rightExhaust_compactIn_succ B)
    fun n => exists_subset_rightExhaust ((rightExhaust_compactInRight B n).anti h)

/-- **Type I ladder for `𝒜(Y₁) ≤ 𝒜(Y₂)`**, `Y₁ ⊆ Y₂`. -/
theorem hasTypeILadder_A {Y₁ Y₂ : Diamond} (h : Y₁.toSet ⊆ Y₂.toSet) :
    HasTypeILadder (N.A Y₂) (N.A Y₁) := by
  obtain ⟨E₂, hE₂, hE₂Y, hcof₂⟩ := Diamond.exhaustion Y₂
  obtain ⟨E₁, hE₁, hE₁Y, hcof₁⟩ := Diamond.exhaustion Y₁
  rw [N.A_eq_generated_exhaustion hE₂Y hcof₂, N.A_eq_generated_exhaustion hE₁Y hcof₁]
  exact N.hasTypeILadder_of_chains hE₂ hE₁ fun n => hcof₂ (E₁ n) ((hE₁Y n).of_subset h)

/-! ### T7. Finiteness of the mutual informations -/

/-- **T7.** For `a, b > 0` and a diamond `Y ⊆ R_b`, `I(L_a : Y) < ∞`: a diamond `D̂ ⋑ Y` spacelike
to `L_a` gives `I(L_a : Y) ≤ I(𝒜(D̂)′ : 𝒜(Y)) = I(𝒜(Y) : 𝒜(D̂)′) < ∞`. -/
theorem mutualInfo_AL_ne_top {a b : ℝ} (ha : 0 < a) (hb : 0 < b) {Y : Diamond}
    (hY : Y.toSet ⊆ rightWedge b) : mutualInfo N.Ω (N.AL a) (N.A Y) ≠ ⊤ := by
  obtain ⟨D, hYD, hsep⟩ := Y.exists_separating_of_subset_rightWedge ha hb hY
  have hle : N.AL a ≤ (N.A D)′ :=
    N.AL_le fun D' hD' => N.locality D' D (hsep.mono hD' subset_rfl)
  refine ne_top_of_le_ne_top (N.finiteMI Y D hYD) ?_
  calc mutualInfo N.Ω (N.AL a) (N.A Y) ≤ mutualInfo N.Ω (N.A D)′ (N.A Y) :=
        mutualInfo_mono hle le_rfl
    _ = mutualInfo N.Ω (N.A Y) (N.A D)′ := mutualInfo_comm

theorem mutualInfo_AL_ne_bot {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) {Y : Diamond}
    (hY : Y.toSet ⊆ rightWedge b) : mutualInfo N.Ω (N.AL a) (N.A Y) ≠ ⊥ :=
  mutualInfo_ne_bot_of_le_commutant (N.AL_le_commutant ha hb hY)

/-- **T7, mirror.** For `a, b > 0` and a diamond `X ⊆ L_a`, `I(X : R_b) < ∞`. -/
theorem mutualInfo_AR_ne_top {a b : ℝ} (ha : 0 < a) (hb : 0 < b) {X : Diamond}
    (hX : X.toSet ⊆ leftWedge a) : mutualInfo N.Ω (N.A X) (N.AR b) ≠ ⊤ := by
  obtain ⟨D, hXD, hsep⟩ := X.exists_separating_of_subset_leftWedge ha hb hX
  have hle : N.AR b ≤ (N.A D)′ :=
    N.AR_le fun D' hD' => N.locality D' D (hsep.symm.mono hD' subset_rfl)
  exact ne_top_of_le_ne_top (N.finiteMI X D hXD) (mutualInfo_mono le_rfl hle)

theorem mutualInfo_AR_ne_bot {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) {X : Diamond}
    (hX : X.toSet ⊆ leftWedge a) : mutualInfo N.Ω (N.A X) (N.AR b) ≠ ⊥ :=
  mutualInfo_ne_bot_of_le_commutant (N.A_le_commutant_AR ha hb hX)

end CNet

end

end CTheorem
