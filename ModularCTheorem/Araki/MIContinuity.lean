import ModularCTheorem.Araki.MutualInfo
import ModularCTheorem.Araki.Continuity

/-!
# Upward continuity of the mutual information

The interface used by `ModularCTheorem.CTheorem`, proved from T1 (`Araki/Continuity.lean`, upward
continuity of Araki's relative entropy along increasing sequences of von Neumann subalgebras):
since `I(X∞:Z∞) < ∞` there is a product functional `φ` on `X∞ ∨ Z∞` (`exists_isProduct_of_ne_top`),
its restrictions are the product functionals of the pairs `(X n, Z n)` (`mutualInfo_eq_restrict`),
and the algebras `X n ∨ Z n` increase and generate `X∞ ∨ Z∞`, so
`S_{X n ∨ Z n}(ω ‖ φ) → S_{X∞ ∨ Z∞}(ω ‖ φ)` (`tendsto_arakiEntropy_of_apply_eq`).
-/

open scoped VonNeumannAlgebra Topology
open VonNeumannAlgebra Filter

namespace CTheorem

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- If `X n` and `Z n` generate `Xinf` and `Zinf`, the join `Xinf ∨ Zinf` is generated by the
joins `X n ∨ Z n`. -/
lemma join_le_generated_iUnion_join {X Z : ℕ → VonNeumannAlgebra H}
    {Xinf Zinf : VonNeumannAlgebra H}
    (hXinf : Xinf = generated (⋃ n, (X n : Set (H →L[ℂ] H))))
    (hZinf : Zinf = generated (⋃ n, (Z n : Set (H →L[ℂ] H)))) :
    join Xinf Zinf ≤ generated (⋃ n, (join (X n) (Z n) : Set (H →L[ℂ] H))) := by
  refine join_le ?_ ?_
  · rw [hXinf]
    refine generated_le fun x hx => ?_
    obtain ⟨n, hn⟩ := Set.mem_iUnion.1 hx
    exact mem_generated_of_mem (Set.mem_iUnion.2 ⟨n, le_join_left (X n) (Z n) hn⟩)
  · rw [hZinf]
    refine generated_le fun z hz => ?_
    obtain ⟨n, hn⟩ := Set.mem_iUnion.1 hz
    exact mem_generated_of_mem (Set.mem_iUnion.2 ⟨n, le_join_right (X n) (Z n) hn⟩)

/-- **Upward continuity of the mutual information.** If `X n ↑` and `Z n ↑` generate `Xinf` and
`Zinf`, `Xinf ≤ Zinf′` and `I(Xinf:Zinf) < ∞`, then `I(X n : Z n) → I(Xinf : Zinf)`.

The finite mutual information has a product functional `φ` on `Xinf ∨ Zinf`; since `X n ≤ (Z n)′`,
`I(X n : Z n)` is the relative entropy of the vector functional with respect to the restriction of
`φ` to `X n ∨ Z n`, and these joins increase and generate `Xinf ∨ Zinf`. -/
theorem tendsto_mutualInfo_of_monotone {Ω : H} {X Z : ℕ → VonNeumannAlgebra H}
    {Xinf Zinf : VonNeumannAlgebra H} (hX : Monotone X) (hZ : Monotone Z)
    (hXinf : Xinf = generated (⋃ n, (X n : Set (H →L[ℂ] H))))
    (hZinf : Zinf = generated (⋃ n, (Z n : Set (H →L[ℂ] H))))
    (hXZ : Xinf ≤ Zinf′) (hfin : mutualInfo Ω Xinf Zinf ≠ ⊤) :
    Tendsto (fun n => mutualInfo Ω (X n) (Z n)) atTop (𝓝 (mutualInfo Ω Xinf Zinf)) := by
  obtain ⟨φ, hφ⟩ := exists_isProduct_of_ne_top hfin
  have hXn : ∀ n, X n ≤ Xinf := fun n x hx => by
    rw [hXinf]
    exact mem_generated_of_mem (Set.mem_iUnion.2 ⟨n, hx⟩)
  have hZn : ∀ n, Z n ≤ Zinf := fun n z hz => by
    rw [hZinf]
    exact mem_generated_of_mem (Set.mem_iUnion.2 ⟨n, hz⟩)
  have hXZn : ∀ n, X n ≤ (Z n)′ := fun n => ((hXn n).trans hXZ).trans (commutant_le (hZn n))
  have hJ : ∀ n, join (X n) (Z n) ≤ join Xinf Zinf := fun n => join_mono (hXn n) (hZn n)
  have h := tendsto_arakiEntropy_of_apply_eq (M := fun n => join (X n) (Z n))
    (N := join Xinf Zinf) (fun _ _ hmn => join_mono (hX hmn) (hZ hmn)) hJ
    (join_le_generated_iUnion_join hXinf hZinf)
    (NormalFunctional.ofVector (join Xinf Zinf) Ω) φ
    (fun n => NormalFunctional.ofVector (join (X n) (Z n)) Ω)
    (fun n => restrict (join_mono (hXn n) (hZn n)) φ) (fun _ _ => rfl) (fun _ _ => rfl)
  rw [mutualInfo_eq_arakiEntropy hXZ hφ]
  exact h.congr fun n => (mutualInfo_eq_restrict (hXn n) (hZn n) (hXZn n) hφ).symm

end CTheorem
