import QuantumSystem.InformationTheory.Entropy.Araki.Monotonicity
import QuantumSystem.Analysis.VonNeumannAlgebra.TypeI.SplitInclusion

/-!
# T2. Mutual information of a vector between two von Neumann algebras

Compiled, no `sorry`. Existence of product functionals for split pairs is deliberately not proved:
the c-theorem never needs it, since a finite mutual information already supplies one
(`exists_isProduct_of_ne_top`).

For von Neumann algebras `X, Z` on `H` and a vector `Ω`, the mutual information is Araki's relative
entropy `I(X:Z) = S_{X ∨ Z}(ω ‖ ω_X ⊗ ω_Z)` of the vector functional `ω = ⟪Ω, (·) Ω⟫` on the
generated algebra `X ∨ Z = join X Z`, relative to a *product functional*: a normal positive
functional `φ` on `X ∨ Z` with `φ(x z) = ω(x) ω(z)` for `x ∈ X`, `z ∈ Z` (`IsProduct`).

## Definition

`mutualInfo Ω X Z` is the infimum of `S⟦ω ∥ φ⟧` over all normal product functionals `φ`, hence `+∞`
when there is none. For commuting `X, Z` the product functional is unique (`isProduct_unique`), so
the infimum is its value (`mutualInfo_eq_arakiEntropy`): this is the blueprint's
`if h : ∃ φ, IsProduct Ω X Z φ then S⟦ω ∥ h.choose⟧ else ⊤`. The infimum form makes symmetry,
monotonicity and unitary covariance hold with no commutation and no type I hypothesis.

## Main results

* `normalFunctional_ext_of_starSubalgebra` — normal functionals agreeing on a unital `⋆`-subalgebra
  `B` agree on every von Neumann algebra `M ≤ B''`. The proof amplifies to `ℓ²(ℕ) ⊗̂ H`, where the
  functionals are vector functionals, and uses `amplifyRight_mem_generated_image`
  (`1 ⊗ s'' ⊆ (1 ⊗ s)''`, a slice argument) and the library's `inner_apply_eq_of_mem_generated`.
* `isProduct_unique` — (a) uniqueness of product functionals for commuting `X, Z`.
* `mutualInfo_eq_arakiEntropy` — `I(X:Z) = S⟦ω ∥ φ⟧` for any product functional, `X ≤ Z′`.
* `mutualInfo_le_of_schwarzMap` — comparison along unital normal Schwarz maps carrying vacuum to
  vacuum and product functionals to product functionals (data-processing inequality).
* `mutualInfo_comm` — (c) symmetry.
* `mutualInfo_mono` — (d) monotonicity, `X' ≤ X → Z' ≤ Z → I(X':Z') ≤ I(X:Z)`, no extra hypothesis.
* `mutualInfo_conj` — (e) covariance under `U : H ≃ₗᵢ H'` with `U Ω = Ω'`.
-/

open scoped InnerProductSpace InnerProduct VonNeumannAlgebra HilbertTensor Araki ComplexOrder lp
open VonNeumannAlgebra
open HilbertTensor (amplifyRight amplifyRightₐ tmulRightL)

namespace CTheorem

noncomputable section

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-! ### The join of two von Neumann algebras -/

section Join

/-- The von Neumann algebra `X ∨ Z` generated by two von Neumann algebras. -/
def join (X Z : VonNeumannAlgebra H) : VonNeumannAlgebra H :=
  generated ((X : Set (H →L[ℂ] H)) ∪ (Z : Set (H →L[ℂ] H)))

lemma le_join_left (X Z : VonNeumannAlgebra H) : X ≤ join X Z := fun _ hx =>
  mem_generated_of_mem (Set.mem_union_left _ hx)

lemma le_join_right (X Z : VonNeumannAlgebra H) : Z ≤ join X Z := fun _ hz =>
  mem_generated_of_mem (Set.mem_union_right _ hz)

lemma le_join_of_le_left {X Y Z : VonNeumannAlgebra H} (h : X ≤ Y) : X ≤ join Y Z :=
  h.trans (le_join_left Y Z)

lemma le_join_of_le_right {X Y Z : VonNeumannAlgebra H} (h : X ≤ Z) : X ≤ join Y Z :=
  h.trans (le_join_right Y Z)

lemma join_le {X Z M : VonNeumannAlgebra H} (hX : X ≤ M) (hZ : Z ≤ M) : join X Z ≤ M :=
  generated_le (Set.union_subset (fun _ hx => hX hx) (fun _ hz => hZ hz))

lemma join_mono {X X' Z Z' : VonNeumannAlgebra H} (hX : X' ≤ X) (hZ : Z' ≤ Z) :
    join X' Z' ≤ join X Z :=
  join_le (le_join_of_le_left hX) (le_join_of_le_right hZ)

lemma join_comm (X Z : VonNeumannAlgebra H) : join X Z = join Z X := by
  rw [join, join, Set.union_comm]

lemma join_assoc (X Y Z : VonNeumannAlgebra H) : join (join X Y) Z = join X (join Y Z) :=
  le_antisymm
    (join_le (join_le (le_join_left _ _) (le_join_of_le_right (le_join_left Y Z)))
      (le_join_of_le_right (le_join_right Y Z)))
    (join_le (le_join_of_le_left (le_join_left X Y))
      (join_le (le_join_of_le_left (le_join_right X Y)) (le_join_right _ _)))

/-- Commutation is symmetric: `X ≤ Z′ → Z ≤ X′`. -/
lemma le_commutant_comm {X Z : VonNeumannAlgebra H} (h : X ≤ Z′) : Z ≤ X′ := fun z hz =>
  mem_commutant_iff.mpr fun _ hx => (mem_commutant_iff.mp (h hx) z hz).symm

/-- An algebra commuting with `X` and with `Z` commutes with `X ∨ Z`. -/
lemma le_commutant_join {X Z W : VonNeumannAlgebra H} (hX : W ≤ X′) (hZ : W ≤ Z′) :
    W ≤ (join X Z)′ := by
  intro w hw
  rw [join, commutant_generated, mem_commutantSet_iff]
  rintro g (hg | hg)
  · exact ⟨mem_commutant_iff.mp (hX hw) g hg, mem_commutant_iff.mp (hX hw) _ (star_mem hg)⟩
  · exact ⟨mem_commutant_iff.mp (hZ hw) g hg, mem_commutant_iff.mp (hZ hw) _ (star_mem hg)⟩

/-- Spatial conjugation commutes with joins: `U (X ∨ Z) U⋆ = (U X U⋆) ∨ (U Z U⋆)`. -/
lemma join_conj {H' : Type*} [NormedAddCommGroup H'] [InnerProductSpace ℂ H'] [CompleteSpace H']
    (U : H ≃ₗᵢ[ℂ] H') (X Z : VonNeumannAlgebra H) :
    join (conj U X) (conj U Z) = conj U (join X Z) := by
  rw [join, join, conj_generated, Set.image_union, coe_conj, coe_conj]

end Join

/-! ### Inclusions and restriction of normal functionals -/

section Inclusion

variable {M₁ M₂ : VonNeumannAlgebra H}

/-- The inclusion `M₁ → M₂` of von Neumann algebras as a unital `⋆`-homomorphism. -/
def inclusion (h : M₁ ≤ M₂) : M₁ →⋆ₐ[ℂ] M₂ where
  toFun x := ⟨x, h x.2⟩
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl
  map_star' _ := rfl

/-- The inclusion as a Schwarz map (a `⋆`-homomorphism is one). -/
def inclusionSchwarz (h : M₁ ≤ M₂) : SchwarzMap M₁ M₂ :=
  SchwarzMapClass.toSchwarzMap (inclusion h)

lemma inclusionSchwarz_one (h : M₁ ≤ M₂) : inclusionSchwarz h 1 = 1 := rfl

/-- The inclusion is normal: on the σ-weak copies it is the inclusion of subspaces. -/
lemma isNormalMap_inclusionSchwarz (h : M₁ ≤ M₂) : IsNormalMap (inclusionSchwarz h) :=
  (continuous_subtype_val.subtype_mk _ :
    Continuous fun T : M₁.sigmaWeak =>
      (⟨T.1, mem_sigmaWeak_iff.mpr (h (mem_sigmaWeak_iff.mp T.2))⟩ : M₂.sigmaWeak))

/-- The restriction of a normal functional along `M₁ ≤ M₂`. -/
def restrict (h : M₁ ≤ M₂) (φ : M₂.NormalFunctional) : M₁.NormalFunctional :=
  φ.comp (inclusionSchwarz h) (isNormalMap_inclusionSchwarz h)

@[simp] lemma restrict_apply (h : M₁ ≤ M₂) (φ : M₂.NormalFunctional) (x : M₁) :
    (restrict h φ).1 x = φ.1 (inclusion h x) := rfl

end Inclusion

/-! ### Normal maps given by `x ↦ W x W'` -/

section Spatial

variable {H' : Type*} [NormedAddCommGroup H'] [InnerProductSpace ℂ H'] [CompleteSpace H']

/-- A map `α : M → N` acting as `x ↦ W x W'` on the underlying operators is normal:
`∑ₙ ⟪ξₙ, W x W' ηₙ⟫ = ∑ₙ ⟪W† ξₙ, x (W' ηₙ)⟫` is a σ-weak coordinate of `x`. -/
lemma isNormalMap_of_apply_eq {M : VonNeumannAlgebra H} {N : VonNeumannAlgebra H'} {F' : Type*}
    [FunLike F' M N] (α : F') (W : H →L[ℂ] H') (W' : H' →L[ℂ] H)
    (hα : ∀ x : M, ((α x : N) : H' →L[ℂ] H') = W ∘L (x : H →L[ℂ] H) ∘L W') :
    IsNormalMap α := by
  have hg : Continuous fun T : M.sigmaWeak =>
      (ContinuousLinearMapSigmaWeak.ofCLM (W ∘L (T : H →σw[ℂ] H).toCLM ∘L W') :
        H' →σw[ℂ] H') := by
    refine ContinuousLinearMapSigmaWeak.continuous_of_tsum_inner_apply_continuous fun ξ η => ?_
    refine ((ContinuousLinearMapSigmaWeak.continuous_tsum_inner_apply
      (ContinuousLinearMapSigmaWeak.applyLp (W†) ξ)
      (ContinuousLinearMapSigmaWeak.applyLp W' η)).comp continuous_subtype_val).congr fun T => ?_
    refine tsum_congr fun n => ?_
    exact ContinuousLinearMap.adjoint_inner_left W _ _
  have hmem : ∀ T : M.sigmaWeak, W ∘L (T : H →σw[ℂ] H).toCLM ∘L W' ∈ N := fun T => by
    have := (α (M.ofSigmaWeak T)).2
    rw [hα] at this
    exact this
  have e : (fun T : M.sigmaWeak => N.toSigmaWeak (α (M.ofSigmaWeak T))) =
      fun T : M.sigmaWeak =>
        (⟨ContinuousLinearMapSigmaWeak.ofCLM (W ∘L (T : H →σw[ℂ] H).toCLM ∘L W'),
          hmem T⟩ : N.sigmaWeak) := by
    funext T
    exact Subtype.ext (congrArg ContinuousLinearMapSigmaWeak.ofCLM (hα (M.ofSigmaWeak T)))
  unfold IsNormalMap
  rw [e]
  exact hg.subtype_mk _

end Spatial

/-! ### Isomorphism invariance of Araki's relative entropy -/

section Invariance

variable {K' : Type*} [NormedAddCommGroup K'] [InnerProductSpace ℂ K'] [CompleteSpace K']

/-- **Invariance under normal `⋆`-isomorphisms**: DPI along `e` and along `e⁻¹`. -/
theorem arakiEntropy_comp_starAlgEquiv {M : VonNeumannAlgebra K'} {N : VonNeumannAlgebra H}
    (e : M ≃⋆ₐ[ℂ] N) (he : IsNormalMap (SchwarzMapClass.toSchwarzMap e : SchwarzMap M N))
    (he' : IsNormalMap (SchwarzMapClass.toSchwarzMap e.symm : SchwarzMap N M))
    (ψ φ : N.NormalFunctional) :
    S⟦ψ.comp (SchwarzMapClass.toSchwarzMap e : SchwarzMap M N) he ∥
        φ.comp (SchwarzMapClass.toSchwarzMap e : SchwarzMap M N) he⟧ = S⟦ψ ∥ φ⟧ := by
  refine le_antisymm
    (arakiEntropy_comp_le (SchwarzMapClass.toSchwarzMap e : SchwarzMap M N) (map_one e) he ψ φ) ?_
  have h := arakiEntropy_comp_le (SchwarzMapClass.toSchwarzMap e.symm : SchwarzMap N M)
    (map_one e.symm) he' (ψ.comp (SchwarzMapClass.toSchwarzMap e : SchwarzMap M N) he)
    (φ.comp (SchwarzMapClass.toSchwarzMap e : SchwarzMap M N) he)
  have hback : ∀ χ : N.NormalFunctional,
      (χ.comp (SchwarzMapClass.toSchwarzMap e : SchwarzMap M N) he).comp
        (SchwarzMapClass.toSchwarzMap e.symm : SchwarzMap N M) he' = χ := fun χ =>
    Subtype.ext (PositiveLinearMap.ext fun x => by
      change χ.1 (e (e.symm x)) = χ.1 x
      rw [StarAlgEquiv.apply_symm_apply])
  rwa [hback ψ, hback φ] at h

end Invariance

/-! ### Amplification commutes with generation, and normal functionals on generated algebras -/

section Amplification

variable {H₁ : Type*} [NormedAddCommGroup H₁] [InnerProductSpace ℂ H₁]

omit [CompleteSpace H] in
/-- Operators on `H₁ ⊗̂ H` with equal matrix elements between elementary tensors are equal. -/
lemma ext_inner_tmul {A B : H₁ ⊗̂ H →L[ℂ] H₁ ⊗̂ H}
    (h : ∀ (f f' : H₁) (ξ η : H), ⟪f ⊗ₕ ξ, A (f' ⊗ₕ η)⟫_ℂ = ⟪f ⊗ₕ ξ, B (f' ⊗ₕ η)⟫_ℂ) :
    A = B := by
  have h1 : ∀ (f' : H₁) (η : H), A (f' ⊗ₕ η) = B (f' ⊗ₕ η) := by
    intro f' η
    refine ext_inner_left ℂ fun w => ?_
    induction w using UniformSpace.Completion.induction_on with
    | hp => exact isClosed_eq (by fun_prop) (by fun_prop)
    | ih a =>
      induction a using TensorProduct.inductionOn with
      | tmul f ξ => exact h f f' ξ η
      | add p q hp hq =>
        rw [UniformSpace.Completion.coe_add, inner_add_left, inner_add_left, hp, hq]
  refine ContinuousLinearMap.ext fun w => ?_
  induction w using UniformSpace.Completion.induction_on with
  | hp => exact isClosed_eq A.continuous B.continuous
  | ih a =>
    induction a using TensorProduct.inductionOn with
    | tmul f' η => exact h1 f' η
    | add p q hp hq => rw [UniformSpace.Completion.coe_add, map_add, map_add, hp, hq]

/-- **Amplification commutes with generation**: `y ∈ s''` implies `1 ⊗ y ∈ (1 ⊗ s)''`. An operator
`W` commuting with `1 ⊗ s` has slices `ι_f† W ι_{f'}` (with `ι_f = f ⊗ ·`) commuting with `s`, hence
with `y`, and the slices of `[W, 1 ⊗ y]` are the commutators of the slices with `y`. -/
lemma amplifyRight_mem_generated_image {s : Set (H →L[ℂ] H)} {y : H →L[ℂ] H}
    (hy : y ∈ generated s) :
    amplifyRight (H₁ := H₁) y ∈ generated (amplifyRight (H₁ := H₁) '' s) := by
  have hright : ∀ (f : H₁) (g : H →L[ℂ] H),
      amplifyRight (H₁ := H₁) g ∘L tmulRightL (H₂ := H) f = tmulRightL f ∘L g :=
    fun f g => ContinuousLinearMap.ext fun u => by simp [HilbertTensor.amplifyRight_tmul]
  have hleft : ∀ (f : H₁) (g : H →L[ℂ] H),
      (tmulRightL (H₂ := H) f)† ∘L amplifyRight (H₁ := H₁) g = g ∘L (tmulRightL (H₂ := H) f)† := by
    intro f g
    have h := congrArg (fun T : H →L[ℂ] H₁ ⊗̂ H => T†) (hright f (g†))
    rwa [ContinuousLinearMap.adjoint_comp, ContinuousLinearMap.adjoint_comp,
      HilbertTensor.amplifyRight_adjoint, ContinuousLinearMap.adjoint_adjoint] at h
  have hslice : ∀ (f f' : H₁) (ξ η : H) (X : H₁ ⊗̂ H →L[ℂ] H₁ ⊗̂ H),
      ⟪f ⊗ₕ ξ, X (f' ⊗ₕ η)⟫_ℂ =
        ⟪ξ, ((tmulRightL (H₂ := H) f)† ∘L X ∘L tmulRightL (H₂ := H) f') η⟫_ℂ := by
    intro f f' ξ η X
    rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.adjoint_inner_right, HilbertTensor.tmulRightL_apply,
      HilbertTensor.tmulRightL_apply]
  have hcomm : ∀ (f f' : H₁) (g : H →L[ℂ] H) (W : H₁ ⊗̂ H →L[ℂ] H₁ ⊗̂ H),
      amplifyRight (H₁ := H₁) g * W = W * amplifyRight g →
      g * ((tmulRightL (H₂ := H) f)† ∘L W ∘L tmulRightL (H₂ := H) f') =
        ((tmulRightL (H₂ := H) f)† ∘L W ∘L tmulRightL (H₂ := H) f') * g := by
    intro f f' g W hg
    rw [ContinuousLinearMap.mul_def, ContinuousLinearMap.mul_def] at hg ⊢
    calc g ∘L ((tmulRightL (H₂ := H) f)† ∘L W ∘L tmulRightL (H₂ := H) f')
        = (g ∘L (tmulRightL (H₂ := H) f)†) ∘L W ∘L tmulRightL (H₂ := H) f' := by
          simp only [ContinuousLinearMap.comp_assoc]
      _ = ((tmulRightL (H₂ := H) f)† ∘L amplifyRight g) ∘L W ∘L tmulRightL (H₂ := H) f' := by
          rw [hleft]
      _ = (tmulRightL (H₂ := H) f)† ∘L (amplifyRight g ∘L W) ∘L tmulRightL (H₂ := H) f' := by
          simp only [ContinuousLinearMap.comp_assoc]
      _ = (tmulRightL (H₂ := H) f)† ∘L (W ∘L amplifyRight g) ∘L tmulRightL (H₂ := H) f' := by
          rw [hg]
      _ = (tmulRightL (H₂ := H) f)† ∘L W ∘L (amplifyRight g ∘L tmulRightL (H₂ := H) f') := by
          simp only [ContinuousLinearMap.comp_assoc]
      _ = (tmulRightL (H₂ := H) f)† ∘L W ∘L (tmulRightL (H₂ := H) f' ∘L g) := by
          rw [hright]
      _ = ((tmulRightL (H₂ := H) f)† ∘L W ∘L tmulRightL (H₂ := H) f') ∘L g := by
          simp only [ContinuousLinearMap.comp_assoc]
  rw [generated, mem_commutant_iff]
  intro W hW
  rw [mem_commutantSet_iff] at hW
  have hWs : ∀ f f' : H₁,
      (tmulRightL (H₂ := H) f)† ∘L W ∘L tmulRightL (H₂ := H) f' ∈ commutantSet s := by
    intro f f'
    rw [mem_commutantSet_iff]
    intro g hg
    have h1 := hW (amplifyRight g) ⟨g, hg, rfl⟩
    rw [HilbertTensor.amplifyRight_star] at h1
    exact ⟨hcomm f f' g W h1.1, hcomm f f' (star g) W h1.2⟩
  refine ext_inner_tmul fun f f' ξ η => ?_
  set Wff := (tmulRightL (H₂ := H) f)† ∘L W ∘L tmulRightL (H₂ := H) f' with hWff
  have hc : Wff * y = y * Wff := mem_commutant_iff.mp hy Wff (hWs f f')
  have hc' : Wff (y η) = y (Wff η) := by
    have := congrArg (fun T : H →L[ℂ] H => T η) hc
    simpa only [mul_apply_eq_comp] using this
  calc ⟪f ⊗ₕ ξ, (W * amplifyRight (H₁ := H₁) y) (f' ⊗ₕ η)⟫_ℂ
      = ⟪f ⊗ₕ ξ, W (f' ⊗ₕ y η)⟫_ℂ := by
        rw [mul_apply_eq_comp, HilbertTensor.amplifyRight_tmul]
    _ = ⟪ξ, Wff (y η)⟫_ℂ := hslice f f' ξ (y η) W
    _ = ⟪ξ, y (Wff η)⟫_ℂ := by rw [hc']
    _ = ⟪(y†) ξ, Wff η⟫_ℂ := (ContinuousLinearMap.adjoint_inner_left y (Wff η) ξ).symm
    _ = ⟪f ⊗ₕ (y†) ξ, W (f' ⊗ₕ η)⟫_ℂ := (hslice f f' ((y†) ξ) η W).symm
    _ = ⟪(amplifyRight (H₁ := H₁) (y†)) (f ⊗ₕ ξ), W (f' ⊗ₕ η)⟫_ℂ := by
        rw [HilbertTensor.amplifyRight_tmul]
    _ = ⟪((amplifyRight (H₁ := H₁) y)†) (f ⊗ₕ ξ), W (f' ⊗ₕ η)⟫_ℂ := by
        rw [HilbertTensor.amplifyRight_adjoint]
    _ = ⟪f ⊗ₕ ξ, (amplifyRight (H₁ := H₁) y) (W (f' ⊗ₕ η))⟫_ℂ :=
        ContinuousLinearMap.adjoint_inner_left _ _ _
    _ = ⟪f ⊗ₕ ξ, (amplifyRight (H₁ := H₁) y * W) (f' ⊗ₕ η)⟫_ℂ := by rw [mul_apply_eq_comp]

end Amplification

/-- **Normal functionals are determined on a generating `⋆`-subalgebra.** If `B` is a unital
`⋆`-subalgebra with `B ⊆ M ⊆ B''`, two normal functionals on `M` that agree on `B` are equal. They are
vector functionals on the amplification `ℓ²(ℕ) ⊗̂ H` agreeing on `1 ⊗ B`, hence on `(1 ⊗ B)''`
(`inner_apply_eq_of_mem_generated`), which contains `1 ⊗ M`
(`amplifyRight_mem_generated_image`). -/
theorem normalFunctional_ext_of_starSubalgebra {M : VonNeumannAlgebra H}
    (B : StarSubalgebra ℂ (H →L[ℂ] H)) (hBM : ∀ b ∈ B, b ∈ M)
    (hMB : M ≤ generated (B : Set (H →L[ℂ] H))) {ψ φ : M.NormalFunctional}
    (h : ∀ b (hb : b ∈ B), ψ.1 ⟨b, hBM b hb⟩ = φ.1 ⟨b, hBM b hb⟩) : ψ = φ := by
  have key : ∀ y ∈ M, ⟪ψ.2.vec, (𝟙 ⊗ y) ψ.2.vec⟫_ℂ = ⟪φ.2.vec, (𝟙 ⊗ y) φ.2.vec⟫_ℂ := by
    intro y hy
    refine inner_apply_eq_of_mem_generated
      (B.map (amplifyRightₐ (H₁ := ℓ²(ℕ, ℂ)) (H₂ := H))) ?_ ?_
    · rintro _ ⟨b, hb, rfl⟩
      exact (ψ.2.inner_vec_amplifyRight ⟨b, hBM b hb⟩).trans
        ((h b hb).trans (φ.2.inner_vec_amplifyRight ⟨b, hBM b hb⟩).symm)
    · rw [StarSubalgebra.coe_map]
      exact amplifyRight_mem_generated_image (hMB hy)
  exact Subtype.ext (PositiveLinearMap.ext fun y => by
    rw [← ψ.2.inner_vec_amplifyRight y, ← φ.2.inner_vec_amplifyRight y]
    exact key y y.2)

/-! ### Product functionals and the mutual information -/

/-- `φ` is a **product functional** for `(X, Z)` and the vector `Ω`:
`φ(x z) = ⟪Ω, x Ω⟫ ⟪Ω, z Ω⟫` for `x ∈ X`, `z ∈ Z`. -/
def IsProduct (Ω : H) (X Z : VonNeumannAlgebra H) (φ : (join X Z).NormalFunctional) : Prop :=
  ∀ x (hx : x ∈ X) z (hz : z ∈ Z),
    φ.1 ⟨x * z, mul_mem (le_join_left X Z hx) (le_join_right X Z hz)⟩ =
      ⟪Ω, x Ω⟫_ℂ * ⟪Ω, z Ω⟫_ℂ

/-- The **mutual information** `I(X:Z) = S_{X ∨ Z}(ω ‖ ω_X ⊗ ω_Z)` of the vector `Ω`: the infimum of
Araki's relative entropy of the vector functional over the normal product functionals (`⊤` if there
is none). For commuting `X, Z` there is at most one product functional
(`mutualInfo_eq_arakiEntropy`). -/
def mutualInfo (Ω : H) (X Z : VonNeumannAlgebra H) : EReal :=
  ⨅ (φ : (join X Z).NormalFunctional) (_ : IsProduct Ω X Z φ),
    S⟦NormalFunctional.ofVector (join X Z) Ω ∥ φ⟧

section MutualInfo

variable {Ω : H} {X Z : VonNeumannAlgebra H}

lemma mutualInfo_le {φ : (join X Z).NormalFunctional} (hφ : IsProduct Ω X Z φ) :
    mutualInfo Ω X Z ≤ S⟦NormalFunctional.ofVector (join X Z) Ω ∥ φ⟧ :=
  iInf₂_le φ hφ

lemma le_mutualInfo {a : EReal}
    (h : ∀ φ, IsProduct Ω X Z φ → a ≤ S⟦NormalFunctional.ofVector (join X Z) Ω ∥ φ⟧) :
    a ≤ mutualInfo Ω X Z :=
  le_iInf₂ h

lemma mutualInfo_eq_top (h : ∀ φ, ¬ IsProduct Ω X Z φ) : mutualInfo Ω X Z = ⊤ :=
  top_le_iff.mp (le_mutualInfo fun φ hφ => absurd hφ (h φ))

/-- A finite mutual information has a product functional. -/
lemma exists_isProduct_of_ne_top (h : mutualInfo Ω X Z ≠ ⊤) : ∃ φ, IsProduct Ω X Z φ := by
  by_contra hne
  exact h (mutualInfo_eq_top fun φ hφ => hne ⟨φ, hφ⟩)

/-! #### (a) Uniqueness -/

/-- The products `x z`, `x ∈ X`, `z ∈ Z`. -/
def prodSet (X Z : VonNeumannAlgebra H) : Set (H →L[ℂ] H) :=
  {w | ∃ x ∈ X, ∃ z ∈ Z, x * z = w}

lemma one_mem_prodSet : (1 : H →L[ℂ] H) ∈ prodSet X Z :=
  ⟨1, X.one_mem, 1, Z.one_mem, one_mul 1⟩

lemma mul_mem_prodSet (hXZ : X ≤ Z′) {a b : H →L[ℂ] H} (ha : a ∈ prodSet X Z)
    (hb : b ∈ prodSet X Z) : a * b ∈ prodSet X Z := by
  obtain ⟨x₁, hx₁, z₁, hz₁, rfl⟩ := ha
  obtain ⟨x₂, hx₂, z₂, hz₂, rfl⟩ := hb
  refine ⟨x₁ * x₂, mul_mem hx₁ hx₂, z₁ * z₂, mul_mem hz₁ hz₂, ?_⟩
  have hc : z₁ * x₂ = x₂ * z₁ := mem_commutant_iff.mp (hXZ hx₂) z₁ hz₁
  calc x₁ * x₂ * (z₁ * z₂) = x₁ * (x₂ * z₁) * z₂ := by simp only [mul_assoc]
    _ = x₁ * (z₁ * x₂) * z₂ := by rw [hc]
    _ = x₁ * z₁ * (x₂ * z₂) := by simp only [mul_assoc]

lemma star_mem_prodSet (hXZ : X ≤ Z′) {a : H →L[ℂ] H} (ha : a ∈ prodSet X Z) :
    star a ∈ prodSet X Z := by
  obtain ⟨x, hx, z, hz, rfl⟩ := ha
  refine ⟨star x, star_mem hx, star z, star_mem hz, ?_⟩
  have hc : star z * star x = star x * star z :=
    mem_commutant_iff.mp (hXZ (star_mem hx)) (star z) (star_mem hz)
  rw [star_mul, hc]

lemma span_mul_mem (hXZ : X ≤ Z′) {a b : H →L[ℂ] H}
    (ha : a ∈ Submodule.span ℂ (prodSet X Z)) (hb : b ∈ Submodule.span ℂ (prodSet X Z)) :
    a * b ∈ Submodule.span ℂ (prodSet X Z) := by
  induction ha using Submodule.span_induction with
  | mem a' ha' =>
    induction hb using Submodule.span_induction with
    | mem b' hb' => exact Submodule.subset_span (mul_mem_prodSet hXZ ha' hb')
    | zero => rw [mul_zero]; exact Submodule.zero_mem _
    | add b₁ b₂ _ _ h₁ h₂ => rw [mul_add]; exact Submodule.add_mem _ h₁ h₂
    | smul c b' _ h => rw [mul_smul_comm]; exact Submodule.smul_mem _ c h
  | zero => rw [zero_mul]; exact Submodule.zero_mem _
  | add a₁ a₂ _ _ h₁ h₂ => rw [add_mul]; exact Submodule.add_mem _ h₁ h₂
  | smul c a' _ h => rw [smul_mul_assoc]; exact Submodule.smul_mem _ c h

lemma span_star_mem (hXZ : X ≤ Z′) {a : H →L[ℂ] H}
    (ha : a ∈ Submodule.span ℂ (prodSet X Z)) : star a ∈ Submodule.span ℂ (prodSet X Z) := by
  induction ha using Submodule.span_induction with
  | mem a' ha' => exact Submodule.subset_span (star_mem_prodSet hXZ ha')
  | zero => rw [star_zero]; exact Submodule.zero_mem _
  | add a₁ a₂ _ _ h₁ h₂ => rw [star_add]; exact Submodule.add_mem _ h₁ h₂
  | smul c a' _ h => rw [star_smul]; exact Submodule.smul_mem _ _ h

/-- For commuting `X, Z`, the span of the products `x z` is a unital `⋆`-subalgebra. -/
def prodAlg (X Z : VonNeumannAlgebra H) (hXZ : X ≤ Z′) : StarSubalgebra ℂ (H →L[ℂ] H) :=
  { (Submodule.span ℂ (prodSet X Z)).toSubalgebra (Submodule.subset_span one_mem_prodSet)
      (fun _ _ ha hb => span_mul_mem hXZ ha hb) with
    star_mem' := fun ha => span_star_mem hXZ ha }

lemma mem_prodAlg_iff (hXZ : X ≤ Z′) {a : H →L[ℂ] H} :
    a ∈ prodAlg X Z hXZ ↔ a ∈ Submodule.span ℂ (prodSet X Z) := Iff.rfl

lemma span_prodSet_le_join {b : H →L[ℂ] H} (hb : b ∈ Submodule.span ℂ (prodSet X Z)) :
    b ∈ join X Z := by
  induction hb using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨x, hx, z, hz, rfl⟩ := hw
    exact mul_mem (le_join_left X Z hx) (le_join_right X Z hz)
  | zero => exact zero_mem _
  | add _ _ _ _ h₁ h₂ => exact add_mem h₁ h₂
  | smul c _ _ h => exact SMulMemClass.smul_mem c h

/-- **(a) Uniqueness of product functionals.** For commuting `X, Z`, two normal product functionals
on `X ∨ Z` coincide: they agree on the span of the products, a unital `⋆`-algebra generating
`X ∨ Z` (`normalFunctional_ext_of_starSubalgebra`). -/
theorem isProduct_unique (hXZ : X ≤ Z′) {φ φ' : (join X Z).NormalFunctional}
    (hφ : IsProduct Ω X Z φ) (hφ' : IsProduct Ω X Z φ') : φ = φ' := by
  have hsub : (X : Set (H →L[ℂ] H)) ∪ Z ⊆ (prodAlg X Z hXZ : Set (H →L[ℂ] H)) := by
    rintro w (hw | hw)
    · exact (mem_prodAlg_iff hXZ).mpr (Submodule.subset_span ⟨w, hw, 1, Z.one_mem, mul_one w⟩)
    · exact (mem_prodAlg_iff hXZ).mpr (Submodule.subset_span ⟨1, X.one_mem, w, hw, one_mul w⟩)
  have hJB : join X Z ≤ generated (prodAlg X Z hXZ : Set (H →L[ℂ] H)) := generated_mono hsub
  have key : ∀ b ∈ Submodule.span ℂ (prodSet X Z), ∀ hb : b ∈ join X Z,
      φ.1 ⟨b, hb⟩ = φ'.1 ⟨b, hb⟩ := by
    intro b hbP
    induction hbP using Submodule.span_induction with
    | mem w hw =>
      intro hb
      obtain ⟨x, hx, z, hz, rfl⟩ := hw
      exact (hφ x hx z hz).trans (hφ' x hx z hz).symm
    | zero =>
      intro hb
      exact (map_zero φ.1).trans (map_zero φ'.1).symm
    | add b₁ b₂ hb₁ hb₂ ih₁ ih₂ =>
      intro hb
      have e := map_add φ.1 ⟨b₁, span_prodSet_le_join hb₁⟩ ⟨b₂, span_prodSet_le_join hb₂⟩
      have e' := map_add φ'.1 ⟨b₁, span_prodSet_le_join hb₁⟩ ⟨b₂, span_prodSet_le_join hb₂⟩
      exact e.trans ((congrArg₂ (· + ·) (ih₁ (span_prodSet_le_join hb₁))
        (ih₂ (span_prodSet_le_join hb₂))).trans e'.symm)
    | smul c b' hb' ih =>
      intro hb
      have e := map_smul φ.1 c ⟨b', span_prodSet_le_join hb'⟩
      have e' := map_smul φ'.1 c ⟨b', span_prodSet_le_join hb'⟩
      exact e.trans ((congrArg (c • ·) (ih (span_prodSet_le_join hb'))).trans e'.symm)
  exact normalFunctional_ext_of_starSubalgebra (prodAlg X Z hXZ)
    (fun b hb => span_prodSet_le_join hb) hJB fun b hb => key b hb _

/-- For commuting `X, Z`, the mutual information is the relative entropy with respect to any
product functional (the blueprint's `if h : ∃ φ, … then S⟦ω ∥ h.choose⟧ else ⊤`). -/
theorem mutualInfo_eq_arakiEntropy (hXZ : X ≤ Z′) {φ : (join X Z).NormalFunctional}
    (hφ : IsProduct Ω X Z φ) :
    mutualInfo Ω X Z = S⟦NormalFunctional.ofVector (join X Z) Ω ∥ φ⟧ :=
  le_antisymm (mutualInfo_le hφ) (le_mutualInfo fun _ hφ' =>
    (congrArg (fun χ => S⟦NormalFunctional.ofVector (join X Z) Ω ∥ χ⟧)
      (isProduct_unique hXZ hφ hφ')).le)

/-- The restriction of a product functional is a product functional. -/
lemma isProduct_restrict {X' Z' : VonNeumannAlgebra H} (hX : X' ≤ X) (hZ : Z' ≤ Z)
    {φ : (join X Z).NormalFunctional} (hφ : IsProduct Ω X Z φ) :
    IsProduct Ω X' Z' (restrict (join_mono hX hZ) φ) :=
  fun x hx z hz => hφ x (hX hx) z (hZ hz)

/-- For commuting `X' ≤ X`, `Z' ≤ Z`, the mutual information of the smaller pair is computed by the
restricted product functional (used with upward continuity, T1/T3). -/
theorem mutualInfo_eq_restrict {X' Z' : VonNeumannAlgebra H} (hX : X' ≤ X) (hZ : Z' ≤ Z)
    (hXZ' : X' ≤ Z'′) {φ : (join X Z).NormalFunctional} (hφ : IsProduct Ω X Z φ) :
    mutualInfo Ω X' Z' =
      S⟦NormalFunctional.ofVector (join X' Z') Ω ∥ restrict (join_mono hX hZ) φ⟧ :=
  mutualInfo_eq_arakiEntropy hXZ' (isProduct_restrict hX hZ hφ)

/-! #### Comparison along Schwarz maps -/

/-- **Comparison principle.** A unital normal Schwarz map `α : X ∨ Z → X' ∨ Z'` carrying the vector
functional of `Ω'` to that of `Ω`, and product functionals to product functionals, decreases the
mutual information: DPI `S(ω' ∘ α ‖ φ' ∘ α) ≤ S(ω' ‖ φ')`. -/
theorem mutualInfo_le_of_schwarzMap {H' : Type*} [NormedAddCommGroup H'] [InnerProductSpace ℂ H']
    [CompleteSpace H'] {Ω' : H'} {X' Z' : VonNeumannAlgebra H'}
    (α : SchwarzMap (join X Z) (join X' Z')) (hα₁ : α 1 = 1) (hα : IsNormalMap α)
    (hω : ∀ y : join X Z, ⟪Ω', ((α y : join X' Z') : H' →L[ℂ] H') Ω'⟫_ℂ =
      ⟪Ω, (y : H →L[ℂ] H) Ω⟫_ℂ)
    (hprod : ∀ φ', IsProduct Ω' X' Z' φ' → IsProduct Ω X Z (φ'.comp α hα)) :
    mutualInfo Ω X Z ≤ mutualInfo Ω' X' Z' := by
  refine le_mutualInfo fun φ' hφ' => ?_
  have e : (NormalFunctional.ofVector (join X' Z') Ω').comp α hα =
      NormalFunctional.ofVector (join X Z) Ω :=
    Subtype.ext (PositiveLinearMap.ext fun y => hω y)
  calc mutualInfo Ω X Z ≤ S⟦NormalFunctional.ofVector (join X Z) Ω ∥ φ'.comp α hα⟧ :=
        mutualInfo_le (hprod φ' hφ')
    _ = S⟦(NormalFunctional.ofVector (join X' Z') Ω').comp α hα ∥ φ'.comp α hα⟧ := by rw [e]
    _ ≤ S⟦NormalFunctional.ofVector (join X' Z') Ω' ∥ φ'⟧ := arakiEntropy_comp_le α hα₁ hα _ _

/-! #### (d) Monotonicity -/

/-- **(d) Monotonicity**: `X' ≤ X`, `Z' ≤ Z` give `I(X':Z') ≤ I(X:Z)`. No commutation or type I
hypothesis is needed with the infimum definition. -/
theorem mutualInfo_mono {X' Z' : VonNeumannAlgebra H} (hX : X' ≤ X) (hZ : Z' ≤ Z) :
    mutualInfo Ω X' Z' ≤ mutualInfo Ω X Z :=
  mutualInfo_le_of_schwarzMap (inclusionSchwarz (join_mono hX hZ))
    (inclusionSchwarz_one _) (isNormalMap_inclusionSchwarz _) (fun _ => rfl)
    (fun _ hφ => isProduct_restrict hX hZ hφ)

/-! #### (c) Symmetry -/

/-- `conj ⟪Ω, a⋆ Ω⟫ = ⟪Ω, a Ω⟫`. -/
lemma star_inner_star_apply (a : H →L[ℂ] H) (ξ : H) :
    star ⟪ξ, (star a) ξ⟫_ℂ = ⟪ξ, a ξ⟫_ℂ := by
  rw [ContinuousLinearMap.star_eq_adjoint, ContinuousLinearMap.adjoint_inner_right]
  exact inner_conj_symm ξ (a ξ)

/-- A product functional for `(X, Z)` restricts to a product functional for `(Z, X)`: positive
functionals are hermitian, and `z x = (x⋆ z⋆)⋆`. -/
lemma isProduct_swap {φ : (join X Z).NormalFunctional} (hφ : IsProduct Ω X Z φ)
    (h : join Z X ≤ join X Z) : IsProduct Ω Z X (restrict h φ) := by
  intro z hz x hx
  have hxz := hφ (star x) (star_mem hx) (star z) (star_mem hz)
  have e : (inclusion h ⟨z * x, mul_mem (le_join_left Z X hz) (le_join_right Z X hx)⟩ :
      join X Z) = star (⟨star x * star z,
        mul_mem (le_join_left X Z (star_mem hx)) (le_join_right X Z (star_mem hz))⟩ :
          join X Z) := by
    apply Subtype.ext
    show z * x = star (star x * star z)
    rw [star_mul, star_star, star_star]
  rw [restrict_apply, e, map_star, hxz, star_mul', star_inner_star_apply,
    star_inner_star_apply]
  exact mul_comm _ _

/-- **(c) Symmetry**: `I(X:Z) = I(Z:X)`. -/
theorem mutualInfo_comm : mutualInfo Ω X Z = mutualInfo Ω Z X := by
  have h₁ : join Z X ≤ join X Z := (join_comm Z X).le
  have h₂ : join X Z ≤ join Z X := (join_comm X Z).le
  exact le_antisymm
    (mutualInfo_le_of_schwarzMap (inclusionSchwarz h₂) (inclusionSchwarz_one _)
      (isNormalMap_inclusionSchwarz _) (fun _ => rfl) fun _ hφ => isProduct_swap hφ h₂)
    (mutualInfo_le_of_schwarzMap (inclusionSchwarz h₁) (inclusionSchwarz_one _)
      (isNormalMap_inclusionSchwarz _) (fun _ => rfl) fun _ hφ => isProduct_swap hφ h₁)

end MutualInfo

/-! ### (e) Unitary covariance -/

section Covariance

variable {H' : Type*} [NormedAddCommGroup H'] [InnerProductSpace ℂ H'] [CompleteSpace H']

/-- The spatial isomorphism `X ∨ Z ≃ (U X U⋆) ∨ (U Z U⋆)`, `y ↦ U y U⋆`. -/
def joinConjEquiv (U : H ≃ₗᵢ[ℂ] H') (X Z : VonNeumannAlgebra H) :
    join X Z ≃⋆ₐ[ℂ] join (conj U X) (conj U Z) :=
  (conjEquiv U (join X Z)).trans (equivOfEq (join_conj U X Z).symm)

/-- `⟪U Ω, (U a U⋆) U Ω⟫ = ⟪Ω, a Ω⟫`. -/
lemma inner_conj_apply (U : H ≃ₗᵢ[ℂ] H') {Ω : H} {Ω' : H'} (hU : U Ω = Ω') (a : H →L[ℂ] H) :
    ⟪Ω', (U.conjStarAlgEquiv a) Ω'⟫_ℂ = ⟪Ω, a Ω⟫_ℂ := by
  rw [LinearIsometryEquiv.conjStarAlgEquiv_apply_apply, ← hU, LinearIsometryEquiv.symm_apply_apply,
    LinearIsometryEquiv.inner_map_map]

/-- `⟪Ω, (U⋆ a U) Ω⟫ = ⟪U Ω, a U Ω⟫`. -/
lemma inner_conj_symm_apply (U : H ≃ₗᵢ[ℂ] H') {Ω : H} {Ω' : H'} (hU : U Ω = Ω')
    (a : H' →L[ℂ] H') :
    ⟪Ω, (U.conjStarAlgEquiv.symm a) Ω⟫_ℂ = ⟪Ω', a Ω'⟫_ℂ := by
  rw [LinearIsometryEquiv.symm_conjStarAlgEquiv_apply_apply, hU,
    ← LinearIsometryEquiv.inner_map_map U Ω, LinearIsometryEquiv.apply_symm_apply, hU]

/-- **(e) Unitary covariance**: for `U : H ≃ₗᵢ H'` with `U Ω = Ω'`,
`I_{Ω'}(U X U⋆ : U Z U⋆) = I_Ω(X : Z)`. -/
theorem mutualInfo_conj (U : H ≃ₗᵢ[ℂ] H') {Ω : H} {Ω' : H'} (hU : U Ω = Ω')
    (X Z : VonNeumannAlgebra H) :
    mutualInfo Ω' (conj U X) (conj U Z) = mutualInfo Ω X Z := by
  set e := joinConjEquiv U X Z
  have he : IsNormalMap (SchwarzMapClass.toSchwarzMap e :
      SchwarzMap (join X Z) (join (conj U X) (conj U Z))) :=
    isNormalMap_of_apply_eq (SchwarzMapClass.toSchwarzMap e :
      SchwarzMap (join X Z) (join (conj U X) (conj U Z))) U.toLinearIsometry.toContinuousLinearMap
      U.symm.toLinearIsometry.toContinuousLinearMap fun y => ContinuousLinearMap.ext fun w => by
        change U.conjStarAlgEquiv (y : H →L[ℂ] H) w = U ((y : H →L[ℂ] H) (U.symm w))
        rw [LinearIsometryEquiv.conjStarAlgEquiv_apply_apply]
  have he' : IsNormalMap (SchwarzMapClass.toSchwarzMap e.symm :
      SchwarzMap (join (conj U X) (conj U Z)) (join X Z)) :=
    isNormalMap_of_apply_eq (SchwarzMapClass.toSchwarzMap e.symm :
      SchwarzMap (join (conj U X) (conj U Z)) (join X Z))
      U.symm.toLinearIsometry.toContinuousLinearMap
      U.toLinearIsometry.toContinuousLinearMap fun y => ContinuousLinearMap.ext fun w => by
        change U.conjStarAlgEquiv.symm (y : H' →L[ℂ] H') w = U.symm ((y : H' →L[ℂ] H') (U w))
        rw [LinearIsometryEquiv.symm_conjStarAlgEquiv_apply_apply]
  refine le_antisymm ?_ ?_
  · refine mutualInfo_le_of_schwarzMap (SchwarzMapClass.toSchwarzMap e.symm) (map_one e.symm) he'
      (fun y => inner_conj_symm_apply U hU (y : H' →L[ℂ] H')) ?_
    intro φ hφ x' hx' z' hz'
    have hx : U.conjStarAlgEquiv.symm x' ∈ X := (mem_conj_iff U X).mp hx'
    have hz : U.conjStarAlgEquiv.symm z' ∈ Z := (mem_conj_iff U Z).mp hz'
    have key : (e.symm ⟨x' * z', mul_mem (le_join_left (conj U X) (conj U Z) hx')
        (le_join_right (conj U X) (conj U Z) hz')⟩ : join X Z) =
        ⟨U.conjStarAlgEquiv.symm x' * U.conjStarAlgEquiv.symm z',
          mul_mem (le_join_left X Z hx) (le_join_right X Z hz)⟩ :=
      Subtype.ext (map_mul U.conjStarAlgEquiv.symm x' z')
    change φ.1 (e.symm ⟨x' * z', _⟩) = _
    rw [key, hφ _ hx _ hz, inner_conj_symm_apply U hU, inner_conj_symm_apply U hU]
  · refine mutualInfo_le_of_schwarzMap (SchwarzMapClass.toSchwarzMap e) (map_one e) he
      (fun y => inner_conj_apply U hU (y : H →L[ℂ] H)) ?_
    intro φ hφ x hx z hz
    have hx' : U.conjStarAlgEquiv x ∈ conj U X := (conjStarAlgEquiv_mem_conj_iff U X).mpr hx
    have hz' : U.conjStarAlgEquiv z ∈ conj U Z := (conjStarAlgEquiv_mem_conj_iff U Z).mpr hz
    have key : (e ⟨x * z, mul_mem (le_join_left X Z hx) (le_join_right X Z hz)⟩ :
        join (conj U X) (conj U Z)) =
        ⟨U.conjStarAlgEquiv x * U.conjStarAlgEquiv z,
          mul_mem (le_join_left (conj U X) (conj U Z) hx')
            (le_join_right (conj U X) (conj U Z) hz')⟩ :=
      Subtype.ext (map_mul U.conjStarAlgEquiv x z)
    change φ.1 (e ⟨x * z, _⟩) = _
    rw [key, hφ _ hx' _ hz', inner_conj_apply U hU, inner_conj_apply U hU]

/-- **(e)** The case `U : H ≃ₗᵢ H` with `U Ω = Ω` (boost covariance of the vacuum). -/
theorem mutualInfo_conj_self (U : H ≃ₗᵢ[ℂ] H) {Ω : H} (hU : U Ω = Ω)
    (X Z : VonNeumannAlgebra H) :
    mutualInfo Ω (conj U X) (conj U Z) = mutualInfo Ω X Z :=
  mutualInfo_conj U hU X Z

end Covariance

end

end CTheorem
