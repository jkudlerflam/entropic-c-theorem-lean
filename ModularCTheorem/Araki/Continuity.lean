import Mathlib
import QuantumSystem.InformationTheory.Entropy.Araki.Monotonicity
import QuantumSystem.Analysis.VonNeumannAlgebra.DoubleCommutant.SOTClosedSubalgebra
import QuantumSystem.Analysis.VonNeumannAlgebra.TensorFactor

/-!
# Upward continuity of Araki's relative entropy (blueprint component T1)

Let `M n` be an increasing sequence of von Neumann algebras on `H`, all contained in a von Neumann
algebra `N` that is generated by their union, `N ≤ (⋃ n, M n)''`. Then for vectors `ξ, η` the
relative entropies converge to the relative entropy on `N`:

* `CTheorem.tendsto_arakiVec_of_le_generated` —
  `S_{M n}(ω_ξ ‖ ω_η) → S_N(ω_ξ ‖ ω_η)` in `EReal`.

For normal functionals `ψ, φ` on `N`:

* `CTheorem.tendsto_arakiEntropy_of_apply_eq` — for any normal functionals `ψ n, φ n` on `M n`
  agreeing with `ψ, φ` on `M n`, `S(ψ n ‖ φ n) → S(ψ ‖ φ)` (so it applies to any construction of
  the restriction).

All auxiliary declarations live in `CTheorem.Continuity`.

## Proof

Write `μ_M` for the spectral measure at `ξ` of `Δ_M = Δ[M]⟦η, ξ⟧ = S̄†S̄` and
`R_M(t) = ∫ (t + λ)⁻¹ dμ_M(λ) = ⟪ξ, (t + Δ_M)⁻¹ ξ⟫`.

1. By the variational formula (`IsSelfAdjoint.isLeast_re_inner_resolvent_neg`),
   `R_M(t) = max_{(w, w') ∈ graph S̄} (2 re⟪ξ, w⟫ - t ‖w‖² - ‖w'‖²)`. Graph domination gives
   `R_M ≤ R_N` for `M ≤ N` (Petz's argument for the inclusion).
2. **Strong⋆ density** (`Continuity.mem_closure_image_of_mem_centralizer_centralizer`): for a
   unital `⋆`-algebra `A` and `x ∈ A''`, `(x ξ, x⋆ η)` is a limit of pairs `(y ξ, y⋆ η)`,
   `y ∈ A`. A separating functional (Hahn–Banach in `H × H`) gives a WOT-continuous functional
   `y ↦ ⟪a, y ξ⟫ + ⟪η, y b⟫` vanishing on `A`, hence on its WOT-closure `A''`.
3. The maximiser for `N` is a limit of graph points `(x ξ + ζ, x⋆ η)` (`x = x s_N(ξ)`), which are
   limits of `(y ξ + ζ, y⋆ η)` with `y ∈ M n`; these are dominated by graph points of `S_{M n}`.
   Hence `R_N ≤ sup_n R_{M n}`, so `R_{M n}(t) ↑ R_N(t)` for every `t > 0`.
4. `-log λ = ∫_{t > 0} ((t + λ)⁻¹ - (1 + t)⁻¹) dt` and Tonelli write
   `S_M = ∫_{t>0} (R_M(t) - ‖ξ‖² (1 + t)⁻¹) dt` (as a difference of two `lintegral`s); the integrand
   increases in `n` and is bounded below by the integrable negative part for `M 0`, so monotone
   convergence applies (`Continuity.tendsto_negLogIntegral_of_monotone_resolvent`).
5. For normal functionals, `S(ψ|_M ‖ φ|_M) = S_{1 ⊗ M}(ω_{Ξ_ψ} ‖ ω_{Ξ_φ})` with the representing
   vectors of `ψ, φ` on `N`, and `1 ⊗ N ≤ (⋃ n, 1 ⊗ M n)''` by a slice argument
   (`Continuity.amplifyRight_mem_centralizer_centralizer`), so the vector form applies on
   `ℓ²(ℕ) ⊗̂ H`.
-/

open Complex MeasureTheory Filter Topology
open scoped InnerProductSpace InnerProduct ComplexOrder ENNReal NNReal VonNeumannAlgebra
  HilbertTensor Araki lp
open HilbertTensor (amplifyRight tmulRightL)

namespace CTheorem.Continuity

open VonNeumannAlgebra

/-! ### Measure theory: monotone limits of `∫ -log` through resolvents -/

/-- The positive part `t ↦ ∫ ((t + s)⁻¹ - (1 + t)⁻¹)⁺ dρ(s)` of the shifted resolvent of `ρ`. -/
noncomputable def resolventPosPart (ρ : Measure ℝ) (t : ℝ) : ℝ≥0∞ :=
  ∫⁻ s, ENNReal.ofReal ((t + s)⁻¹ - (1 + t)⁻¹) ∂ρ

/-- The negative part `t ↦ ∫ ((1 + t)⁻¹ - (t + s)⁻¹)⁺ dρ(s)` of the shifted resolvent of `ρ`. -/
noncomputable def resolventNegPart (ρ : Measure ℝ) (t : ℝ) : ℝ≥0∞ :=
  ∫⁻ s, ENNReal.ofReal ((1 + t)⁻¹ - (t + s)⁻¹) ∂ρ

/-- The shifted resolvent `∫ (t + s)⁻¹ dρ(s) - ρ(ℝ) (1 + t)⁻¹` for `t > 0`
(`CTheorem.Continuity.resolventParts_finite`), written through its two parts so that it is
measurable in `t` by construction. -/
noncomputable def resolventShift (ρ : Measure ℝ) (t : ℝ) : ℝ :=
  (resolventPosPart ρ t).toReal - (resolventNegPart ρ t).toReal

lemma measurable_resolventPosPart (ρ : Measure ℝ) [SFinite ρ] :
    Measurable (resolventPosPart ρ) := by
  have h : Measurable fun p : ℝ × ℝ => ENNReal.ofReal ((p.1 + p.2)⁻¹ - (1 + p.1)⁻¹) := by
    fun_prop
  exact h.lintegral_prod_right'

lemma measurable_resolventNegPart (ρ : Measure ℝ) [SFinite ρ] :
    Measurable (resolventNegPart ρ) := by
  have h : Measurable fun p : ℝ × ℝ => ENNReal.ofReal ((1 + p.1)⁻¹ - (p.1 + p.2)⁻¹) := by
    fun_prop
  exact h.lintegral_prod_right'

lemma measurable_resolventShift (ρ : Measure ℝ) [SFinite ρ] :
    Measurable (resolventShift ρ) :=
  (measurable_resolventPosPart ρ).ennreal_toReal.sub
    (measurable_resolventNegPart ρ).ennreal_toReal

/-- Tonelli for the positive part of `-log`: `∫ (-log s)⁺ dρ = ∫_{t > 0} P_ρ(t) dt`. -/
lemma lintegral_toENNReal_neg_log_eq {ρ : Measure ℝ} [SFinite ρ] (hρ : ∀ᵐ s ∂ρ, 0 ≤ s) :
    ∫⁻ s, (-ENNReal.log (ENNReal.ofReal s)).toENNReal ∂ρ =
      ∫⁻ t in Set.Ioi 0, resolventPosPart ρ t := by
  have h : Measurable fun p : ℝ × ℝ => ENNReal.ofReal ((p.2 + p.1)⁻¹ - (1 + p.2)⁻¹) := by
    fun_prop
  exact (lintegral_congr_ae (hρ.mono fun s hs =>
    (lintegral_Ioi_ofReal_inv_add_sub_inv_one_add hs).symm)).trans
    (lintegral_lintegral_swap (f := fun s t => ENNReal.ofReal ((t + s)⁻¹ - (1 + t)⁻¹))
      h.aemeasurable)

/-- Tonelli for the negative part of `-log`: `∫ (log s)⁺ dρ = ∫_{t > 0} Q_ρ(t) dt`. -/
lemma lintegral_toENNReal_log_eq {ρ : Measure ℝ} [SFinite ρ] (hρ : ∀ᵐ s ∂ρ, 0 ≤ s) :
    ∫⁻ s, (ENNReal.log (ENNReal.ofReal s)).toENNReal ∂ρ =
      ∫⁻ t in Set.Ioi 0, resolventNegPart ρ t := by
  have h : Measurable fun p : ℝ × ℝ => ENNReal.ofReal ((1 + p.2)⁻¹ - (p.2 + p.1)⁻¹) := by
    fun_prop
  exact (lintegral_congr_ae (hρ.mono fun s hs =>
    (lintegral_Ioi_ofReal_inv_one_add_sub_inv_add hs).symm)).trans
    (lintegral_lintegral_swap (f := fun s t => ENNReal.ofReal ((1 + t)⁻¹ - (t + s)⁻¹))
      h.aemeasurable)

/-- `∫ -log dρ = ∫_{t > 0} P_ρ(t) dt - ∫_{t > 0} Q_ρ(t) dt` for `ρ` on `[0, ∞)`. -/
lemma negLogIntegral_eq_resolventParts {ρ : Measure ℝ} [SFinite ρ] (hρ : ∀ᵐ s ∂ρ, 0 ≤ s) :
    negLogIntegral ρ = ((∫⁻ t in Set.Ioi 0, resolventPosPart ρ t : ℝ≥0∞) : EReal) -
      ((∫⁻ t in Set.Ioi 0, resolventNegPart ρ t : ℝ≥0∞) : EReal) := by
  rw [negLogIntegral, erealIntegral]
  simp only [neg_neg]
  rw [lintegral_toENNReal_neg_log_eq hρ, lintegral_toENNReal_log_eq hρ]

/-- For `t > 0` both parts are finite and `P_ρ(t) - Q_ρ(t) = ∫ (t + s)⁻¹ dρ - ρ(ℝ) (1 + t)⁻¹`. -/
lemma resolventParts_finite {ρ : Measure ℝ} [IsFiniteMeasure ρ] (hρ : ∀ᵐ s ∂ρ, 0 ≤ s) {t : ℝ}
    (ht : 0 < t) :
    resolventPosPart ρ t ≠ ∞ ∧ resolventNegPart ρ t ≠ ∞ ∧
      resolventShift ρ t = ∫ s, (t + s)⁻¹ ∂ρ - ρ.real Set.univ * (1 + t)⁻¹ := by
  have hi : Integrable (fun s => (t + s)⁻¹) ρ := by
    refine Integrable.of_bound (by fun_prop) t⁻¹ ?_
    filter_upwards [hρ] with s hs
    rw [Real.norm_of_nonneg (inv_nonneg.mpr (by linarith))]
    exact inv_anti₀ ht (by linarith)
  have hg : Integrable (fun s => (t + s)⁻¹ - (1 + t)⁻¹) ρ := hi.sub (integrable_const _)
  have hQ : resolventNegPart ρ t = ∫⁻ s, ENNReal.ofReal (-((t + s)⁻¹ - (1 + t)⁻¹)) ∂ρ := by
    simp_rw [resolventNegPart, neg_sub]
  refine ⟨hg.lintegral_lt_top.ne, hQ ▸ hg.neg.lintegral_lt_top.ne, ?_⟩
  rw [resolventShift, hQ, resolventPosPart,
    ← integral_eq_lintegral_pos_part_sub_lintegral_neg_part hg,
    integral_sub hi (integrable_const _), integral_const, smul_eq_mul]

/-- The pointwise bookkeeping identity `P_ρ + Q_{ρ₀} = Q_ρ + (D_ρ + Q_{ρ₀})⁺`, valid when
`D_{ρ₀} ≤ D_ρ` (so that `D_ρ + Q_{ρ₀} ≥ D_{ρ₀} + Q_{ρ₀} = P_{ρ₀} ≥ 0`). -/
lemma resolventPosPart_add_eq {ρ ρ₀ : Measure ℝ} [IsFiniteMeasure ρ] [IsFiniteMeasure ρ₀]
    (hρ : ∀ᵐ s ∂ρ, 0 ≤ s) (hρ₀ : ∀ᵐ s ∂ρ₀, 0 ≤ s) {t : ℝ} (ht : 0 < t)
    (hle : resolventShift ρ₀ t ≤ resolventShift ρ t) :
    resolventPosPart ρ t + resolventNegPart ρ₀ t =
      resolventNegPart ρ t +
        ENNReal.ofReal (resolventShift ρ t + (resolventNegPart ρ₀ t).toReal) := by
  obtain ⟨hP, hQ, -⟩ := resolventParts_finite hρ ht
  obtain ⟨-, hQ₀, -⟩ := resolventParts_finite hρ₀ ht
  have h0 : 0 ≤ resolventShift ρ₀ t + (resolventNegPart ρ₀ t).toReal := by
    rw [resolventShift]
    linarith [ENNReal.toReal_nonneg (a := resolventPosPart ρ₀ t)]
  have hnn : 0 ≤ resolventShift ρ t + (resolventNegPart ρ₀ t).toReal := by linarith
  rw [← ENNReal.toReal_eq_toReal_iff' (ENNReal.add_ne_top.2 ⟨hP, hQ₀⟩)
      (ENNReal.add_ne_top.2 ⟨hQ, ENNReal.ofReal_ne_top⟩),
    ENNReal.toReal_add hP hQ₀, ENNReal.toReal_add hQ ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hnn, resolventShift]
  ring

/-- For finite `b, c`, `a + b = c + d` in `ℝ≥0∞` gives `a - c = d - b` in `EReal`. -/
lemma coe_sub_coe_eq_of_add_eq {a b c d : ℝ≥0∞} (hb : b ≠ ∞) (hc : c ≠ ∞)
    (h : a + b = c + d) : (a : EReal) - c = (d : EReal) - b := by
  lift b to ℝ≥0 using hb
  lift c to ℝ≥0 using hc
  induction a using ENNReal.recTopCoe with
  | top =>
    have hd : d = ∞ := by
      by_contra hd
      rw [top_add] at h
      exact ENNReal.add_ne_top.2 ⟨ENNReal.coe_ne_top, hd⟩ h.symm
    subst hd
    simp only [EReal.coe_ennreal_top, EReal.coe_nnreal_eq_coe_real, EReal.top_sub_coe]
  | coe a =>
    induction d using ENNReal.recTopCoe with
    | top =>
      rw [add_top] at h
      exact absurd h (ENNReal.add_ne_top.2 ⟨ENNReal.coe_ne_top, ENNReal.coe_ne_top⟩)
    | coe d =>
      have h' : (a : ℝ) + b = c + d := by exact_mod_cast h
      simp only [EReal.coe_nnreal_eq_coe_real, ← EReal.coe_sub, EReal.coe_eq_coe_iff]
      linarith

/-- `(a n : EReal) - c → (b : EReal) - c` when `a n → b` in `ℝ≥0∞` and `c` is finite. -/
lemma tendsto_coe_ennreal_sub_coe {a : ℕ → ℝ≥0∞} {b c : ℝ≥0∞}
    (hab : Tendsto a atTop (𝓝 b)) (hc : c ≠ ∞) :
    Tendsto (fun n => (a n : EReal) - c) atTop (𝓝 ((b : EReal) - c)) := by
  have h₁ : Tendsto (fun n => (a n : EReal)) atTop (𝓝 (b : EReal)) :=
    (continuous_coe_ennreal_ereal.tendsto b).comp hab
  have hc' : -(c : EReal) ≠ ⊥ := by
    rw [Ne, EReal.neg_eq_bot_iff, EReal.coe_ennreal_eq_top_iff]
    exact hc
  have h₂ : Tendsto (fun n => (a n : EReal) + -(c : EReal)) atTop
      (𝓝 ((b : EReal) + -(c : EReal))) :=
    (EReal.continuousAt_add (p := ((b : EReal), -(c : EReal))) (Or.inr hc')
      (Or.inl (EReal.coe_ennreal_ne_bot b))).tendsto.comp (h₁.prodMk_nhds tendsto_const_nhds)
  simpa only [sub_eq_add_neg] using h₂

/-- **Monotone convergence for `∫ -log` through resolvents.** Let `μ n`, `ν` be finite measures on
`[0, ∞)` of the same total mass, with `∫ -log ≠ -∞` (i.e. `∫ log⁺ < ∞`). If for every `t > 0` the
resolvent integrals `∫ (t + s)⁻¹ dμ_n(s)` increase in `n` with limit `∫ (t + s)⁻¹ dν(s)`, then
`∫ -log dμ_n → ∫ -log dν` in `EReal`. -/
theorem tendsto_negLogIntegral_of_monotone_resolvent {μ : ℕ → Measure ℝ} {ν : Measure ℝ}
    [∀ n, IsFiniteMeasure (μ n)] [IsFiniteMeasure ν]
    (hμ : ∀ n, ∀ᵐ s ∂(μ n), 0 ≤ s) (hν : ∀ᵐ s ∂ν, 0 ≤ s)
    (hmass : ∀ n, μ n Set.univ = ν Set.univ)
    (hμbot : ∀ n, negLogIntegral (μ n) ≠ ⊥) (hνbot : negLogIntegral ν ≠ ⊥)
    (hmono : ∀ t : ℝ, 0 < t → Monotone fun n => ∫ s, (t + s)⁻¹ ∂(μ n))
    (hlim : ∀ t : ℝ, 0 < t →
      Tendsto (fun n => ∫ s, (t + s)⁻¹ ∂(μ n)) atTop (𝓝 (∫ s, (t + s)⁻¹ ∂ν))) :
    Tendsto (fun n => negLogIntegral (μ n)) atTop (𝓝 (negLogIntegral ν)) := by
  -- the shifted resolvents of `μ n` and `ν`
  have hD : ∀ n t, 0 < t →
      resolventShift (μ n) t = ∫ s, (t + s)⁻¹ ∂(μ n) - ν.real Set.univ * (1 + t)⁻¹ := by
    intro n t ht
    rw [(resolventParts_finite (hμ n) ht).2.2, measureReal_def, measureReal_def, hmass n]
  have hDν : ∀ t, 0 < t →
      resolventShift ν t = ∫ s, (t + s)⁻¹ ∂ν - ν.real Set.univ * (1 + t)⁻¹ :=
    fun t ht => (resolventParts_finite hν ht).2.2
  have hDmono : ∀ t, 0 < t → Monotone fun n => resolventShift (μ n) t := by
    intro t ht m n hmn
    have h : ∫ s, (t + s)⁻¹ ∂(μ m) ≤ ∫ s, (t + s)⁻¹ ∂(μ n) := hmono t ht hmn
    show resolventShift (μ m) t ≤ resolventShift (μ n) t
    rw [hD m t ht, hD n t ht]
    linarith
  have hDlim : ∀ t, 0 < t →
      Tendsto (fun n => resolventShift (μ n) t) atTop (𝓝 (resolventShift ν t)) := by
    intro t ht
    rw [hDν t ht]
    exact Tendsto.congr (fun n => (hD n t ht).symm) ((hlim t ht).sub tendsto_const_nhds)
  have hD0 : ∀ t, 0 < t → resolventShift (μ 0) t ≤ resolventShift ν t := fun t ht =>
    ge_of_tendsto (hDlim t ht) (Filter.Eventually.of_forall fun n => hDmono t ht (Nat.zero_le n))
  -- the common subtracted constant `∫_{t>0} Q_{μ 0} = ∫ log⁺ dμ₀ < ∞`
  have hq : ∫⁻ t in Set.Ioi 0, resolventNegPart (μ 0) t ≠ ∞ := by
    rw [← lintegral_toENNReal_log_eq (hμ 0)]
    exact fun h => hμbot 0 (negLogIntegral_eq_bot_iff.mpr h)
  -- every `∫ -log dρ` with `D_ρ ≥ D_{μ 0}` is `∫_{t>0} (D_ρ + Q_{μ 0})⁺ - ∫_{t>0} Q_{μ 0}`
  have hrep : ∀ ρ : Measure ℝ, [IsFiniteMeasure ρ] → (∀ᵐ s ∂ρ, 0 ≤ s) →
      negLogIntegral ρ ≠ ⊥ → (∀ t, 0 < t → resolventShift (μ 0) t ≤ resolventShift ρ t) →
      negLogIntegral ρ =
        ((∫⁻ t in Set.Ioi 0,
            ENNReal.ofReal (resolventShift ρ t + (resolventNegPart (μ 0) t).toReal) : ℝ≥0∞) :
          EReal) - ((∫⁻ t in Set.Ioi 0, resolventNegPart (μ 0) t : ℝ≥0∞) : EReal) := by
    intro ρ _ hρ hρbot hle
    have hQρ : ∫⁻ t in Set.Ioi 0, resolventNegPart ρ t ≠ ∞ := by
      rw [← lintegral_toENNReal_log_eq hρ]
      exact fun h => hρbot (negLogIntegral_eq_bot_iff.mpr h)
    rw [negLogIntegral_eq_resolventParts hρ]
    refine coe_sub_coe_eq_of_add_eq hq hQρ ?_
    rw [← lintegral_add_left (measurable_resolventPosPart ρ),
      ← lintegral_add_left (measurable_resolventNegPart ρ)]
    exact setLIntegral_congr_fun measurableSet_Ioi fun t ht =>
      resolventPosPart_add_eq hρ (hμ 0) ht (hle t ht)
  -- monotone convergence in `t`
  have hT : Tendsto (fun n => ∫⁻ t in Set.Ioi 0,
        ENNReal.ofReal (resolventShift (μ n) t + (resolventNegPart (μ 0) t).toReal)) atTop
      (𝓝 (∫⁻ t in Set.Ioi 0,
        ENNReal.ofReal (resolventShift ν t + (resolventNegPart (μ 0) t).toReal))) := by
    refine lintegral_tendsto_of_tendsto_of_monotone
      (fun n => (((measurable_resolventShift (μ n)).add
        (measurable_resolventNegPart (μ 0)).ennreal_toReal).ennreal_ofReal).aemeasurable) ?_ ?_
    · refine (ae_restrict_iff' measurableSet_Ioi).2 (Filter.Eventually.of_forall fun t ht => ?_)
      intro m n hmn
      have h : resolventShift (μ m) t ≤ resolventShift (μ n) t := hDmono t ht hmn
      exact ENNReal.ofReal_le_ofReal (by linarith)
    · refine (ae_restrict_iff' measurableSet_Ioi).2 (Filter.Eventually.of_forall fun t ht => ?_)
      exact ENNReal.tendsto_ofReal ((hDlim t ht).add tendsto_const_nhds)
  have hfun : (fun n => negLogIntegral (μ n)) = fun n =>
      ((∫⁻ t in Set.Ioi 0,
          ENNReal.ofReal (resolventShift (μ n) t + (resolventNegPart (μ 0) t).toReal) : ℝ≥0∞) :
        EReal) - ((∫⁻ t in Set.Ioi 0, resolventNegPart (μ 0) t : ℝ≥0∞) : EReal) :=
    funext fun n => hrep (μ n) (hμ n) (hμbot n) fun t ht => hDmono t ht (Nat.zero_le n)
  rw [hfun, hrep ν hν hνbot hD0]
  exact tendsto_coe_ennreal_sub_coe hT hq

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-! ### The union of an increasing sequence and strong⋆ density -/

/-- The union of an increasing sequence of von Neumann algebras, as a unital `⋆`-subalgebra of
`B(H)`. -/
noncomputable def iUnionStarSubalgebra (M : ℕ → VonNeumannAlgebra H) (hM : Monotone M) :
    StarSubalgebra ℂ (H →L[ℂ] H) where
  carrier := ⋃ n, (M n : Set (H →L[ℂ] H))
  mul_mem' := by
    intro a b ha hb
    obtain ⟨m, ha⟩ := Set.mem_iUnion.1 ha
    obtain ⟨n, hb⟩ := Set.mem_iUnion.1 hb
    exact Set.mem_iUnion.2
      ⟨max m n, mul_mem (hM (le_max_left m n) ha) (hM (le_max_right m n) hb)⟩
  one_mem' := Set.mem_iUnion.2 ⟨0, one_mem (M 0)⟩
  add_mem' := by
    intro a b ha hb
    obtain ⟨m, ha⟩ := Set.mem_iUnion.1 ha
    obtain ⟨n, hb⟩ := Set.mem_iUnion.1 hb
    exact Set.mem_iUnion.2
      ⟨max m n, add_mem (hM (le_max_left m n) ha) (hM (le_max_right m n) hb)⟩
  zero_mem' := Set.mem_iUnion.2 ⟨0, zero_mem (M 0)⟩
  algebraMap_mem' r := Set.mem_iUnion.2 ⟨0, (M 0).toStarSubalgebra.algebraMap_mem r⟩
  star_mem' := by
    intro a ha
    obtain ⟨n, ha⟩ := Set.mem_iUnion.1 ha
    exact Set.mem_iUnion.2 ⟨n, star_mem ha⟩

lemma mem_iUnionStarSubalgebra {M : ℕ → VonNeumannAlgebra H} {hM : Monotone M}
    {y : H →L[ℂ] H} : y ∈ iUnionStarSubalgebra M hM ↔ ∃ n, y ∈ M n :=
  Set.mem_iUnion

/-- A union of von Neumann algebras is star-closed. -/
lemma star_iUnion_coe {K : Type*} [NormedAddCommGroup K] [InnerProductSpace ℂ K]
    [CompleteSpace K] {ι : Type*} (M : ι → VonNeumannAlgebra K) :
    star (⋃ i, (M i : Set (K →L[ℂ] K))) = ⋃ i, (M i : Set (K →L[ℂ] K)) := by
  ext x
  simp only [Set.mem_star, Set.mem_iUnion, SetLike.mem_coe]
  exact ⟨fun ⟨i, hi⟩ => ⟨i, by simpa only [star_star] using star_mem hi⟩,
    fun ⟨i, hi⟩ => ⟨i, star_mem hi⟩⟩

/-- An algebra generated by `⋃ n, M n` lies in the double commutant of the union. -/
lemma mem_centralizer_centralizer_of_le_generated {M : ℕ → VonNeumannAlgebra H}
    (hM : Monotone M) {N : VonNeumannAlgebra H}
    (hN : N ≤ generated (⋃ n, (M n : Set (H →L[ℂ] H)))) {x : H →L[ℂ] H} (hx : x ∈ N) :
    x ∈ Set.centralizer (Set.centralizer (iUnionStarSubalgebra M hM : Set (H →L[ℂ] H))) := by
  have h := hN hx
  rw [← SetLike.mem_coe, coe_generated_of_star_eq (star_iUnion_coe M)] at h
  exact h

/-- **Strong⋆ density of a `⋆`-algebra in its double commutant.** For a unital `⋆`-subalgebra
`A ⊆ B(H)`, `x ∈ A''` and vectors `ξ, η`, the pair `(x ξ, x⋆ η)` is a limit of pairs
`(y ξ, y⋆ η)` with `y ∈ A`.

A point outside the (convex) closure is separated by a continuous functional `f` on `H × H`
(Hahn–Banach); its components are `⟪a, ·⟫` and `⟪b, ·⟫` (Riesz). Since `A` is a complex subspace,
`G(y) = ⟪a, y ξ⟫ + ⟪η, y b⟫`, whose real part is `re f (y ξ, y⋆ η)`, vanishes on `A`. It is
WOT-continuous, so it vanishes on the WOT-closure `A''` (`wotClosure_eq_doubleCommutant`), in
particular at `x`, a contradiction. -/
theorem mem_closure_image_of_mem_centralizer_centralizer (A : StarSubalgebra ℂ (H →L[ℂ] H))
    {x : H →L[ℂ] H} (hx : x ∈ Set.centralizer (Set.centralizer (A : Set (H →L[ℂ] H))))
    (ξ η : H) :
    (x ξ, star x η) ∈
      closure ((fun y : H →L[ℂ] H => (y ξ, star y η)) '' (A : Set (H →L[ℂ] H))) := by
  by_contra hnot
  have hconv : Convex ℝ ((fun y : H →L[ℂ] H => (y ξ, star y η)) '' (A : Set (H →L[ℂ] H))) := by
    rintro _ ⟨y₁, hy₁, rfl⟩ _ ⟨y₂, hy₂, rfl⟩ a b - - -
    refine ⟨(a : ℂ) • y₁ + (b : ℂ) • y₂,
      add_mem (SMulMemClass.smul_mem _ hy₁) (SMulMemClass.smul_mem _ hy₂), ?_⟩
    ext
    · simp [Complex.coe_smul]
    · simp [star_smul, Complex.coe_smul]
  obtain ⟨f, u, hfs, hfx⟩ :=
    RCLike.geometric_hahn_banach_closed_point (𝕜 := ℂ) hconv.closure isClosed_closure hnot
  -- Riesz vectors of the two components of `f`
  obtain ⟨a, ha⟩ : ∃ a : H, ∀ p : H, ⟪a, p⟫_ℂ = f (p, 0) :=
    ⟨(InnerProductSpace.toDual ℂ H).symm (f.comp (ContinuousLinearMap.inl ℂ H H)),
      fun _ => InnerProductSpace.toDual_symm_apply⟩
  obtain ⟨b, hb⟩ : ∃ b : H, ∀ q : H, ⟪b, q⟫_ℂ = f (0, q) :=
    ⟨(InnerProductSpace.toDual ℂ H).symm (f.comp (ContinuousLinearMap.inr ℂ H H)),
      fun _ => InnerProductSpace.toDual_symm_apply⟩
  have hf : ∀ p q : H, f (p, q) = ⟪a, p⟫_ℂ + ⟪b, q⟫_ℂ := by
    intro p q
    rw [ha, hb, ← map_add f (p, 0) (0, q), Prod.mk_add_mk, add_zero, zero_add]
  -- the complex-linear functional `G y = ⟪a, y ξ⟫ + ⟪η, y b⟫` has real part `re f (y ξ, y⋆ η)`
  have hfG : ∀ y : H →L[ℂ] H,
      RCLike.re (f (y ξ, star y η)) = (⟪a, y ξ⟫_ℂ + ⟪η, y b⟫_ℂ).re := by
    intro y
    rw [hf, RCLike.re_to_complex, Complex.add_re, Complex.add_re,
      ContinuousLinearMap.star_eq_adjoint, ContinuousLinearMap.adjoint_inner_right,
      ← inner_conj_symm (y b) η, Complex.conj_re]
  have hGu : ∀ y ∈ A, (⟪a, y ξ⟫_ℂ + ⟪η, y b⟫_ℂ).re < u := fun y hy => by
    rw [← hfG]
    exact hfs _ (subset_closure ⟨y, hy, rfl⟩)
  -- `G` vanishes on `A`: otherwise rescale `y` by `c = (u / |G y|²) conj (G y)`
  have hG0 : ∀ y ∈ A, ⟪a, y ξ⟫_ℂ + ⟪η, y b⟫_ℂ = 0 := by
    intro y hy
    by_contra hne
    have hn : Complex.normSq (⟪a, y ξ⟫_ℂ + ⟪η, y b⟫_ℂ) ≠ 0 := by
      rwa [Ne, Complex.normSq_eq_zero]
    have h1 := hGu ((((u / Complex.normSq (⟪a, y ξ⟫_ℂ + ⟪η, y b⟫_ℂ) : ℝ) : ℂ) *
      (starRingEnd ℂ) (⟪a, y ξ⟫_ℂ + ⟪η, y b⟫_ℂ)) • y) (SMulMemClass.smul_mem _ hy)
    rw [smul_apply, smul_apply, inner_smul_right,
      inner_smul_right, ← mul_add, mul_assoc, ← Complex.normSq_eq_conj_mul_self,
      ← Complex.ofReal_mul, div_mul_cancel₀ _ hn, Complex.ofReal_re] at h1
    exact lt_irrefl u h1
  -- hence `G` vanishes on the WOT-closure `A''` of `A`
  have hmem : ContinuousLinearMapWOT.ofCLM x ∈ closure (WeakOperatorTopology.Set.toWOT (H := H)
      (A.toNonUnitalStarSubalgebra : Set (H →L[ℂ] H))) := by
    rw [NonUnitalStarSubalgebra.wotClosure_eq_doubleCommutant A.toNonUnitalStarSubalgebra
      (InnerProductSpace.actsNondegenerately_of_one_mem A.one_mem)]
    exact hx
  have hclosed : IsClosed {T : H →WOT[ℂ] H | ⟪a, T ξ⟫_ℂ + ⟪η, T b⟫_ℂ = 0} :=
    isClosed_eq ((ContinuousLinearMapWOT.continuous_dual_apply ξ (innerSL ℂ a)).add
      (ContinuousLinearMapWOT.continuous_dual_apply b (innerSL ℂ η))) continuous_const
  have hGx : ⟪a, x ξ⟫_ℂ + ⟪η, x b⟫_ℂ = 0 :=
    closure_minimal (t := {T : H →WOT[ℂ] H | ⟪a, T ξ⟫_ℂ + ⟪η, T b⟫_ℂ = 0})
      (fun T hT => hG0 _ hT) hclosed hmem
  have h0 : RCLike.re (f (x ξ, star x η)) = 0 := by rw [hfG, hGx, Complex.zero_re]
  have hu : 0 < u := by simpa using hGu 0 (zero_mem A)
  linarith

/-! ### Resolvents along an inclusion -/

/-- **Variational lower bound.** For a point `(w, w')` of the graph of the relative Tomita
operator `S_{η,ξ}` of `M` and `t > 0`,
`2 re⟪ξ, w⟫ - t ‖w‖² - ‖w'‖² ≤ ⟪ξ, (t + Δ_{η,ξ})⁻¹ ξ⟫ = ∫ (t + λ)⁻¹ dμ_ξ`. -/
lemma le_integral_inv_add_measure_pvm_relativeModular_of_mem_graph (M : VonNeumannAlgebra H)
    (η ξ : H) {t : ℝ} (ht : 0 < t) {w w' : H}
    (hw : (w, w') ∈ (relativeTomita M η ξ).graphₛₗ) :
    2 * (⟪ξ, w⟫_ℂ).re - t * ‖w‖ ^ 2 - ‖w'‖ ^ 2 ≤ ∫ s, (t + s)⁻¹ ∂μ[M]⟦η, ξ⟧ := by
  have hA := isSelfAdjoint_relativeModular M η ξ
  have hz : (-t : ℂ) ∈ (relativeModular M η ξ).resolventSet :=
    (isPositive_relativeModular M η ξ).mem_resolventSet hA (by simpa using ht)
  have hR : (⟪ξ, (relativeModular M η ξ).resolvent (-t) ξ⟫_ℂ).re =
      -∫ s, (t + s)⁻¹ ∂μ[M]⟦η, ξ⟧ := by
    rw [hA.inner_resolvent_neg_eq_integral ξ hz, Complex.neg_re, Complex.ofReal_re]
  have hmin := (hA.isLeast_re_inner_resolvent_neg (relativeModular_def M η ξ) ht ξ).2
    ⟨w, w', mem_graph_closure_relativeTomita hw, rfl⟩
  rw [hR] at hmin
  linarith

/-- **Monotonicity of the resolvents under inclusion.** For `M ≤ N` and `t > 0`,
`⟪ξ, (t + Δ^M_{η,ξ})⁻¹ ξ⟫ ≤ ⟪ξ, (t + Δ^N_{η,ξ})⁻¹ ξ⟫`: the graph point `(x ξ + ζ, s_M(ξ) x⋆ η)` of
`S^M_{η,ξ}` is dominated by the graph point `((x s_M(ξ)) ξ, s_N(ξ) (x s_M(ξ))⋆ η)` of
`S^N_{η,ξ}`. -/
theorem integral_inv_add_measure_pvm_relativeModular_mono {M N : VonNeumannAlgebra H}
    (hMN : M ≤ N) (η ξ : H) {t : ℝ} (ht : 0 < t) :
    ∫ s, (t + s)⁻¹ ∂μ[M]⟦η, ξ⟧ ≤ ∫ s, (t + s)⁻¹ ∂μ[N]⟦η, ξ⟧ := by
  refine (isSelfAdjoint_relativeModular N η ξ).integral_inv_add_measure_pvm_le_of_forall_mem_graph
    (relativeModular_def N η ξ) (isSelfAdjoint_relativeModular M η ξ)
    (isClosable_relativeTomita M η ξ) (relativeModular_def M η ξ) ξ ξ ?_ ht
  intro w w' hw
  obtain ⟨x, hx, ζ, hζ, h⟩ := mem_graph_relativeTomita.mp hw
  obtain ⟨rfl, rfl⟩ := Prod.ext_iff.mp h
  have hxe : x * M.supportProj ξ ∈ M := mul_mem hx (M.supportProj_mem ξ)
  have hxeξ : (x * M.supportProj ξ) ξ = x ξ := by
    rw [mul_apply_eq_comp, M.supportProj_apply_self ξ]
  have hstar : star (x * M.supportProj ξ) η = M.supportProj ξ (star x η) := by
    rw [star_mul, (M.isStarProjection_supportProj ξ).isSelfAdjoint.star_eq, mul_apply_eq_comp]
  have hK : x ξ ∈ (InnerProductSpace.cyclicSubspace M ξ).toSubmodule :=
    InnerProductSpace.apply_mem_cyclicSubspace ξ hx
  have hK₁ : ξ ∈ (InnerProductSpace.cyclicSubspace M ξ).toSubmodule :=
    self_mem_cyclicSubspace M ξ
  refine ⟨(x * M.supportProj ξ) ξ, N.supportProj ξ (star (x * M.supportProj ξ) η),
    mem_graph_closure_relativeTomita (apply_mem_graph_relativeTomita (hMN hxe)), ?_, ?_, ?_⟩
  · rw [hxeξ]
    have hpy := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero (𝕜 := ℂ) (x ξ) ζ
      (Submodule.inner_right_of_mem_orthogonal hK hζ)
    nlinarith [norm_nonneg (x ξ), norm_nonneg (x ξ + ζ), norm_nonneg ζ]
  · rw [hstar]
    exact Submodule.norm_starProjection_apply_le _ _
  · rw [hxeξ, inner_add_right, Submodule.inner_right_of_mem_orthogonal hK₁ hζ, add_zero]

/-- **The upper bound.** Let `A` be a unital `⋆`-algebra each of whose elements lies in some
`M n ≤ N`, with `N ⊆ A''`. If `⟪ξ, (t + Δ^{M n}_{η,ξ})⁻¹ ξ⟫ ≤ L` for all `n`, then
`⟪ξ, (t + Δ^N_{η,ξ})⁻¹ ξ⟫ ≤ L`.

The maximiser of the variational formula for `N` lies in the closure of the graph of `S^N`. A
graph point `(x ξ + ζ, s_N(ξ) x⋆ η)` is unchanged when `x` is replaced by `x s_N(ξ)`, after which
its second component is `x⋆ η`; `(x ξ, x⋆ η)` is a limit of `(y ξ, y⋆ η)` with `y ∈ A`
(strong⋆ density), and `(y ξ + ζ, s_{M n}(ξ) y⋆ η)` is a graph point of `S^{M n}` whose value of
the variational functional is at least that at `(y ξ + ζ, y⋆ η)`. -/
theorem integral_inv_add_measure_pvm_relativeModular_le_of_forall_le
    {M : ℕ → VonNeumannAlgebra H} {N : VonNeumannAlgebra H} (A : StarSubalgebra ℂ (H →L[ℂ] H))
    (hAM : ∀ y ∈ A, ∃ n, y ∈ M n) (hMN : ∀ n, M n ≤ N)
    (hNA : ∀ x ∈ N, x ∈ Set.centralizer (Set.centralizer (A : Set (H →L[ℂ] H))))
    (η ξ : H) {t : ℝ} (ht : 0 < t) {L : ℝ}
    (hL : ∀ n, ∫ s, (t + s)⁻¹ ∂μ[M n]⟦η, ξ⟧ ≤ L) :
    ∫ s, (t + s)⁻¹ ∂μ[N]⟦η, ξ⟧ ≤ L := by
  have hA := isSelfAdjoint_relativeModular N η ξ
  have hS := isClosable_relativeTomita N η ξ
  have hz : (-t : ℂ) ∈ (relativeModular N η ξ).resolventSet :=
    (isPositive_relativeModular N η ξ).mem_resolventSet hA (by simpa using ht)
  have hR : ∫ s, (t + s)⁻¹ ∂μ[N]⟦η, ξ⟧ =
      -(⟪ξ, (relativeModular N η ξ).resolvent (-t) ξ⟫_ℂ).re := by
    rw [hA.inner_resolvent_neg_eq_integral ξ hz, Complex.neg_re, Complex.ofReal_re, neg_neg]
  obtain ⟨⟨w, w', hw, hval⟩, -⟩ :=
    hA.isLeast_re_inner_resolvent_neg (relativeModular_def N η ξ) ht ξ
  -- every point of the graph of `S^N` satisfies the bound
  have hgraph : ((relativeTomita N η ξ).graphₛₗ : Set (H × H)) ⊆
      {p : H × H | 2 * (⟪ξ, p.1⟫_ℂ).re - t * ‖p.1‖ ^ 2 - ‖p.2‖ ^ 2 ≤ L} := by
    rintro ⟨p₁, p₂⟩ hp
    obtain ⟨x, hx, ζ, hζ, h⟩ := mem_graph_relativeTomita.mp hp
    obtain ⟨rfl, rfl⟩ := Prod.ext_iff.mp h
    have hxe : x * N.supportProj ξ ∈ N := mul_mem hx (N.supportProj_mem ξ)
    have hxeξ : (x * N.supportProj ξ) ξ = x ξ := by
      rw [mul_apply_eq_comp, N.supportProj_apply_self ξ]
    have hstar : star (x * N.supportProj ξ) η = N.supportProj ξ (star x η) := by
      rw [star_mul, (N.isStarProjection_supportProj ξ).isSelfAdjoint.star_eq, mul_apply_eq_comp]
    have hclos := mem_closure_image_of_mem_centralizer_centralizer A (hNA _ hxe) ξ η
    have hC : IsClosed
        {q : H × H | 2 * (⟪ξ, q.1 + ζ⟫_ℂ).re - t * ‖q.1 + ζ‖ ^ 2 - ‖q.2‖ ^ 2 ≤ L} :=
      isClosed_le (by fun_prop) continuous_const
    have himg : (fun y : H →L[ℂ] H => (y ξ, star y η)) '' (A : Set (H →L[ℂ] H)) ⊆
        {q : H × H | 2 * (⟪ξ, q.1 + ζ⟫_ℂ).re - t * ‖q.1 + ζ‖ ^ 2 - ‖q.2‖ ^ 2 ≤ L} := by
      rintro _ ⟨y, hy, rfl⟩
      obtain ⟨n, hyn⟩ := hAM y hy
      have hζn : ζ ∈ (InnerProductSpace.cyclicSubspace (M n) ξ).toSubmoduleᗮ := by
        rw [InnerProductSpace.mem_orthogonal_cyclicSubspace_iff] at hζ ⊢
        exact fun a ha => hζ a (hMN n ha)
      have hle := le_integral_inv_add_measure_pvm_relativeModular_of_mem_graph (M n) η ξ ht
        (mk_mem_graph_relativeTomita (η := η) hyn hζn)
      have hs : ‖(M n).supportProj ξ (star y η)‖ ≤ ‖star y η‖ :=
        Submodule.norm_starProjection_apply_le _ _
      have hsq := pow_le_pow_left₀ (norm_nonneg _) hs 2
      have hLn := hL n
      show 2 * (⟪ξ, y ξ + ζ⟫_ℂ).re - t * ‖y ξ + ζ‖ ^ 2 - ‖star y η‖ ^ 2 ≤ L
      linarith
    have hfin : 2 * (⟪ξ, (x * N.supportProj ξ) ξ + ζ⟫_ℂ).re
        - t * ‖(x * N.supportProj ξ) ξ + ζ‖ ^ 2 - ‖star (x * N.supportProj ξ) η‖ ^ 2 ≤ L :=
      closure_minimal himg hC hclos
    rw [hxeξ, hstar] at hfin
    exact hfin
  have hmem : 2 * (⟪ξ, w⟫_ℂ).re - t * ‖w‖ ^ 2 - ‖w'‖ ^ 2 ≤ L := by
    have hw' : (w, w') ∈ ((relativeTomita N η ξ).closureₛₗ.graphₛₗ : Set (H × H)) := hw
    rw [hS.coe_graphₛₗ_closureₛₗ] at hw'
    exact closure_minimal hgraph (isClosed_le (by fun_prop) continuous_const) hw'
  rw [hR, hval]
  linarith

/-! ### Vector functionals -/

/-- **Upward continuity of the resolvents.** For `M n ↑`, `M n ≤ N ≤ (⋃ n, M n)''` and `t > 0`,
`⟪ξ, (t + Δ^{M n}_{η,ξ})⁻¹ ξ⟫ → ⟪ξ, (t + Δ^N_{η,ξ})⁻¹ ξ⟫`. -/
theorem tendsto_integral_inv_add_measure_pvm_relativeModular {M : ℕ → VonNeumannAlgebra H}
    (hM : Monotone M) {N : VonNeumannAlgebra H} (hMN : ∀ n, M n ≤ N)
    (hN : N ≤ generated (⋃ n, (M n : Set (H →L[ℂ] H)))) (η ξ : H) {t : ℝ} (ht : 0 < t) :
    Tendsto (fun n => ∫ s, (t + s)⁻¹ ∂μ[M n]⟦η, ξ⟧) atTop
      (𝓝 (∫ s, (t + s)⁻¹ ∂μ[N]⟦η, ξ⟧)) := by
  have hmono : Monotone fun n => ∫ s, (t + s)⁻¹ ∂μ[M n]⟦η, ξ⟧ :=
    fun m n hmn => integral_inv_add_measure_pvm_relativeModular_mono (hM hmn) η ξ ht
  have hbdd : BddAbove (Set.range fun n => ∫ s, (t + s)⁻¹ ∂μ[M n]⟦η, ξ⟧) := by
    refine ⟨∫ s, (t + s)⁻¹ ∂μ[N]⟦η, ξ⟧, ?_⟩
    rintro _ ⟨n, rfl⟩
    exact integral_inv_add_measure_pvm_relativeModular_mono (hMN n) η ξ ht
  have hsup : ⨆ n, ∫ s, (t + s)⁻¹ ∂μ[M n]⟦η, ξ⟧ = ∫ s, (t + s)⁻¹ ∂μ[N]⟦η, ξ⟧ := by
    refine le_antisymm
      (ciSup_le fun n => integral_inv_add_measure_pvm_relativeModular_mono (hMN n) η ξ ht) ?_
    exact integral_inv_add_measure_pvm_relativeModular_le_of_forall_le
      (iUnionStarSubalgebra M hM) (fun y hy => mem_iUnionStarSubalgebra.1 hy) hMN
      (fun x hx => mem_centralizer_centralizer_of_le_generated hM hN hx) η ξ ht (le_ciSup hbdd)
  rw [← hsup]
  exact tendsto_atTop_ciSup hmono hbdd

/-! ### Amplification of double commutants -/

section Amplification

variable {H₁ : Type*} [NormedAddCommGroup H₁] [InnerProductSpace ℂ H₁]

/-- Two operators on `H₁ ⊗̂ H` with the same slices `ι_e† (·) ι_f` (`ι_e u = e ⊗ u`) are equal:
the slices determine the matrix coefficients between elementary tensors, which span a dense
subspace. -/
lemma eq_of_forall_slice_eq {A B : H₁ ⊗̂ H →L[ℂ] H₁ ⊗̂ H}
    (h : ∀ e f : H₁, (tmulRightL (H₂ := H) e)† ∘L A ∘L tmulRightL f =
      (tmulRightL (H₂ := H) e)† ∘L B ∘L tmulRightL f) : A = B := by
  have hpure : ∀ (f : H₁) (v : H), A (f ⊗ₕ v) = B (f ⊗ₕ v) := by
    intro f v
    refine ext_inner_left ℂ fun w => ?_
    refine UniformSpace.Completion.induction_on w
      (isClosed_eq (by fun_prop) (by fun_prop)) fun a => ?_
    induction a using TensorProduct.inductionOn with
    | tmul e u =>
        have := congrArg (fun L : H →L[ℂ] H => ⟪u, L v⟫_ℂ) (h e f)
        simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.adjoint_inner_right,
          HilbertTensor.tmulRightL_apply] at this
        exact this
    | add p q hp hq =>
        rw [UniformSpace.Completion.coe_add, inner_add_left, inner_add_left, hp, hq]
  refine ContinuousLinearMap.ext fun w => ?_
  refine UniformSpace.Completion.induction_on w
    (isClosed_eq A.continuous B.continuous) fun a => ?_
  induction a using TensorProduct.inductionOn with
  | tmul f v => exact hpure f v
  | add p q hp hq => rw [UniformSpace.Completion.coe_add, map_add, map_add, hp, hq]

/-- **Amplification of the bicommutant.** If `x ∈ s''`, then `1 ⊗ x ∈ (1 ⊗ s)''` on `H₁ ⊗̂ H`.

For `T` commuting with `1 ⊗ s`, every slice `ι_e† T ι_f` commutes with `s`, hence with `x`; so
`T (1 ⊗ x)` and `(1 ⊗ x) T` have the same slices. (A WOT-approximation argument on the
amplification would need bounded approximants, i.e. Kaplansky density; this commutant argument
does not.) -/
lemma amplifyRight_mem_centralizer_centralizer {s : Set (H →L[ℂ] H)} {x : H →L[ℂ] H}
    (hx : x ∈ Set.centralizer (Set.centralizer s)) :
    amplifyRight (H₁ := H₁) x ∈
      Set.centralizer (Set.centralizer (amplifyRight (H₁ := H₁) '' s)) := by
  rw [Set.mem_centralizer_iff]
  intro T hT
  rw [Set.mem_centralizer_iff] at hT
  -- `ι_e : u ↦ e ⊗ u` intertwines `a` with `1 ⊗ a`, and `ι_e†` intertwines `1 ⊗ a` with `a`
  have h₁ : ∀ (e : H₁) (a : H →L[ℂ] H), (𝟙 ⊗ a) ∘L tmulRightL e = tmulRightL e ∘L a :=
    fun e a => ContinuousLinearMap.ext fun u => by simp [HilbertTensor.amplifyRight_tmul]
  have h₂ : ∀ (e : H₁) (a : H →L[ℂ] H),
      (tmulRightL (H₂ := H) e)† ∘L (𝟙 ⊗ a) = a ∘L (tmulRightL e)† := by
    intro e a
    have h := congrArg ContinuousLinearMap.adjoint (h₁ e (a†))
    rwa [ContinuousLinearMap.adjoint_comp, ContinuousLinearMap.adjoint_comp,
      HilbertTensor.amplifyRight_adjoint, ContinuousLinearMap.adjoint_adjoint] at h
  -- the slices of `T` lie in `s'`
  have hslice : ∀ e f : H₁,
      (tmulRightL (H₂ := H) e)† ∘L T ∘L tmulRightL f ∈ Set.centralizer s := by
    intro e f
    rw [Set.mem_centralizer_iff]
    intro a ha
    have hTa : (𝟙 ⊗ a) * T = T * (𝟙 ⊗ a) := hT _ ⟨a, ha, rfl⟩
    ext v
    have e₁ : a (((tmulRightL e)†) (T (tmulRightL f v))) =
        ((tmulRightL e)†) ((𝟙 ⊗ a) (T (tmulRightL f v))) :=
      (DFunLike.congr_fun (h₂ e a) _).symm
    have e₂ : (𝟙 ⊗ a) (T (tmulRightL f v)) = T ((𝟙 ⊗ a) (tmulRightL f v)) :=
      DFunLike.congr_fun hTa _
    have e₃ : (𝟙 ⊗ a) (tmulRightL f v) = tmulRightL f (a v) :=
      DFunLike.congr_fun (h₁ f a) v
    show a (((tmulRightL e)†) (T (tmulRightL f v))) = ((tmulRightL e)†) (T (tmulRightL f (a v)))
    rw [e₁, e₂, e₃]
  -- hence `T (1 ⊗ x)` and `(1 ⊗ x) T` have the same slices
  refine eq_of_forall_slice_eq fun e f => ?_
  have hc := (Set.mem_centralizer_iff.1 hx) _ (hslice e f)
  ext v
  have e₁ : ((tmulRightL e)†) ((𝟙 ⊗ x) (T (tmulRightL f v))) =
      x (((tmulRightL e)†) (T (tmulRightL f v))) :=
    DFunLike.congr_fun (h₂ e x) _
  have e₃ : (𝟙 ⊗ x) (tmulRightL f v) = tmulRightL f (x v) :=
    DFunLike.congr_fun (h₁ f x) v
  have hcv : ((tmulRightL e)†) (T (tmulRightL f (x v))) =
      x (((tmulRightL e)†) (T (tmulRightL f v))) :=
    DFunLike.congr_fun hc v
  show ((tmulRightL e)†) (T ((𝟙 ⊗ x) (tmulRightL f v))) =
    ((tmulRightL e)†) ((𝟙 ⊗ x) (T (tmulRightL f v)))
  rw [e₃, e₁]
  exact hcv

/-- If `N ≤ (⋃ n, M n)''`, then `1 ⊗ N ≤ (⋃ n, 1 ⊗ M n)''` on `H₁ ⊗̂ H`. -/
lemma oneTensor_le_generated_iUnion {M : ℕ → VonNeumannAlgebra H} {N : VonNeumannAlgebra H}
    (hN : N ≤ generated (⋃ n, (M n : Set (H →L[ℂ] H)))) :
    𝟙[H₁] ⊗ N ≤ generated (⋃ n, ((𝟙[H₁] ⊗ M n : VonNeumannAlgebra (H₁ ⊗̂ H)) :
      Set (H₁ ⊗̂ H →L[ℂ] H₁ ⊗̂ H))) := by
  intro y hy
  obtain ⟨x, hx, rfl⟩ := mem_oneTensor_iff.mp hy
  have hx' : x ∈ Set.centralizer (Set.centralizer (⋃ n, (M n : Set (H →L[ℂ] H)))) := by
    have h := hN hx
    rwa [← SetLike.mem_coe, coe_generated_of_star_eq (star_iUnion_coe M)] at h
  have hsub : amplifyRight (H₁ := H₁) '' (⋃ n, (M n : Set (H →L[ℂ] H))) ⊆
      ⋃ n, ((𝟙[H₁] ⊗ M n : VonNeumannAlgebra (H₁ ⊗̂ H)) : Set (H₁ ⊗̂ H →L[ℂ] H₁ ⊗̂ H)) := by
    rintro _ ⟨a, ha, rfl⟩
    obtain ⟨n, hn⟩ := Set.mem_iUnion.1 ha
    exact Set.mem_iUnion.2 ⟨n, amplifyRight_mem_oneTensor hn⟩
  have hstar : star (⋃ n, ((𝟙[H₁] ⊗ M n : VonNeumannAlgebra (H₁ ⊗̂ H)) :
      Set (H₁ ⊗̂ H →L[ℂ] H₁ ⊗̂ H))) =
      ⋃ n, ((𝟙[H₁] ⊗ M n : VonNeumannAlgebra (H₁ ⊗̂ H)) : Set (H₁ ⊗̂ H →L[ℂ] H₁ ⊗̂ H)) :=
    star_iUnion_coe _
  rw [← SetLike.mem_coe, coe_generated_of_star_eq hstar]
  exact Set.centralizer_subset (Set.centralizer_subset hsub)
    (amplifyRight_mem_centralizer_centralizer hx')

end Amplification

/-! ### Normal functionals that agree on a subalgebra -/

/-- The relative entropy of any normal functionals on `M ≤ N` that agree with `ψ, φ` on `M` is
computed on the amplification `1 ⊗ M` with the representing vectors of `ψ, φ` on `N`. -/
lemma arakiEntropy_eq_arakiVec_of_apply_eq {M N : VonNeumannAlgebra H} (h : M ≤ N)
    {ψ φ : N.NormalFunctional} {ψ' φ' : M.NormalFunctional}
    (hψ : ∀ x : M, ψ'.1 x = ψ.1 ⟨x, h x.2⟩) (hφ : ∀ x : M, φ'.1 x = φ.1 ⟨x, h x.2⟩) :
    S⟦ψ' ∥ φ'⟧ = S[𝟙[ℓ²(ℕ, ℂ)] ⊗ M]⟦ψ.2.vec ∥ φ.2.vec⟧ :=
  arakiEntropy_eq_arakiVec (fun x => (ψ.2.inner_vec_amplifyRight ⟨x, h x.2⟩).trans (hψ x).symm)
    (fun x => (φ.2.inner_vec_amplifyRight ⟨x, h x.2⟩).trans (hφ x).symm)

end CTheorem.Continuity

/-! ### The headline theorems -/

namespace CTheorem

open VonNeumannAlgebra Continuity

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- **Upward continuity of Araki's relative entropy (vector form).** Let `M n` be an increasing
sequence of von Neumann algebras with `M n ≤ N ≤ (⋃ n, M n)''`. Then
`S_{M n}(ω_ξ ‖ ω_η) → S_N(ω_ξ ‖ ω_η)` in `EReal`. -/
theorem tendsto_arakiVec_of_le_generated {M : ℕ → VonNeumannAlgebra H} (hM : Monotone M)
    {N : VonNeumannAlgebra H} (hMN : ∀ n, M n ≤ N)
    (hN : N ≤ generated (⋃ n, (M n : Set (H →L[ℂ] H)))) (ξ η : H) :
    Tendsto (fun n => S[M n]⟦ξ ∥ η⟧) atTop (𝓝 S[N]⟦ξ ∥ η⟧) :=
  tendsto_negLogIntegral_of_monotone_resolvent (μ := fun n => μ[M n]⟦η, ξ⟧)
    (fun n => ae_nonneg_measure_pvm_relativeModular (M n) ξ η)
    (ae_nonneg_measure_pvm_relativeModular N ξ η)
    (fun n => by
      show μ[M n]⟦η, ξ⟧ Set.univ = μ[N]⟦η, ξ⟧ Set.univ
      rw [ProjectionValuedMeasure.measure_univ, ProjectionValuedMeasure.measure_univ])
    (fun n => arakiVec_ne_bot (M n) ξ η) (arakiVec_ne_bot N ξ η)
    (fun _ ht _ _ hmn => integral_inv_add_measure_pvm_relativeModular_mono (hM hmn) η ξ ht)
    (fun _ ht => tendsto_integral_inv_add_measure_pvm_relativeModular hM hMN hN η ξ ht)

/-- **Upward continuity of Araki's relative entropy (normal functionals).** Let `M n` be an
increasing sequence of von Neumann algebras with `M n ≤ N ≤ (⋃ n, M n)''`, `ψ, φ` normal positive
functionals on `N`, and `ψ' n, φ' n` normal functionals on `M n` agreeing with `ψ, φ` on `M n`
(any construction of the restrictions). Then `S(ψ' n ‖ φ' n) → S(ψ ‖ φ)` in `EReal`. -/
theorem tendsto_arakiEntropy_of_apply_eq {M : ℕ → VonNeumannAlgebra H} (hM : Monotone M)
    {N : VonNeumannAlgebra H} (hMN : ∀ n, M n ≤ N)
    (hN : N ≤ generated (⋃ n, (M n : Set (H →L[ℂ] H)))) (ψ φ : N.NormalFunctional)
    (ψ' φ' : ∀ n, (M n).NormalFunctional)
    (hψ : ∀ n (x : M n), (ψ' n).1 x = ψ.1 ⟨x, hMN n x.2⟩)
    (hφ : ∀ n (x : M n), (φ' n).1 x = φ.1 ⟨x, hMN n x.2⟩) :
    Tendsto (fun n => S⟦ψ' n ∥ φ' n⟧) atTop (𝓝 S⟦ψ ∥ φ⟧) := by
  have h := tendsto_arakiVec_of_le_generated (H := ℓ²(ℕ, ℂ) ⊗̂ H)
    (M := fun n => 𝟙[ℓ²(ℕ, ℂ)] ⊗ M n) (N := 𝟙[ℓ²(ℕ, ℂ)] ⊗ N)
    (fun _ _ hmn => oneTensor_mono (hM hmn)) (fun n => oneTensor_mono (hMN n))
    (oneTensor_le_generated_iUnion hN) ψ.2.vec φ.2.vec
  exact (Filter.tendsto_congr fun n =>
    arakiEntropy_eq_arakiVec_of_apply_eq (hMN n) (hψ n) (hφ n)).2 h

end CTheorem
