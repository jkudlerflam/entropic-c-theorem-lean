import ModularCTheorem.Araki.MutualInfo
import QuantumSystem.Analysis.VonNeumannAlgebra.TypeI.Classification

/-!
# T4. Matrix approximation of type I factors

A *unital matrix subfactor* is a von Neumann algebra `⋆`-isomorphic to `B(ℂ^d)`, stated here as the
explicit `Nonempty (F ≃⋆ₐ[ℂ] (EuclideanSpace ℂ (Fin d) →L[ℂ] EuclideanSpace ℂ (Fin d)))`. This file
proves:

* `CTheorem.exists_matrixSubfactor_seq_pair` (tensor-compatible version): for type I factors
  `X' ≤ X` there are increasing unital matrix subfactors `P n ≤ X'` and `R n ≤ X ∩ X'′` with
  `X' = (⋃ P n)''` and `X = (⋃ join (P n) (R n))''`.

Internally (namespace `CTheorem.T4`) matrix subfactors are handled through systems of matrix units
(`T4.IsMatrixUnits`, `T4.IsMUSubfactor`); `T4.IsMUSubfactor.nonempty_starAlgEquiv` converts to the
`⋆`-isomorphism form, via `M ↦ ∑ M i j • E i j` and the fact that the von Neumann algebra
generated by matrix units is their linear span (`T4.exists_muFun_eq`).

## Route

*Finite multiplicity.* If the covering family `F` of minimal projections of `N` (library
`IsFactor.exists_orthEquivFam_top`) is finite, the library matrix units `e_{pq}` exhibit `N` itself
as a unital matrix subfactor, and the sequence is constant.

*Infinite multiplicity.* `F` is countable (separability, `T4.TypeIData.countable`), so `F ≃ ℕ`.
On `ℓ²(F) ≅ ℓ²(ℕ)` the isometries `s_i δ_c = δ_{2c+i}` satisfy the Cuntz relations
`s_i⋆ s_j = δ_{ij}`, `s_0 s_0⋆ + s_1 s_1⋆ = 1` (`T4.cuntzS_isCuntzPair`). For binary words
`w, w'` of length `n`, `s_w s_{w'}⋆` is a system of `2ⁿ × 2ⁿ` matrix units refining at level
`n + 1`. Transported into `N` by `x ↦ U⋆ (x ⊗ 1) U` (`T4.ampConj`, `U` the library's spatial
isomorphism) they generate increasing unital matrix subfactors. Generation: an operator commuting
with all of them commutes with every library matrix unit `e_{pq}` (`T4.commute_matrixUnit_of`),
because for `n` beyond the binary length of `p, q` a word moves `δ_0` to `δ_p`
(`T4.exists_word_eq`), so `e_{pp} E_{ww'} = e_{pq} = E_{ww'} e_{qq}`; then the resolution of the
identity `∑ e_{rr} = 1` finishes.

*Pairs.* For `X' ≤ X` the relative commutant `S = X'′ ∩ X` (`T4.relCommutant`) is a type I factor
and `X = (X' ∪ S)''` (`T4.relCommutant_isTypeIFactor`, `T4.generated_union_relCommutant`). Both
rest on the lift `y ↦ ỹ ∈ X'′` with `e_{00} ỹ = y` for `y = e_{00} y e_{00}`
(`T4.TypeIData.lift`), built spatially as `U⋆ (1 ⊗ ι⋆ (U y U⋆) ι) U` with `ι = δ_0 ⊗ (·)`.
-/

open scoped InnerProductSpace InnerProduct VonNeumannAlgebra HilbertTensor lp
open VonNeumannAlgebra HilbertTensor

namespace CTheorem

noncomputable section

namespace T4

/-! ### Matrix units in a `⋆`-ring -/

section MatrixUnits

variable {A : Type*} [Ring A] [StarRing A]

/-- A system of matrix units indexed by a finite type `ι`, summing to the identity:
`E i j * E k l = δ_{jk} E i l`, `(E i j)⋆ = E j i`, `∑ i, E i i = 1`. -/
structure IsMatrixUnits {ι : Type*} [Fintype ι] [DecidableEq ι] (E : ι → ι → A) : Prop where
  mul_eq : ∀ i j k l, E i j * E k l = if j = k then E i l else 0
  star_eq : ∀ i j, star (E i j) = E j i
  sum_eq : ∑ i, E i i = 1

namespace IsMatrixUnits

variable {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
  {E : ι → ι → A}

/-- Matrix units can be reindexed along an equivalence. -/
lemma reindex (hE : IsMatrixUnits E) (e : κ ≃ ι) : IsMatrixUnits (fun a b => E (e a) (e b)) where
  mul_eq a b c d := by
    show E (e a) (e b) * E (e c) (e d) = if b = c then E (e a) (e d) else 0
    rw [hE.mul_eq]
    by_cases h : b = c
    · rw [ite_eq_left h, ite_eq_left (congrArg e h)]
    · rw [ite_eq_right h, ite_eq_right (e.injective.ne h)]
  star_eq a b := hE.star_eq _ _
  sum_eq := by
    show ∑ a, E (e a) (e a) = 1
    rw [← hE.sum_eq]
    exact e.sum_comp (fun i => E i i)

/-- Matrix units are carried to matrix units by a unital `⋆`-homomorphism. -/
lemma map {B : Type*} [Ring B] [StarRing B] [Algebra ℂ A] [Algebra ℂ B]
    (hE : IsMatrixUnits E) (ψ : A →⋆ₐ[ℂ] B) : IsMatrixUnits (fun i j => ψ (E i j)) where
  mul_eq i j k l := by
    show ψ (E i j) * ψ (E k l) = if j = k then ψ (E i l) else 0
    rw [← map_mul, hE.mul_eq]
    split_ifs <;> simp
  star_eq i j := by
    show star (ψ (E i j)) = ψ (E j i)
    rw [← map_star, hE.star_eq]
  sum_eq := by
    show ∑ i, ψ (E i i) = 1
    rw [← map_sum, hE.sum_eq, map_one]

end IsMatrixUnits

end MatrixUnits

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-! ### Unital matrix subfactors given by matrix units -/

section MatrixSubfactor

/-- `F` is generated by a system of `ι × ι` matrix units summing to `1`. -/
def IsMUSubfactorOf (F : VonNeumannAlgebra H) (ι : Type*) [Fintype ι] [DecidableEq ι] :
    Prop :=
  ∃ E : ι → ι → (H →L[ℂ] H), IsMatrixUnits E ∧
    F = generated (Set.range fun ij : ι × ι => E ij.1 ij.2)

/-- `F` is generated by a system of `d × d` matrix units summing to `1`. -/
def IsMUSubfactor (F : VonNeumannAlgebra H) (d : ℕ) : Prop :=
  IsMUSubfactorOf F (Fin d)

omit [CompleteSpace H] in
lemma range_reindex {ι κ : Type*} {E : ι → ι → (H →L[ℂ] H)} (e : κ ≃ ι) :
    (Set.range fun ab : κ × κ => E (e ab.1) (e ab.2)) =
      Set.range fun ij : ι × ι => E ij.1 ij.2 := by
  ext x
  constructor
  · rintro ⟨⟨a, b⟩, rfl⟩
    exact ⟨(e a, e b), rfl⟩
  · rintro ⟨⟨i, j⟩, rfl⟩
    exact ⟨(e.symm i, e.symm j), by simp⟩

lemma IsMUSubfactorOf.reindex {F : VonNeumannAlgebra H} {ι κ : Type*} [Fintype ι]
    [DecidableEq ι] [Fintype κ] [DecidableEq κ] (h : IsMUSubfactorOf F ι) (e : κ ≃ ι) :
    IsMUSubfactorOf F κ := by
  obtain ⟨E, hE, hF⟩ := h
  exact ⟨fun a b => E (e a) (e b), hE.reindex e, by rw [hF, range_reindex]⟩

lemma IsMUSubfactorOf.isMUSubfactor {F : VonNeumannAlgebra H} {ι : Type*} [Fintype ι]
    [DecidableEq ι] (h : IsMUSubfactorOf F ι) : IsMUSubfactor F (Fintype.card ι) :=
  h.reindex (Fintype.equivFin ι).symm

/-- On the zero Hilbert space all von Neumann algebras coincide. -/
lemma eq_of_subsingleton [Subsingleton H] (M M' : VonNeumannAlgebra H) : M = M' := by
  ext x
  have hx : x = 1 := ContinuousLinearMap.ext fun _ => Subsingleton.elim _ _
  subst hx
  exact iff_of_true (one_mem _) (one_mem _)

/-- On the zero Hilbert space every von Neumann algebra is generated by the empty system. -/
lemma isMUSubfactor_zero_of_subsingleton [Subsingleton H] (M : VonNeumannAlgebra H) :
    IsMUSubfactor M 0 :=
  ⟨fun i => i.elim0, ⟨fun i => i.elim0, fun i => i.elim0,
    ContinuousLinearMap.ext fun _ => Subsingleton.elim _ _⟩, eq_of_subsingleton _ _⟩

lemma generated_coe (M : VonNeumannAlgebra H) : generated (M : Set (H →L[ℂ] H)) = M :=
  le_antisymm (generated_le subset_rfl) fun _ hx => mem_generated_of_mem hx

lemma generated_iUnion_const (M : VonNeumannAlgebra H) :
    generated (⋃ _ : ℕ, (M : Set (H →L[ℂ] H))) = M := by
  rw [Set.iUnion_const, generated_coe]

end MatrixSubfactor

/-! ### From matrix units to a `⋆`-isomorphism with `M_ι(ℂ)` -/

section MatrixIso

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {E : ι → ι → (H →L[ℂ] H)}

/-- Nonzero Hilbert space: every matrix unit is nonzero. -/
lemma IsMatrixUnits.ne_zero [Nontrivial H] (hE : IsMatrixUnits E) (k l : ι) : E k l ≠ 0 := by
  intro h
  have hll : E l l = 0 := by
    have h0 := hE.mul_eq l k k l
    rw [ite_eq_left rfl, h, mul_zero] at h0
    exact h0.symm
  have hmm : ∀ m, E m m = 0 := by
    intro m
    have h1 := hE.mul_eq m l l m
    have h2 := hE.mul_eq m l l l
    rw [ite_eq_left rfl] at h1 h2
    rw [← h1, ← h2, hll, mul_zero, zero_mul]
  have h10 : (1 : H →L[ℂ] H) = 0 := by
    rw [← hE.sum_eq]
    exact Finset.sum_eq_zero fun m _ => hmm m
  exact one_ne_zero h10

/-- `M ↦ ∑ M i j • E i j`. -/
def muFun (E : ι → ι → (H →L[ℂ] H)) (M : Matrix ι ι ℂ) : H →L[ℂ] H :=
  ∑ i, ∑ j, M i j • E i j

omit [CompleteSpace H] [DecidableEq ι] in
lemma muFun_zero : muFun E 0 = 0 := by
  simp [muFun]

omit [CompleteSpace H] [DecidableEq ι] in
lemma muFun_add (M N : Matrix ι ι ℂ) : muFun E (M + N) = muFun E M + muFun E N := by
  simp only [muFun, Matrix.add_apply, add_smul, Finset.sum_add_distrib]

omit [CompleteSpace H] [DecidableEq ι] in
lemma muFun_smul (r : ℂ) (M : Matrix ι ι ℂ) : muFun E (r • M) = r • muFun E M := by
  simp only [muFun, Matrix.smul_apply, smul_eq_mul, mul_smul, Finset.smul_sum]

lemma muFun_one (hE : IsMatrixUnits E) : muFun E 1 = 1 := by
  rw [← hE.sum_eq]
  unfold muFun
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Finset.sum_eq_single i]
  · rw [Matrix.one_apply_eq, one_smul]
  · intro j _ hj
    rw [Matrix.one_apply_ne (Ne.symm hj), zero_smul]
  · intro h
    exact absurd (Finset.mem_univ i) h

lemma muFun_mul (hE : IsMatrixUnits E) (M N : Matrix ι ι ℂ) :
    muFun E (M * N) = muFun E M * muFun E N := by
  have key : ∀ i j, (M i j • E i j) * muFun E N = ∑ l, (M i j * N j l) • E i l := by
    intro i j
    unfold muFun
    rw [Finset.mul_sum, Finset.sum_eq_single j]
    · rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [smul_mul_smul_comm, hE.mul_eq, ite_eq_left rfl]
    · intro k _ hk
      rw [Finset.mul_sum]
      refine Finset.sum_eq_zero fun l _ => ?_
      rw [smul_mul_smul_comm, hE.mul_eq, ite_eq_right (Ne.symm hk), smul_zero]
    · intro h
      exact absurd (Finset.mem_univ j) h
  conv_rhs => rw [muFun, Finset.sum_mul]
  simp only [Finset.sum_mul, key]
  unfold muFun
  simp only [Matrix.mul_apply, Finset.sum_smul]
  exact Finset.sum_congr rfl fun i _ => Finset.sum_comm

lemma muFun_star (hE : IsMatrixUnits E) (M : Matrix ι ι ℂ) :
    muFun E (star M) = star (muFun E M) := by
  unfold muFun
  simp only [star_sum, star_smul, hE.star_eq, Matrix.star_apply]
  exact Finset.sum_comm

/-- Corner entries: `E k k (∑ M i j E i j) E l l = M k l E k l`. -/
lemma muFun_corner (hE : IsMatrixUnits E) (M : Matrix ι ι ℂ) (k l : ι) :
    E k k * muFun E M * E l l = M k l • E k l := by
  unfold muFun
  rw [Finset.mul_sum, Finset.sum_mul, Finset.sum_eq_single k]
  · rw [Finset.mul_sum, Finset.sum_mul, Finset.sum_eq_single l]
    · rw [mul_smul_comm, smul_mul_assoc, hE.mul_eq, ite_eq_left rfl, hE.mul_eq, ite_eq_left rfl]
    · intro j _ hj
      rw [mul_smul_comm, smul_mul_assoc, hE.mul_eq, ite_eq_left rfl, hE.mul_eq, ite_eq_right hj,
        smul_zero]
    · intro h
      exact absurd (Finset.mem_univ l) h
  · intro i _ hi
    rw [Finset.mul_sum, Finset.sum_mul]
    refine Finset.sum_eq_zero fun j _ => ?_
    rw [mul_smul_comm, smul_mul_assoc, hE.mul_eq, ite_eq_right (Ne.symm hi), zero_mul, smul_zero]
  · intro h
    exact absurd (Finset.mem_univ k) h

lemma muFun_injective (hE : IsMatrixUnits E) (hE0 : ∀ k l, E k l ≠ 0) :
    Function.Injective (muFun E) := by
  intro M N h
  ext k l
  have h1 := muFun_corner hE M k l
  rw [h, muFun_corner hE N k l] at h1
  have h2 : (M k l - N k l) • E k l = 0 := by rw [sub_smul, h1, sub_self]
  rcases smul_eq_zero.mp h2 with h3 | h3
  · exact sub_eq_zero.mp h3
  · exact absurd h3 (hE0 k l)

omit [DecidableEq ι] in
lemma muFun_mem (M : Matrix ι ι ℂ) :
    muFun E M ∈ generated (Set.range fun ij : ι × ι => E ij.1 ij.2) :=
  sum_mem fun i _ => sum_mem fun j _ =>
    SMulMemClass.smul_mem _ (mem_generated_of_mem ⟨(i, j), rfl⟩)

/-- **Corner lemma.** An element `y` of the von Neumann algebra generated by matrix units with
`E o o y = y = y E o o` is a scalar multiple of `E o o`: it commutes with every rank-one
operator on `E o o H`, through the elements `∑ₖ E k o z E o k` of the commutant. -/
lemma corner_smul (hE : IsMatrixUnits E) (o : ι) {y : H →L[ℂ] H}
    (hy : y ∈ generated (Set.range fun ij : ι × ι => E ij.1 ij.2))
    (hl : E o o * y = y) (hr : y * E o o = y) : ∃ c : ℂ, y = c • E o o := by
  have hcomm : ∀ u v : H, y * InnerProductSpace.rankOne ℂ (E o o u) (E o o v) =
      InnerProductSpace.rankOne ℂ (E o o u) (E o o v) * y := by
    intro u v
    obtain ⟨z, hz⟩ : ∃ z, z = InnerProductSpace.rankOne ℂ (E o o u) (E o o v) := ⟨_, rfl⟩
    rw [← hz]
    obtain ⟨zt, hzt⟩ : ∃ zt, zt = ∑ k, E k o * z * E o k := ⟨_, rfl⟩
    have hL : ∀ i j, E i j * zt = E i o * z * E o j := by
      intro i j
      rw [hzt, Finset.mul_sum, Finset.sum_eq_single j]
      · rw [← mul_assoc (E i j) (E j o * z) (E o j), ← mul_assoc (E i j) (E j o) z, hE.mul_eq,
          ite_eq_left rfl]
      · intro k _ hk
        rw [← mul_assoc (E i j) (E k o * z) (E o k), ← mul_assoc (E i j) (E k o) z, hE.mul_eq,
          ite_eq_right (Ne.symm hk), zero_mul, zero_mul]
      · intro h
        exact absurd (Finset.mem_univ j) h
    have hR : ∀ i j, zt * E i j = E i o * z * E o j := by
      intro i j
      rw [hzt, Finset.sum_mul, Finset.sum_eq_single i]
      · rw [mul_assoc (E i o * z) (E o i) (E i j), hE.mul_eq, ite_eq_left rfl]
      · intro k _ hk
        rw [mul_assoc (E k o * z) (E o k) (E i j), hE.mul_eq, ite_eq_right hk, mul_zero]
      · intro h
        exact absurd (Finset.mem_univ i) h
    have hzt_mem : zt ∈ commutantSet (Set.range fun ij : ι × ι => E ij.1 ij.2) := by
      rw [mem_commutantSet_iff]
      rintro _ ⟨⟨i, j⟩, rfl⟩
      refine ⟨by rw [hL, hR], ?_⟩
      show star (E i j) * zt = zt * star (E i j)
      rw [hE.star_eq, hL, hR]
    have hyzt : zt * y = y * zt := by
      have hy' : y ∈ (commutantSet (Set.range fun ij : ι × ι => E ij.1 ij.2)).commutant := hy
      exact mem_commutant_iff.mp hy' zt hzt_mem
    have hPP : E o o * E o o = E o o := by rw [hE.mul_eq, ite_eq_left rfl]
    have hPz : E o o * z = z := by
      rw [hz, ContinuousLinearMap.mul_def, InnerProductSpace.comp_rankOne, ← mul_apply_eq_comp,
        hPP]
    have hzP : z * E o o = z := by
      rw [hz, ContinuousLinearMap.mul_def, InnerProductSpace.rankOne_comp,
        ← ContinuousLinearMap.star_eq_adjoint, hE.star_eq, ← mul_apply_eq_comp, hPP]
    have hPzP : E o o * zt * E o o = z := by
      rw [hL, mul_assoc (E o o * z), hPP, hPz, hzP]
    have h1 : y * z = zt * y := by
      calc y * z = y * (E o o * zt * E o o) := by rw [hPzP]
        _ = (y * E o o) * zt * E o o := by simp only [mul_assoc]
        _ = y * zt * E o o := by rw [hr]
        _ = zt * y * E o o := by rw [← hyzt]
        _ = zt * (y * E o o) := by rw [mul_assoc]
        _ = zt * y := by rw [hr]
    have h2 : z * y = zt * y := by
      calc z * y = (E o o * zt * E o o) * y := by rw [hPzP]
        _ = E o o * zt * (E o o * y) := by simp only [mul_assoc]
        _ = E o o * (zt * y) := by rw [hl, mul_assoc]
        _ = E o o * (y * zt) := by rw [hyzt]
        _ = (E o o * y) * zt := by rw [mul_assoc]
        _ = y * zt := by rw [hl]
        _ = zt * y := hyzt.symm
    rw [h1, h2]
  by_cases hP0 : E o o = 0
  · refine ⟨0, ?_⟩
    rw [zero_smul, ← hl, hP0, zero_mul]
  · obtain ⟨u₀, hu₀⟩ : ∃ u, E o o u ≠ 0 := by
      by_contra h
      apply hP0
      ext v
      by_contra hv
      exact h ⟨v, hv⟩
    have hξξ : (inner ℂ (E o o u₀) (E o o u₀) : ℂ) ≠ 0 := inner_self_ne_zero.mpr hu₀
    refine ⟨inner ℂ (E o o u₀) (y (E o o u₀)) / inner ℂ (E o o u₀) (E o o u₀), ?_⟩
    ext w
    have h := congrArg (fun T : H →L[ℂ] H => T (E o o u₀)) (hcomm w u₀)
    simp only [mul_apply_eq_comp, InnerProductSpace.rankOne_apply, map_smul] at h
    calc y w = y (E o o w) := by rw [← mul_apply_eq_comp, hr]
      _ = (inner ℂ (E o o u₀) (E o o u₀))⁻¹ •
            (inner ℂ (E o o u₀) (E o o u₀) • y (E o o w)) := (inv_smul_smul₀ hξξ _).symm
      _ = (inner ℂ (E o o u₀) (E o o u₀))⁻¹ •
            (inner ℂ (E o o u₀) (y (E o o u₀)) • E o o w) := by rw [h]
      _ = (inner ℂ (E o o u₀) (y (E o o u₀)) / inner ℂ (E o o u₀) (E o o u₀)) • E o o w := by
          rw [smul_smul, div_eq_inv_mul]
      _ = ((inner ℂ (E o o u₀) (y (E o o u₀)) / inner ℂ (E o o u₀) (E o o u₀)) • E o o) w :=
          rfl

/-- **The von Neumann algebra generated by matrix units is their linear span.** -/
lemma exists_muFun_eq (hE : IsMatrixUnits E) {x : H →L[ℂ] H}
    (hx : x ∈ generated (Set.range fun ij : ι × ι => E ij.1 ij.2)) : ∃ M, muFun E M = x := by
  rcases isEmpty_or_nonempty ι with hι | ⟨⟨o⟩⟩
  · refine ⟨0, ?_⟩
    have h10 : (1 : H →L[ℂ] H) = 0 := by
      rw [← hE.sum_eq]
      exact Finset.sum_of_isEmpty _
    rw [muFun_zero, ← mul_one x, h10, mul_zero]
  · have hmem : ∀ i j, E i j ∈ generated (Set.range fun ij : ι × ι => E ij.1 ij.2) :=
      fun i j => mem_generated_of_mem ⟨(i, j), rfl⟩
    have hc : ∀ i j, ∃ c : ℂ, E o i * x * E j o = c • E o o := by
      intro i j
      refine corner_smul hE o (mul_mem (mul_mem (hmem o i) hx) (hmem j o)) ?_ ?_
      · rw [← mul_assoc, ← mul_assoc, hE.mul_eq, ite_eq_left rfl]
      · rw [mul_assoc, hE.mul_eq, ite_eq_left rfl]
    choose c hc using hc
    have hterm : ∀ i j, E i i * x * E j j = c i j • E i j := by
      intro i j
      have hii : E i i = E i o * E o i := by rw [hE.mul_eq, ite_eq_left rfl]
      have hjj : E j j = E j o * E o j := by rw [hE.mul_eq, ite_eq_left rfl]
      calc E i i * x * E j j = E i o * (E o i * x * E j o) * E o j := by
            rw [hii, hjj]
            simp only [mul_assoc]
        _ = E i o * (c i j • E o o) * E o j := by rw [hc i j]
        _ = c i j • (E i o * E o o * E o j) := by rw [mul_smul_comm, smul_mul_assoc]
        _ = c i j • E i j := by rw [hE.mul_eq, ite_eq_left rfl, hE.mul_eq, ite_eq_left rfl]
    have hx1 : x = ∑ i, ∑ j, E i i * x * E j j := by
      calc x = (∑ i, E i i) * x * (∑ j, E j j) := by rw [hE.sum_eq, one_mul, mul_one]
        _ = ∑ i, ∑ j, E i i * x * E j j := by
          rw [Finset.sum_mul, Finset.sum_mul]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [Finset.mul_sum]
    refine ⟨Matrix.of c, ?_⟩
    calc muFun E (Matrix.of c) = ∑ i, ∑ j, c i j • E i j := rfl
      _ = ∑ i, ∑ j, E i i * x * E j j := by simp only [hterm]
      _ = x := hx1.symm

/-- `M ↦ ∑ M i j • E i j` as a unital `⋆`-homomorphism. -/
def IsMatrixUnits.toHom (hE : IsMatrixUnits E) : Matrix ι ι ℂ →⋆ₐ[ℂ] (H →L[ℂ] H) where
  toFun := muFun E
  map_one' := muFun_one hE
  map_mul' := muFun_mul hE
  map_zero' := muFun_zero
  map_add' := muFun_add
  commutes' r := by
    rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, muFun_smul]
    exact congrArg (r • ·) (muFun_one hE)
  map_star' M := muFun_star hE M

/-- Matrix units with nonzero entries identify `M_ι(ℂ)` with the von Neumann algebra they
generate. -/
def IsMatrixUnits.starAlgEquiv (hE : IsMatrixUnits E) (hE0 : ∀ k l, E k l ≠ 0) :
    Matrix ι ι ℂ ≃⋆ₐ[ℂ]
      (generated (Set.range fun ij : ι × ι => E ij.1 ij.2)).toStarSubalgebra :=
  StarAlgEquiv.ofBijective (hE.toHom.codRestrict _ fun M => muFun_mem M)
    ⟨fun _ _ h => muFun_injective hE hE0 (congrArg Subtype.val h),
     fun ⟨_, hx⟩ => let ⟨M, hM⟩ := exists_muFun_eq hE hx; ⟨M, Subtype.ext hM⟩⟩

/-- A matrix-unit subfactor is `⋆`-isomorphic to `B(ℂ^d)`. -/
lemma IsMUSubfactor.nonempty_starAlgEquiv {F : VonNeumannAlgebra H} {d : ℕ}
    (h : IsMUSubfactor F d) (hH : Nontrivial H ∨ d = 0) :
    Nonempty (F ≃⋆ₐ[ℂ] (EuclideanSpace ℂ (Fin d) →L[ℂ] EuclideanSpace ℂ (Fin d))) := by
  obtain ⟨E, hE, rfl⟩ := h
  have hE0 : ∀ k l, E k l ≠ 0 := by
    rcases hH with hH | rfl
    · exact hE.ne_zero
    · intro k
      exact k.elim0
  exact ⟨(hE.starAlgEquiv hE0).symm.trans Matrix.toEuclideanCLM⟩

end MatrixIso

/-! ### Resolutions of the identity -/

section Resolution

variable {ι : Type*} (P : ι → (H →L[ℂ] H)) (hres : ∀ y, HasSum (fun r => P r y) y)
include hres

omit [CompleteSpace H] in
/-- An operator killed by every member of a strong resolution of the identity is zero. -/
lemma eq_zero_of_forall_proj_mul {w : H →L[ℂ] H} (h : ∀ r, P r * w = 0) : w = 0 := by
  ext y
  have h1 : (fun r => P r (w y)) = fun _ => (0 : H) := funext fun r => by
    rw [← mul_apply_eq_comp, h r, zero_apply]
  have h2 := hres (w y)
  rw [h1] at h2
  rw [zero_apply]
  exact h2.unique hasSum_zero

omit [CompleteSpace H] in
/-- If `b` commutes with every sandwich `P p * a * P q`, then `b` commutes with `a`
(the library's argument in `OrthEquivFam.commutes_of_mem_centralizer`, for a general strong
resolution of the identity). -/
lemma commute_of_forall_sandwich {a b : H →L[ℂ] H}
    (h : ∀ p q, (P p * a * P q) * b = b * (P p * a * P q)) : a * b = b * a := by
  apply ContinuousLinearMap.ext
  intro y
  apply ext_inner_left ℂ
  intro x
  have step : ∀ r, inner ℂ x ((a * P r * b) y) = inner ℂ x ((b * a * P r) y) := by
    intro r
    have hLp : HasSum (fun p => inner ℂ x ((P p * a * P r * b) y))
        (inner ℂ x ((a * P r * b) y)) := by
      have h1 := (hres ((a * P r * b) y)).mapL (innerSL ℂ x)
      simpa only [innerSL_apply_apply, mul_apply_eq_comp] using h1
    have hRp : HasSum (fun p => inner ℂ x ((b * P p * a * P r) y))
        (inner ℂ x ((b * a * P r) y)) := by
      have h1 := ((hres ((a * P r) y)).mapL b).mapL (innerSL ℂ x)
      simpa only [innerSL_apply_apply, mul_apply_eq_comp] using h1
    have hfun : (fun p => inner ℂ x ((P p * a * P r * b) y))
        = (fun p => inner ℂ x ((b * P p * a * P r) y)) := by
      funext p
      have hkey : P p * a * P r * b = b * P p * a * P r := by
        rw [h p r, ← mul_assoc, ← mul_assoc]
      rw [hkey]
    rw [hfun] at hLp
    exact hLp.unique hRp
  have hL : HasSum (fun r => inner ℂ x ((a * P r * b) y)) (inner ℂ x ((a * b) y)) := by
    have h1 := ((hres (b y)).mapL a).mapL (innerSL ℂ x)
    simpa only [innerSL_apply_apply, mul_apply_eq_comp] using h1
  have hR : HasSum (fun r => inner ℂ x ((b * a * P r) y)) (inner ℂ x ((b * a) y)) := by
    have h1 := ((hres y).mapL (b * a)).mapL (innerSL ℂ x)
    simpa only [innerSL_apply_apply, mul_apply_eq_comp] using h1
  rw [funext step] at hL
  exact hL.unique hR

end Resolution

omit [CompleteSpace H] in
/-- **Commuting with matrix units.** Let `P p q` be matrix units whose diagonal is a strong
resolution of the identity, and let `T` satisfy `P r r T P p p = 0` for `r ≠ p` and
`P p p T P p q = P p q T P q q`. Then `T` commutes with every `P p q`. -/
lemma commute_matrixUnit_of {ι : Type*} [DecidableEq ι] (P : ι → ι → (H →L[ℂ] H))
    (hmul : ∀ p q r s, P p q * P r s = if q = r then P p s else 0)
    (hres : ∀ y, HasSum (fun r => P r r y) y) {T : H →L[ℂ] H}
    (h1 : ∀ r p, r ≠ p → P r r * T * P p p = 0)
    (h2 : ∀ p q, P p p * T * P p q = P p q * T * P q q) (p q : ι) :
    T * P p q = P p q * T := by
  have hpp : P p p * P p q = P p q := by rw [hmul, ite_eq_left rfl]
  have hqq : P p q * P q q = P p q := by rw [hmul, ite_eq_left rfl]
  have hL : T * P p q = P p p * T * P p q := by
    ext v
    have hsingle : HasSum (fun r => P r r ((T * P p q) v)) (P p p ((T * P p q) v)) := by
      refine hasSum_single p fun r hr => ?_
      have h0 : P r r * T * P p q = 0 := by
        calc P r r * T * P p q = (P r r * T * P p p) * P p q := by
              rw [mul_assoc _ (P p p), hpp]
          _ = 0 := by rw [h1 r p hr, zero_mul]
      calc P r r ((T * P p q) v) = (P r r * T * P p q) v := rfl
        _ = 0 := by rw [h0, zero_apply]
    calc (T * P p q) v = P p p ((T * P p q) v) := (hres _).unique hsingle
      _ = (P p p * T * P p q) v := rfl
  have hR : P p q * T = P p q * T * P q q := by
    ext v
    have hs := (hres v).mapL (P p q * T)
    have hsingle : HasSum (fun r => (P p q * T) (P r r v)) ((P p q * T) (P q q v)) := by
      refine hasSum_single q fun r hr => ?_
      have h0 : P p q * T * P r r = 0 := by
        calc P p q * T * P r r = (P p q * P q q) * T * P r r := by rw [hqq]
          _ = P p q * (P q q * T * P r r) := by simp only [mul_assoc]
          _ = 0 := by rw [h1 q r (Ne.symm hr), mul_zero]
      calc (P p q * T) (P r r v) = (P p q * T * P r r) v := rfl
        _ = 0 := by rw [h0, zero_apply]
    calc (P p q * T) v = (P p q * T) (P q q v) := hs.unique hsingle
      _ = (P p q * T * P q q) v := rfl
  rw [hL, h2, ← hR]

/-! ### `ℓ²` basis vectors and isometries induced by injections -/

section L2

variable {α β : Type*}

lemma inner_single_single [DecidableEq β] (a b : β) :
    inner ℂ (lp.single 2 a (1 : ℂ) : ℓ²(β, ℂ)) (lp.single 2 b (1 : ℂ)) =
      if a = b then 1 else 0 :=
  (orthonormal_iff_ite.mp (lp.orthonormal_single (𝕜 := ℂ) (ι := β))) a b

lemma single_one_injective [DecidableEq β] :
    Function.Injective (fun b : β => (lp.single 2 b (1 : ℂ) : ℓ²(β, ℂ))) :=
  (lp.orthonormal_single (𝕜 := ℂ) (ι := β)).linearIndependent.injective

/-- Vectors of `ℓ²(β)` with the same coordinates are equal. -/
lemma l2_vec_ext [DecidableEq β] {u v : ℓ²(β, ℂ)}
    (h : ∀ b, inner ℂ (lp.single 2 b (1 : ℂ) : ℓ²(β, ℂ)) u =
      inner ℂ (lp.single 2 b (1 : ℂ) : ℓ²(β, ℂ)) v) : u = v := by
  ext b
  have hb := h b
  rw [lp.inner_single_left, lp.inner_single_left] at hb
  simpa [RCLike.inner_apply] using hb

/-- Operators on `ℓ²(β)` agreeing on the standard basis are equal. -/
lemma l2_clm_ext [DecidableEq β] {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {A B : ℓ²(β, ℂ) →L[ℂ] E}
    (h : ∀ b, A (lp.single 2 b (1 : ℂ)) = B (lp.single 2 b (1 : ℂ))) : A = B :=
  ContinuousLinearMap.ext_on lp.dense_span_single (by rintro _ ⟨b, rfl⟩; exact h b)

/-- `c ↦ c • δ_b`, a linear isometry `ℂ → ℓ²(β)`. -/
def singleLI [DecidableEq β] (b : β) : ℂ →ₗᵢ[ℂ] ℓ²(β, ℂ) where
  toFun c := c • lp.single 2 b (1 : ℂ)
  map_add' c c' := add_smul c c' _
  map_smul' c c' := by simp only [smul_eq_mul, RingHom.id_apply, mul_smul]
  norm_map' c := by
    simp only [LinearMap.coe_mk, AddHom.coe_mk]
    rw [norm_smul, lp.norm_single (p := 2) (by norm_num), norm_one, mul_one]

lemma orthogonalFamily_singleLI [DecidableEq β] (φ : α → β) (hφ : Function.Injective φ) :
    OrthogonalFamily ℂ (fun _ : α => ℂ) (fun a => singleLI (φ a)) := by
  intro a a' haa' c c'
  show inner ℂ (c • (lp.single 2 (φ a) (1 : ℂ) : ℓ²(β, ℂ)))
    (c' • (lp.single 2 (φ a') (1 : ℂ) : ℓ²(β, ℂ))) = 0
  rw [inner_smul_left, inner_smul_right, inner_single_single, ite_eq_right (hφ.ne haa'),
    mul_zero, mul_zero]

/-- The isometry `ℓ²(α) → ℓ²(β)`, `δ_a ↦ δ_{φ a}`, of an injective map `φ`. -/
def l2Embed [DecidableEq β] (φ : α → β) (hφ : Function.Injective φ) :
    ℓ²(α, ℂ) →L[ℂ] ℓ²(β, ℂ) :=
  (orthogonalFamily_singleLI φ hφ).linearIsometry.toContinuousLinearMap

lemma l2Embed_single [DecidableEq α] [DecidableEq β] (φ : α → β) (hφ : Function.Injective φ)
    (a : α) : l2Embed φ hφ (lp.single 2 a (1 : ℂ)) = lp.single 2 (φ a) (1 : ℂ) := by
  show (orthogonalFamily_singleLI φ hφ).linearIsometry (lp.single 2 a 1) = _
  rw [OrthogonalFamily.linearIsometry_apply_single]
  exact one_smul ℂ _

lemma l2Embed_adjoint_single [DecidableEq α] [DecidableEq β] (φ : α → β)
    (hφ : Function.Injective φ) (a : α) :
    ContinuousLinearMap.adjoint (l2Embed φ hφ) (lp.single 2 (φ a) (1 : ℂ)) =
      lp.single 2 a (1 : ℂ) := by
  refine l2_vec_ext fun c => ?_
  rw [ContinuousLinearMap.adjoint_inner_right, l2Embed_single, inner_single_single,
    inner_single_single]
  by_cases h : c = a
  · subst h
    simp
  · rw [ite_eq_right (hφ.ne h), ite_eq_right h]

lemma l2Embed_adjoint_single_eq_zero [DecidableEq α] [DecidableEq β] (φ : α → β)
    (hφ : Function.Injective φ) (b : β) (hb : ∀ a, φ a ≠ b) :
    ContinuousLinearMap.adjoint (l2Embed φ hφ) (lp.single 2 b (1 : ℂ)) = 0 := by
  refine l2_vec_ext fun c => ?_
  rw [ContinuousLinearMap.adjoint_inner_right, l2Embed_single, inner_single_single,
    ite_eq_right (hb c), inner_zero_right]

end L2

/-! ### Binary words and Cuntz pairs in a `⋆`-ring -/

section Words

variable {A : Type*} [Ring A] (s : Fin 2 → A)

/-- The product `s_{w 0} s_{w 1} ⋯ s_{w (n-1)}` along a binary word `w` of length `n`. -/
def cuntzWord : (n : ℕ) → (Fin n → Fin 2) → A
  | 0, _ => 1
  | n + 1, w => cuntzWord n (Fin.init w) * s (w (Fin.last n))

lemma cuntzWord_succ {n : ℕ} (w : Fin (n + 1) → Fin 2) :
    cuntzWord s (n + 1) w = cuntzWord s n (Fin.init w) * s (w (Fin.last n)) := rfl

lemma cuntzWord_snoc {n : ℕ} (w : Fin n → Fin 2) (i : Fin 2) :
    cuntzWord s (n + 1) (Fin.snoc w i : Fin (n + 1) → Fin 2) = cuntzWord s n w * s i := by
  rw [cuntzWord_succ, Fin.init_snoc, Fin.snoc_last]

end Words

/-- The bijection `(w, i) ↦ w i` (append a letter) between binary words. -/
def snocEquiv2 (n : ℕ) : (Fin n → Fin 2) × Fin 2 ≃ (Fin (n + 1) → Fin 2) where
  toFun p := Fin.snoc p.1 p.2
  invFun w := (Fin.init w, w (Fin.last n))
  left_inv p := by simp
  right_inv w := Fin.snoc_init_self w

section Cuntz

variable {A : Type*} [Ring A] [StarRing A]

/-- A **Cuntz pair**: two isometries with orthogonal ranges summing to the identity. -/
structure IsCuntzPair (s : Fin 2 → A) : Prop where
  star_mul : ∀ i j, star (s i) * s j = if i = j then 1 else 0
  sum_mul_star : ∑ i, s i * star (s i) = 1

namespace IsCuntzPair

variable {s : Fin 2 → A}

lemma star_word_mul_word (hs : IsCuntzPair s) (n : ℕ) : ∀ w w' : Fin n → Fin 2,
    star (cuntzWord s n w) * cuntzWord s n w' = if w = w' then 1 else 0 := by
  induction n with
  | zero =>
    intro w w'
    have : w = w' := Subsingleton.elim _ _
    change star (1 : A) * (1 : A) = _
    simp [this]
  | succ n ih =>
    intro w w'
    have key : star (cuntzWord s (n + 1) w) * cuntzWord s (n + 1) w' =
        star (s (w (Fin.last n))) *
          (star (cuntzWord s n (Fin.init w)) * cuntzWord s n (Fin.init w')) *
            s (w' (Fin.last n)) := by
      rw [cuntzWord_succ s w, cuntzWord_succ s w', StarMul.star_mul]
      simp only [mul_assoc]
    rw [key, ih]
    by_cases hinit : Fin.init w = Fin.init w'
    · rw [ite_eq_left hinit, mul_one, hs.star_mul]
      by_cases hl : w (Fin.last n) = w' (Fin.last n)
      · rw [ite_eq_left hl, ite_eq_left]
        calc w = Fin.snoc (Fin.init w) (w (Fin.last n)) := (Fin.snoc_init_self w).symm
          _ = Fin.snoc (Fin.init w') (w' (Fin.last n)) := by rw [hinit, hl]
          _ = w' := Fin.snoc_init_self w'
      · rw [ite_eq_right hl, ite_eq_right]
        intro h
        exact hl (congrFun h _)
    · rw [ite_eq_right hinit, mul_zero, zero_mul, ite_eq_right]
      intro h
      exact hinit (congrArg Fin.init h)

lemma star_word_mul_self (hs : IsCuntzPair s) {n : ℕ} (w : Fin n → Fin 2) :
    star (cuntzWord s n w) * cuntzWord s n w = 1 := by
  rw [hs.star_word_mul_word, ite_eq_left rfl]

lemma sum_word (hs : IsCuntzPair s) : ∀ n : ℕ,
    ∑ w : Fin n → Fin 2, cuntzWord s n w * star (cuntzWord s n w) = 1
  | 0 => by
    rw [Fintype.sum_unique]
    change (1 : A) * star (1 : A) = 1
    simp
  | n + 1 => by
    have happ : ∀ p : (Fin n → Fin 2) × Fin 2,
        snocEquiv2 n p = (Fin.snoc p.1 p.2 : Fin (n + 1) → Fin 2) := fun _ => rfl
    rw [← (snocEquiv2 n).sum_comp, Fintype.sum_prod_type]
    simp only [happ, cuntzWord_snoc, StarMul.star_mul]
    calc ∑ w : Fin n → Fin 2, ∑ i, cuntzWord s n w * s i * (star (s i) * star (cuntzWord s n w))
        = ∑ w : Fin n → Fin 2, cuntzWord s n w * (∑ i, s i * star (s i)) *
            star (cuntzWord s n w) := by
          refine Finset.sum_congr rfl fun w _ => ?_
          rw [Finset.mul_sum, Finset.sum_mul]
          refine Finset.sum_congr rfl fun i _ => ?_
          simp only [mul_assoc]
      _ = 1 := by
          simp only [hs.sum_mul_star, mul_one]
          exact hs.sum_word n

/-- Level-`n` matrix units refine into level-`n + 1` ones. -/
lemma word_refine (hs : IsCuntzPair s) {n : ℕ} (w w' : Fin n → Fin 2) :
    cuntzWord s n w * star (cuntzWord s n w') =
      ∑ i, cuntzWord s (n + 1) (Fin.snoc w i : Fin (n + 1) → Fin 2) *
        star (cuntzWord s (n + 1) (Fin.snoc w' i : Fin (n + 1) → Fin 2)) := by
  simp only [cuntzWord_snoc, StarMul.star_mul]
  calc cuntzWord s n w * star (cuntzWord s n w')
      = cuntzWord s n w * (∑ i, s i * star (s i)) * star (cuntzWord s n w') := by
        rw [hs.sum_mul_star, mul_one]
    _ = ∑ i, cuntzWord s n w * s i * (star (s i) * star (cuntzWord s n w')) := by
        rw [Finset.mul_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl fun i _ => ?_
        simp only [mul_assoc]

/-- The words of length `n` give `2ⁿ × 2ⁿ` matrix units `s_w s_{w'}⋆`. -/
lemma isMatrixUnits (hs : IsCuntzPair s) (n : ℕ) :
    IsMatrixUnits (fun w w' : Fin n → Fin 2 => cuntzWord s n w * star (cuntzWord s n w')) where
  mul_eq w₁ w₂ w₃ w₄ := by
    show cuntzWord s n w₁ * star (cuntzWord s n w₂) * (cuntzWord s n w₃ * star (cuntzWord s n w₄))
      = if w₂ = w₃ then cuntzWord s n w₁ * star (cuntzWord s n w₄) else 0
    rw [show cuntzWord s n w₁ * star (cuntzWord s n w₂) *
        (cuntzWord s n w₃ * star (cuntzWord s n w₄)) =
        cuntzWord s n w₁ * (star (cuntzWord s n w₂) * cuntzWord s n w₃) *
          star (cuntzWord s n w₄) by simp only [mul_assoc], hs.star_word_mul_word]
    split_ifs <;> simp
  star_eq w w' := by
    show star (cuntzWord s n w * star (cuntzWord s n w')) =
      cuntzWord s n w' * star (cuntzWord s n w)
    rw [StarMul.star_mul, star_star]
  sum_eq := hs.sum_word n

end IsCuntzPair

end Cuntz

/-! ### The Cuntz pair `δ_c ↦ δ_{2c+i}` on `ℓ²(κ)`, `κ ≃ ℕ` -/

section CuntzL2

variable {κ : Type*} [DecidableEq κ] (σ : κ ≃ ℕ)

/-- The injection `p ↦ σ⁻¹(2 σ(p) + i)`. -/
def dbl (i : Fin 2) (p : κ) : κ := σ.symm (2 * σ p + (i : ℕ))

omit [DecidableEq κ] in
lemma dbl_eq_iff {i j : Fin 2} {p q : κ} : dbl σ i p = dbl σ j q ↔ i = j ∧ p = q := by
  constructor
  · intro h
    have h' : 2 * σ p + (i : ℕ) = 2 * σ q + (j : ℕ) := σ.symm.injective h
    have hi := i.isLt
    have hj := j.isLt
    have hij : (i : ℕ) = j := by omega
    exact ⟨Fin.ext hij, σ.injective (by omega)⟩
  · rintro ⟨rfl, rfl⟩
    rfl

omit [DecidableEq κ] in
lemma dbl_injective (i : Fin 2) : Function.Injective (dbl σ i) := fun _ _ h =>
  ((dbl_eq_iff σ).mp h).2

omit [DecidableEq κ] in
lemma exists_dbl_eq (q : κ) : ∃ i p, dbl σ i p = q :=
  ⟨⟨σ q % 2, Nat.mod_lt _ two_pos⟩, σ.symm (σ q / 2), by
    show σ.symm (2 * σ (σ.symm (σ q / 2)) + σ q % 2) = q
    rw [Equiv.apply_symm_apply, Nat.div_add_mod, Equiv.symm_apply_apply]⟩

/-- The Cuntz isometries `s_i δ_p = δ_{dbl i p}` on `ℓ²(κ)`. -/
def cuntzS (i : Fin 2) : ℓ²(κ, ℂ) →L[ℂ] ℓ²(κ, ℂ) := l2Embed (dbl σ i) (dbl_injective σ i)

lemma cuntzS_single (i : Fin 2) (p : κ) :
    cuntzS σ i (lp.single 2 p (1 : ℂ)) = lp.single 2 (dbl σ i p) (1 : ℂ) :=
  l2Embed_single _ _ p

lemma cuntzS_adjoint_single (i : Fin 2) (p : κ) :
    ContinuousLinearMap.adjoint (cuntzS σ i) (lp.single 2 (dbl σ i p) (1 : ℂ)) =
      lp.single 2 p (1 : ℂ) :=
  l2Embed_adjoint_single _ _ p

lemma cuntzS_adjoint_single_eq_zero (i : Fin 2) (q : κ) (hq : ∀ p, dbl σ i p ≠ q) :
    ContinuousLinearMap.adjoint (cuntzS σ i) (lp.single 2 q (1 : ℂ)) = 0 :=
  l2Embed_adjoint_single_eq_zero _ _ q hq

/-- `s_0, s_1` form a Cuntz pair. -/
lemma cuntzS_isCuntzPair : IsCuntzPair (cuntzS σ) where
  star_mul i j := by
    apply l2_clm_ext
    intro p
    rw [mul_apply_eq_comp, cuntzS_single, ContinuousLinearMap.star_eq_adjoint]
    split_ifs with hij
    · subst hij
      rw [cuntzS_adjoint_single, one_apply_eq_self]
    · rw [cuntzS_adjoint_single_eq_zero σ i _ (fun r h => hij ((dbl_eq_iff σ).mp h).1),
        zero_apply]
  sum_mul_star := by
    apply l2_clm_ext
    intro q
    obtain ⟨i₀, p₀, rfl⟩ := exists_dbl_eq σ q
    rw [sum_apply, one_apply_eq_self, Finset.sum_eq_single i₀]
    · rw [mul_apply_eq_comp, ContinuousLinearMap.star_eq_adjoint, cuntzS_adjoint_single,
        cuntzS_single]
    · intro i _ hi
      rw [mul_apply_eq_comp, ContinuousLinearMap.star_eq_adjoint,
        cuntzS_adjoint_single_eq_zero σ i _ (fun r h => hi ((dbl_eq_iff σ).mp h).1), map_zero]
    · intro h
      exact absurd (Finset.mem_univ i₀) h

/-- Every `δ_{σ⁻¹(a + 2ⁿ c)}` with `a < 2ⁿ` is reached from `δ_{σ⁻¹ c}` by a word of length
`n` (binary expansion of `a`, least significant digit first). -/
lemma exists_word_single (n : ℕ) : ∀ a < 2 ^ n, ∀ c : ℕ, ∃ w : Fin n → Fin 2,
    cuntzWord (cuntzS σ) n w (lp.single 2 (σ.symm c) (1 : ℂ)) =
      lp.single 2 (σ.symm (a + 2 ^ n * c)) (1 : ℂ) := by
  induction n with
  | zero =>
    intro a ha c
    have ha0 : a = 0 := by simpa using ha
    subst ha0
    exact ⟨Fin.elim0, by
      change (1 : ℓ²(κ, ℂ) →L[ℂ] ℓ²(κ, ℂ)) (lp.single 2 (σ.symm c) (1 : ℂ)) = _
      simp⟩
  | succ n ih =>
    intro a ha c
    have hpos : 0 < 2 ^ n := by positivity
    have hi : a / 2 ^ n < 2 := by
      rw [Nat.div_lt_iff_lt_mul hpos]
      calc a < 2 ^ (n + 1) := ha
        _ = 2 * 2 ^ n := by ring
    obtain ⟨w', hw'⟩ := ih (a % 2 ^ n) (Nat.mod_lt _ hpos) (2 * c + a / 2 ^ n)
    refine ⟨Fin.snoc w' ⟨a / 2 ^ n, hi⟩, ?_⟩
    have hdbl : dbl σ ⟨a / 2 ^ n, hi⟩ (σ.symm c) = σ.symm (2 * c + a / 2 ^ n) := by
      show σ.symm (2 * σ (σ.symm c) + a / 2 ^ n) = _
      rw [Equiv.apply_symm_apply]
    have harith : a % 2 ^ n + 2 ^ n * (2 * c + a / 2 ^ n) = a + 2 ^ (n + 1) * c := by
      conv_rhs => rw [← Nat.mod_add_div a (2 ^ n)]
      ring
    rw [cuntzWord_snoc, mul_apply_eq_comp, cuntzS_single, hdbl, hw', harith]

/-- For `n ≥ σ p` some word of length `n` moves `δ_{σ⁻¹ 0}` to `δ_p`. -/
lemma exists_word_eq (p : κ) {n : ℕ} (hn : σ p ≤ n) :
    ∃ w : Fin n → Fin 2, cuntzWord (cuntzS σ) n w (lp.single 2 (σ.symm 0) (1 : ℂ)) =
      lp.single 2 p (1 : ℂ) := by
  obtain ⟨w, hw⟩ := exists_word_single σ n (σ p)
    (lt_of_lt_of_le Nat.lt_two_pow_self (Nat.pow_le_pow_right two_pos hn)) 0
  exact ⟨w, by rw [hw, mul_zero, add_zero, Equiv.symm_apply_apply]⟩

end CuntzL2

/-! ### Rank-one operators against isometries -/

section RankOne

variable {L : Type*} [NormedAddCommGroup L] [InnerProductSpace ℂ L] [CompleteSpace L]

lemma word_mul_rankOne {V W : L →L[ℂ] L} (hW : star W * W = 1) (x : L) :
    V * star W * InnerProductSpace.rankOne ℂ (W x) (W x) =
      InnerProductSpace.rankOne ℂ (V x) (W x) := by
  have h : (V * star W) (W x) = V x := by
    show V ((star W * W) x) = V x
    rw [hW, one_apply_eq_self]
  rw [ContinuousLinearMap.mul_def, InnerProductSpace.comp_rankOne, h]

lemma rankOne_mul_word {V W : L →L[ℂ] L} (hV : star V * V = 1) (x : L) :
    InnerProductSpace.rankOne ℂ (V x) (V x) * (V * star W) =
      InnerProductSpace.rankOne ℂ (V x) (W x) := by
  have h : ContinuousLinearMap.adjoint (V * star W) (V x) = W x := by
    rw [← ContinuousLinearMap.star_eq_adjoint, star_mul, star_star]
    show W ((star V * V) x) = W x
    rw [hV, one_apply_eq_self]
  rw [ContinuousLinearMap.mul_def, InnerProductSpace.rankOne_comp, h]

end RankOne

/-! ### Spatial transport `x ↦ U⋆ (x ⊗ 1) U` and the lift `y ↦ U⋆ (1 ⊗ ι⋆ U y U⋆ ι) U` -/

section Spatial

variable {L K : Type*} [NormedAddCommGroup L] [InnerProductSpace ℂ L] [CompleteSpace L]
  [NormedAddCommGroup K] [InnerProductSpace ℂ K]

/-- `x ↦ U⋆ (x ⊗ 1) U`, a unital `⋆`-homomorphism `B(L) → B(H)`. -/
def ampConj (U : H ≃ₗᵢ[ℂ] HilbertTensor L K) : (L →L[ℂ] L) →⋆ₐ[ℂ] (H →L[ℂ] H) :=
  U.conjStarAlgEquiv.symm.toStarAlgHom.comp (amplifyLeftₐ (H₁ := L) (H₂ := K))

lemma ampConj_apply (U : H ≃ₗᵢ[ℂ] HilbertTensor L K) (x : L →L[ℂ] L) :
    ampConj U x = U.conjStarAlgEquiv.symm (amplifyLeft (H₂ := K) x) := rfl

lemma ampConj_mem {N : VonNeumannAlgebra H} (U : H ≃ₗᵢ[ℂ] HilbertTensor L K)
    (hU : conj U N = tensorOne (boundedLinearOperators L) K) (x : L →L[ℂ] L) :
    ampConj U x ∈ N := by
  rw [ampConj_apply, ← mem_conj_iff, hU]
  exact amplifyLeft_mem_tensorOne (mem_boundedLinearOperators x)

variable [CompleteSpace K]

omit [CompleteSpace L] [CompleteSpace H] [CompleteSpace K] in
lemma amplifyRight_comp_tmulRightL (B : K →L[ℂ] K) (f : L) :
    (amplifyRight (H₁ := L) B).comp (tmulRightL f) = (tmulRightL f).comp B := by
  ext z
  simp only [ContinuousLinearMap.comp_apply, tmulRightL_apply, amplifyRight_tmul]

omit [CompleteSpace L] [CompleteSpace H] in
lemma adjoint_tmulRightL_comp_amplifyRight (B : K →L[ℂ] K) (f : L) :
    (ContinuousLinearMap.adjoint (tmulRightL (H₂ := K) f)).comp (amplifyRight (H₁ := L) B) =
      B.comp (ContinuousLinearMap.adjoint (tmulRightL f)) := by
  apply ContinuousLinearMap.adjoint.injective
  rw [ContinuousLinearMap.adjoint_comp, ContinuousLinearMap.adjoint_comp,
    ContinuousLinearMap.adjoint_adjoint, amplifyRight_adjoint, amplifyRight_comp_tmulRightL]

/-- The lift `y ↦ U⋆ (1 ⊗ ι_f⋆ (U y U⋆) ι_f) U`, `ι_f = f ⊗ (·)`. -/
def liftOp (U : H ≃ₗᵢ[ℂ] HilbertTensor L K) (f : L) (y : H →L[ℂ] H) : H →L[ℂ] H :=
  U.conjStarAlgEquiv.symm (amplifyRight (H₁ := L)
    ((ContinuousLinearMap.adjoint (tmulRightL (H₂ := K) f)).comp
      ((U.conjStarAlgEquiv y).comp (tmulRightL f))))

omit [CompleteSpace L] in
lemma liftOp_mem {M : VonNeumannAlgebra H} (U : H ≃ₗᵢ[ℂ] HilbertTensor L K) (f : L)
    (hU : conj U M = oneTensor L (boundedLinearOperators K)) (y : H →L[ℂ] H) :
    liftOp U f y ∈ M := by
  rw [liftOp, ← mem_conj_iff, hU]
  exact amplifyRight_mem_oneTensor (mem_boundedLinearOperators _)

omit [CompleteSpace L] in
/-- If `U P U⋆ = ι_f ι_f⋆` and `P y P = y`, then `P (liftOp y) = y`. -/
lemma mul_liftOp (U : H ≃ₗᵢ[ℂ] HilbertTensor L K) (f : L) {P y : H →L[ℂ] H}
    (hP : U.conjStarAlgEquiv P =
      (tmulRightL (H₂ := K) f).comp (ContinuousLinearMap.adjoint (tmulRightL f)))
    (hy : P * y * P = y) : P * liftOp U f y = y := by
  apply EquivLike.injective U.conjStarAlgEquiv
  rw [map_mul U.conjStarAlgEquiv, liftOp, StarAlgEquiv.apply_symm_apply, hP]
  conv_rhs => rw [← hy, map_mul U.conjStarAlgEquiv, map_mul U.conjStarAlgEquiv, hP]
  simp only [ContinuousLinearMap.mul_def, ContinuousLinearMap.comp_assoc]
  rw [adjoint_tmulRightL_comp_amplifyRight]
  simp only [ContinuousLinearMap.comp_assoc]

end Spatial

/-! ### The relative commutant -/

/-- The relative commutant `A′ ∩ B`, as a von Neumann algebra. -/
def relCommutant (A B : VonNeumannAlgebra H) : VonNeumannAlgebra H :=
  commutantSet ((A : Set (H →L[ℂ] H)) ∪ (B.commutant : Set (H →L[ℂ] H)))

lemma mem_relCommutant_iff {A B : VonNeumannAlgebra H} {z : H →L[ℂ] H} :
    z ∈ relCommutant A B ↔ z ∈ A.commutant ∧ z ∈ B := by
  rw [relCommutant, mem_commutantSet_iff]
  constructor
  · intro h
    refine ⟨mem_commutant_iff.mpr fun g hg => (h g (Or.inl hg)).1, ?_⟩
    rw [← commutant_commutant B, mem_commutant_iff]
    exact fun g hg => (h g (Or.inr hg)).1
  · rintro ⟨hA, hB⟩ g hg
    rw [← commutant_commutant B] at hB
    rcases hg with hg | hg
    · have hg' : g ∈ A := hg
      exact ⟨mem_commutant_iff.mp hA g hg', mem_commutant_iff.mp hA _ (star_mem hg')⟩
    · have hg' : g ∈ B.commutant := hg
      exact ⟨mem_commutant_iff.mp hB g hg', mem_commutant_iff.mp hB _ (star_mem hg')⟩

/-! ### Countability -/

/-- An orthonormal family in a separable Hilbert space is countable. -/
lemma countable_of_orthonormal {ι E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [TopologicalSpace.SeparableSpace E] {v : ι → E} (hv : Orthonormal ℂ v) : Countable ι := by
  refine Pairwise.countable_of_isOpen_disjoint (s := fun i => Metric.ball (v i) (1 / 2)) ?_
    (fun _ => Metric.isOpen_ball) (fun i => ⟨v i, Metric.mem_ball_self (by norm_num)⟩)
  intro i j hij
  show Disjoint (Metric.ball (v i) (1 / 2)) (Metric.ball (v j) (1 / 2))
  refine Set.disjoint_left.mpr fun x hxi hxj => ?_
  rw [Metric.mem_ball, dist_eq_norm] at hxi hxj
  have hsq : ‖v i - v j‖ ^ 2 = 2 := by
    rw [norm_sub_sq (𝕜 := ℂ), hv.1 i, hv.1 j, hv.2 hij]
    norm_num
  have hlt : ‖v i - v j‖ < 1 := by
    calc ‖v i - v j‖ = ‖(x - v j) - (x - v i)‖ := by congr 1; abel
      _ ≤ ‖x - v j‖ + ‖x - v i‖ := norm_sub_le _ _
      _ < 1 / 2 + 1 / 2 := add_lt_add hxj hxi
      _ = 1 := by norm_num
  nlinarith [norm_nonneg (v i - v j)]

/-! ### Structure data of a type I factor -/

section TypeIDataSection

open scoped Classical

/-- A type I factor `X'` with the data of the library's structure theorem: a minimal projection
`e`, a covering family `F` of projections equivalent to `e` (with matrix units `e_{pq}`), and a
base index `r₀ ∈ F`. -/
structure TypeIData (X' : VonNeumannAlgebra H) where
  e : H →L[ℂ] H
  he : IsMinimalProjection X' e
  F : Set (H →L[ℂ] H)
  hF : OrthEquivFam X' e F
  htop : (⨆ f ∈ F, f.range).topologicalClosure = ⊤
  r₀ : F

lemma exists_typeIData [Nontrivial H] {X' : VonNeumannAlgebra H} (hX' : IsTypeIFactor X') :
    Nonempty (TypeIData X') := by
  obtain ⟨e, he⟩ := hX'.exists_isMinimalProjection
  obtain ⟨F, hF, htop⟩ := hX'.1.exists_orthEquivFam_top he
  have : Nonempty F := OrthEquivFam.nonempty_of_top htop
  exact ⟨⟨e, he, F, hF, htop, Classical.arbitrary F⟩⟩

namespace TypeIData

variable {X' : VonNeumannAlgebra H} (D : TypeIData X')

instance instCompleteSpaceRange : CompleteSpace D.e.range := D.he.1.completeSpace_range

/-- The library's spatial isomorphism `H ≃ ℓ²(F) ⊗̂ eH`. -/
def U : H ≃ₗᵢ[ℂ] HilbertTensor ℓ²(D.F, ℂ) D.e.range := D.hF.spatialEquiv D.htop

/-- The base projection `e_{r₀ r₀} = r₀`. -/
def P : H →L[ℂ] H := (D.r₀ : H →L[ℂ] H)

/-- The base vector `δ_{r₀}` of `ℓ²(F)`. -/
abbrev baseVec : ℓ²(D.F, ℂ) := lp.single 2 D.r₀ (1 : ℂ)

/-- The lift `y ↦ U⋆ (1 ⊗ ι⋆ (U y U⋆) ι) U`, `ι = δ_{r₀} ⊗ (·)`, into `X'′`. -/
def lift (y : H →L[ℂ] H) : H →L[ℂ] H := liftOp D.U D.baseVec y

lemma matrixUnit_diag (p : D.F) : D.hF.matrixUnit p p = (p : H →L[ℂ] H) := D.hF.pisom_range p

lemma matrixUnit_mul (p q r s : D.F) :
    D.hF.matrixUnit p q * D.hF.matrixUnit r s = if q = r then D.hF.matrixUnit p s else 0 := by
  split_ifs with h
  · subst h
    exact D.hF.matrixUnit_mul_of_eq p q s
  · exact D.hF.matrixUnit_mul_of_ne p s h

lemma matrixUnit_star (p q : D.F) : star (D.hF.matrixUnit p q) = D.hF.matrixUnit q p := by
  rw [OrthEquivFam.matrixUnit_def, OrthEquivFam.matrixUnit_def, star_mul, star_star]

lemma hres (y : H) : HasSum (fun r : D.F => (r : H →L[ℂ] H) y) y := by
  simpa only [one_apply_eq_self] using
    PointwiseConvergenceCLM.hasSum_toSOT_iff.mp (D.hF.hasSum_resolutionOfIdentity D.htop) y

lemma hres' (y : H) : HasSum (fun r : D.F => D.hF.matrixUnit r r y) y := by
  simpa only [D.matrixUnit_diag] using D.hres y

lemma conj_eq : conj D.U X' = tensorOne (boundedLinearOperators ℓ²(D.F, ℂ)) D.e.range :=
  D.hF.conj_spatialEquiv_eq_tensorOne_boundedLinearOperators D.he D.htop

lemma conj_commutant :
    conj D.U X'.commutant = oneTensor ℓ²(D.F, ℂ) (boundedLinearOperators D.e.range) :=
  D.hF.conj_spatialEquiv_commutant_eq_oneTensor_boundedLinearOperators D.he D.htop

lemma ampConj_rankOne (p q : D.F) :
    ampConj D.U (InnerProductSpace.rankOne ℂ (lp.single 2 p (1 : ℂ) : ℓ²(D.F, ℂ))
      (lp.single 2 q (1 : ℂ))) = D.hF.matrixUnit p q := by
  rw [ampConj_apply, ← D.hF.conjStarAlgEquiv_matrixUnit D.htop p q]
  exact StarAlgEquiv.symm_apply_apply _ _

lemma ampConj_mem' (x : ℓ²(D.F, ℂ) →L[ℂ] ℓ²(D.F, ℂ)) : ampConj D.U x ∈ X' :=
  ampConj_mem D.U D.conj_eq x

lemma P_eq : D.P = D.hF.matrixUnit D.r₀ D.r₀ := (D.matrixUnit_diag D.r₀).symm

lemma P_mem : D.P ∈ X' := (D.hF.1 D.r₀.1 D.r₀.2).2.1

lemma P_proj : IsStarProjection D.P := (D.hF.1 D.r₀.1 D.r₀.2).1

lemma P_ne_zero : D.P ≠ 0 := (D.hF.1 D.r₀.1 D.r₀.2).2.2.1

lemma conj_matrixUnit_base : D.U.conjStarAlgEquiv (D.hF.matrixUnit D.r₀ D.r₀) =
    (tmulRightL (H₂ := D.e.range) D.baseVec).comp
      (ContinuousLinearMap.adjoint (tmulRightL D.baseVec)) := by
  have h1 := D.hF.conjStarAlgEquiv_matrixUnit D.htop D.r₀ D.r₀
  rw [amplifyLeft_rankOne_eq] at h1
  exact h1

lemma conj_P : D.U.conjStarAlgEquiv D.P =
    (tmulRightL (H₂ := D.e.range) D.baseVec).comp
      (ContinuousLinearMap.adjoint (tmulRightL D.baseVec)) := by
  rw [D.P_eq]
  exact D.conj_matrixUnit_base

lemma lift_mem_commutant (y : H →L[ℂ] H) : D.lift y ∈ X'.commutant :=
  liftOp_mem D.U D.baseVec D.conj_commutant y

lemma P_mul_lift {y : H →L[ℂ] H} (hy : D.P * y * D.P = y) : D.P * D.lift y = y :=
  mul_liftOp D.U D.baseVec D.conj_P hy

/-- An element of `X'′` killed by `e_{r₀ r₀}` vanishes. -/
lemma eq_zero_of_P_mul {w : H →L[ℂ] H} (hw : w ∈ X'.commutant) (h : D.P * w = 0) : w = 0 := by
  refine eq_zero_of_forall_proj_mul (fun r : D.F => (r : H →L[ℂ] H)) D.hres fun r => ?_
  have hc : D.hF.matrixUnit D.r₀ r * w = w * D.hF.matrixUnit D.r₀ r :=
    mem_commutant_iff.mp hw _ (D.hF.matrixUnit_mem D.r₀ r)
  calc (r : H →L[ℂ] H) * w = D.hF.matrixUnit r D.r₀ * (D.hF.matrixUnit D.r₀ r * w) := by
        rw [← mul_assoc, D.hF.matrixUnit_mul_of_eq, D.matrixUnit_diag]
    _ = D.hF.matrixUnit r D.r₀ * D.P * w * D.hF.matrixUnit D.r₀ r := by
        rw [hc, D.P_eq, D.hF.matrixUnit_mul_of_eq, mul_assoc]
    _ = 0 := by rw [mul_assoc (D.hF.matrixUnit r D.r₀), h, mul_zero, zero_mul]

section Relative

variable {X : VonNeumannAlgebra H}

/-- The lift of an element `y = e_{00} y e_{00}` of `X ⊇ X'` lies in `X`. -/
lemma lift_mem (hle : X' ≤ X) {y : H →L[ℂ] H} (hyX : y ∈ X) (hy : D.P * y * D.P = y) :
    D.lift y ∈ X := by
  rw [← commutant_commutant X, mem_commutant_iff]
  intro z hz
  have hz' : z ∈ X'.commutant := commutant_le hle hz
  have hzy : y * z = z * y := mem_commutant_iff.mp hz y hyX
  have hPz : D.P * z = z * D.P := mem_commutant_iff.mp hz' D.P D.P_mem
  have hL := D.lift_mem_commutant y
  have key : z * D.lift y - D.lift y * z = 0 := by
    refine D.eq_zero_of_P_mul (sub_mem (mul_mem hz' hL) (mul_mem hL hz')) ?_
    calc D.P * (z * D.lift y - D.lift y * z) = z * (D.P * D.lift y) - D.P * D.lift y * z := by
          rw [mul_sub, ← mul_assoc D.P z, hPz, mul_assoc z D.P, ← mul_assoc D.P (D.lift y) z]
      _ = 0 := by rw [D.P_mul_lift hy, hzy, sub_self]
  exact sub_eq_zero.mp key

include D in
/-- **Key lemma.** An operator commuting with `X'` and with the relative commutant `X'′ ∩ X`
commutes with `X`. -/
lemma mem_commutant_of_rel (hle : X' ≤ X) {T : H →L[ℂ] H} (hT1 : T ∈ X'.commutant)
    (hT2 : T ∈ (relCommutant X' X).commutant) : T ∈ X.commutant := by
  rw [mem_commutant_iff]
  intro x hx
  refine commute_of_forall_sandwich (fun r : D.F => (r : H →L[ℂ] H)) D.hres fun p q => ?_
  show (p : H →L[ℂ] H) * x * (q : H →L[ℂ] H) * T = T * ((p : H →L[ℂ] H) * x * (q : H →L[ℂ] H))
  obtain ⟨y, hydef⟩ : ∃ y, y = D.hF.matrixUnit D.r₀ p * x * D.hF.matrixUnit q D.r₀ := ⟨_, rfl⟩
  have hyX : y ∈ X := by
    rw [hydef]
    exact mul_mem (mul_mem (hle (D.hF.matrixUnit_mem _ _)) hx) (hle (D.hF.matrixUnit_mem _ _))
  have hy : D.P * y * D.P = y := by
    calc D.P * y * D.P
        = (D.P * D.hF.matrixUnit D.r₀ p) * x * (D.hF.matrixUnit q D.r₀ * D.P) := by
          rw [hydef]
          simp only [mul_assoc]
      _ = y := by rw [D.P_eq, D.hF.matrixUnit_mul_of_eq, D.hF.matrixUnit_mul_of_eq, hydef]
  have hpxq : (p : H →L[ℂ] H) * x * (q : H →L[ℂ] H) =
      D.hF.matrixUnit p D.r₀ * y * D.hF.matrixUnit D.r₀ q := by
    rw [hydef, ← D.matrixUnit_diag p, ← D.matrixUnit_diag q,
      ← D.hF.matrixUnit_mul_of_eq p D.r₀ p, ← D.hF.matrixUnit_mul_of_eq q D.r₀ q]
    simp only [mul_assoc]
  have hTy : y * T = T * y := by
    have hLS : D.lift y ∈ relCommutant X' X :=
      mem_relCommutant_iff.mpr ⟨D.lift_mem_commutant y, D.lift_mem hle hyX hy⟩
    have h1 : D.lift y * T = T * D.lift y := mem_commutant_iff.mp hT2 _ hLS
    have h2 : D.P * T = T * D.P := mem_commutant_iff.mp hT1 _ D.P_mem
    calc y * T = D.P * D.lift y * T := by rw [D.P_mul_lift hy]
      _ = D.P * (T * D.lift y) := by rw [mul_assoc, h1]
      _ = T * (D.P * D.lift y) := by rw [← mul_assoc, h2, mul_assoc]
      _ = T * y := by rw [D.P_mul_lift hy]
  have h3 : D.hF.matrixUnit p D.r₀ * T = T * D.hF.matrixUnit p D.r₀ :=
    mem_commutant_iff.mp hT1 _ (D.hF.matrixUnit_mem _ _)
  have h4 : D.hF.matrixUnit D.r₀ q * T = T * D.hF.matrixUnit D.r₀ q :=
    mem_commutant_iff.mp hT1 _ (D.hF.matrixUnit_mem _ _)
  rw [hpxq]
  calc D.hF.matrixUnit p D.r₀ * y * D.hF.matrixUnit D.r₀ q * T
      = D.hF.matrixUnit p D.r₀ * y * (D.hF.matrixUnit D.r₀ q * T) := by rw [mul_assoc]
    _ = D.hF.matrixUnit p D.r₀ * (y * T) * D.hF.matrixUnit D.r₀ q := by
        rw [h4]
        simp only [mul_assoc]
    _ = D.hF.matrixUnit p D.r₀ * T * y * D.hF.matrixUnit D.r₀ q := by
        rw [hTy]
        simp only [mul_assoc]
    _ = T * (D.hF.matrixUnit p D.r₀ * y * D.hF.matrixUnit D.r₀ q) := by
        rw [h3]
        simp only [mul_assoc]

/-- The lift of a minimal projection `g ≤ e_{00}` of `X` is a minimal projection of `X'′ ∩ X`. -/
lemma isMinimalProjection_lift (hle : X' ≤ X) {g : H →L[ℂ] H} (hg : IsMinimalProjection X g)
    (hgP : D.P * g * D.P = g) : IsMinimalProjection (relCommutant X' X) (D.lift g) := by
  have hL' : D.lift g ∈ X'.commutant := D.lift_mem_commutant g
  have hLX : D.lift g ∈ X := D.lift_mem hle hg.2.1 hgP
  have hPL : D.P * D.lift g = g := D.P_mul_lift hgP
  have hLP : D.lift g * D.P = D.P * D.lift g := (mem_commutant_iff.mp hL' D.P D.P_mem).symm
  have hPP : D.P * D.P = D.P := D.P_proj.isIdempotentElem.eq
  have hg_P : g * D.P = g := by
    calc g * D.P = D.P * g * D.P * D.P := by rw [hgP]
      _ = D.P * g * (D.P * D.P) := by simp only [mul_assoc]
      _ = g := by rw [hPP, hgP]
  refine ⟨⟨?_, ?_⟩, mem_relCommutant_iff.mpr ⟨hL', hLX⟩, ?_, ?_⟩
  · show D.lift g * D.lift g = D.lift g
    refine sub_eq_zero.mp (D.eq_zero_of_P_mul (sub_mem (mul_mem hL' hL') hL') ?_)
    rw [mul_sub, ← mul_assoc, hPL, sub_eq_zero]
    calc g * D.lift g = g * D.P * D.lift g := by rw [hg_P]
      _ = g * g := by rw [mul_assoc, hPL]
      _ = g := hg.1.isIdempotentElem.eq
  · show star (D.lift g) = D.lift g
    refine sub_eq_zero.mp (D.eq_zero_of_P_mul (sub_mem (star_mem hL') hL') ?_)
    rw [mul_sub, hPL, sub_eq_zero]
    calc D.P * star (D.lift g) = star (D.lift g * D.P) := by
          rw [star_mul, D.P_proj.isSelfAdjoint.star_eq]
      _ = star (D.P * D.lift g) := by rw [hLP]
      _ = g := by rw [hPL, hg.1.isSelfAdjoint.star_eq]
  · intro h0
    apply hg.2.2.1
    rw [← hPL, h0, mul_zero]
  · intro s hs
    obtain ⟨hs', hsX⟩ := mem_relCommutant_iff.mp hs
    obtain ⟨c, hc⟩ := hg.2.2.2 s hsX
    refine ⟨c, sub_eq_zero.mp (D.eq_zero_of_P_mul
      (sub_mem (mul_mem (mul_mem hL' hs') hL') (SMulMemClass.smul_mem c hL')) ?_)⟩
    have hPs : D.P * s = s * D.P := mem_commutant_iff.mp hs' D.P D.P_mem
    rw [mul_sub, mul_smul_comm, hPL, sub_eq_zero]
    calc D.P * (D.lift g * s * D.lift g) = D.P * D.lift g * s * D.lift g := by
          simp only [mul_assoc]
      _ = g * D.P * s * D.lift g := by rw [hPL, hg_P]
      _ = g * s * (D.P * D.lift g) := by
          rw [mul_assoc g D.P s, hPs]
          simp only [mul_assoc]
      _ = g * s * g := by rw [hPL]
      _ = c • g := hc

end Relative

/-! #### Part 1: the level subfactors -/

/-- Separability makes the covering family countable: `p ↦ v_p ξ` is orthonormal for a unit
vector `ξ ∈ eH`. -/
lemma countable [TopologicalSpace.SeparableSpace H] : Countable D.F := by
  obtain ⟨ξ, hξe, hξ1⟩ : ∃ ξ : H, D.e ξ = ξ ∧ ‖ξ‖ = 1 := by
    obtain ⟨x, hx⟩ : ∃ x, D.e x ≠ 0 := by
      by_contra h
      apply D.he.2.2.1
      ext y
      by_contra hy
      exact h ⟨y, hy⟩
    have hyy : D.e (D.e x) = D.e x := by
      rw [← mul_apply_eq_comp, D.he.1.isIdempotentElem.eq]
    refine ⟨(‖D.e x‖⁻¹ : ℂ) • D.e x, ?_, ?_⟩
    · rw [map_smul, hyy]
    · rw [norm_smul, norm_inv, Complex.norm_real, norm_norm,
        inv_mul_cancel₀ (norm_ne_zero_iff.mpr hx)]
  have hon : Orthonormal ℂ (fun p : D.F => D.hF.pisom p ξ) := by
    rw [orthonormal_iff_ite]
    intro p q
    rw [← ContinuousLinearMap.adjoint_inner_right, ← ContinuousLinearMap.star_eq_adjoint]
    by_cases hpq : p = q
    · subst hpq
      rw [ite_eq_left rfl]
      show inner ℂ ξ ((star (D.hF.pisom p) * D.hF.pisom p) ξ) = 1
      rw [D.hF.pisom_source p, hξe, inner_self_eq_norm_sq_to_K, hξ1]
      norm_num
    · rw [ite_eq_right hpq]
      show inner ℂ ξ ((star (D.hF.pisom p) * D.hF.pisom q) ξ) = 0
      rw [D.hF.star_pisom_mul_pisom_of_ne hpq, zero_apply, inner_zero_right]
  exact countable_of_orthonormal hon

/-- Finite multiplicity: the library matrix units exhibit `X'` as a matrix-unit subfactor. -/
lemma isMatrixUnits [Fintype D.F] : IsMatrixUnits (fun p q : D.F => D.hF.matrixUnit p q) where
  mul_eq := D.matrixUnit_mul
  star_eq := D.matrixUnit_star
  sum_eq := by
    ext y
    rw [sum_apply, one_apply_eq_self]
    simp only [D.matrixUnit_diag]
    exact ((D.hres y).unique (hasSum_fintype _)).symm

lemma isMUSubfactor [Fintype D.F] : IsMUSubfactor X' (Fintype.card D.F) :=
  IsMUSubfactorOf.isMUSubfactor
    ⟨fun p q => D.hF.matrixUnit p q, D.isMatrixUnits,
      (D.hF.generated_matrixUnits_eq D.he D.htop).symm⟩

/-- The level-`n` matrix units `U⋆ (s_w s_{w'}⋆ ⊗ 1) U` in `X'`. -/
def levelUnit (σ : D.F ≃ ℕ) (n : ℕ) (w w' : Fin n → Fin 2) : H →L[ℂ] H :=
  ampConj D.U (cuntzWord (cuntzS σ) n w * star (cuntzWord (cuntzS σ) n w'))

/-- The level-`n` unital matrix subfactor (`2ⁿ × 2ⁿ`). -/
def level (σ : D.F ≃ ℕ) (n : ℕ) : VonNeumannAlgebra H :=
  generated (Set.range fun ww : (Fin n → Fin 2) × (Fin n → Fin 2) => D.levelUnit σ n ww.1 ww.2)

variable (σ : D.F ≃ ℕ)

lemma levelUnit_isMatrixUnits (n : ℕ) : IsMatrixUnits (D.levelUnit σ n) :=
  ((cuntzS_isCuntzPair σ).isMatrixUnits n).map (ampConj D.U)

lemma level_isMUSubfactor (n : ℕ) :
    IsMUSubfactor (D.level σ n) (Fintype.card (Fin n → Fin 2)) :=
  IsMUSubfactorOf.isMUSubfactor ⟨D.levelUnit σ n, D.levelUnit_isMatrixUnits σ n, rfl⟩

lemma levelUnit_mem_level (n : ℕ) (w w' : Fin n → Fin 2) :
    D.levelUnit σ n w w' ∈ D.level σ n :=
  mem_generated_of_mem ⟨(w, w'), rfl⟩

lemma level_le (n : ℕ) : D.level σ n ≤ X' :=
  generated_le (by rintro _ ⟨⟨w, w'⟩, rfl⟩; exact D.ampConj_mem' _)

lemma levelUnit_refine {n : ℕ} (w w' : Fin n → Fin 2) :
    D.levelUnit σ n w w' =
      ∑ i, D.levelUnit σ (n + 1) (Fin.snoc w i) (Fin.snoc w' i) := by
  simp only [levelUnit]
  rw [(cuntzS_isCuntzPair σ).word_refine w w', map_sum (ampConj D.U)]

lemma level_mono : Monotone (D.level σ) := by
  refine monotone_nat_of_le_succ fun n => generated_le ?_
  rintro _ ⟨⟨w, w'⟩, rfl⟩
  show D.levelUnit σ n w w' ∈ D.level σ (n + 1)
  rw [D.levelUnit_refine σ w w']
  exact sum_mem fun i _ => D.levelUnit_mem_level σ (n + 1) _ _

lemma matrixUnit_mul_levelUnit {n : ℕ} {w w' : Fin n → Fin 2} {p q : D.F}
    (hw : cuntzWord (cuntzS σ) n w (lp.single 2 (σ.symm 0) (1 : ℂ)) = lp.single 2 p (1 : ℂ))
    (hw' : cuntzWord (cuntzS σ) n w' (lp.single 2 (σ.symm 0) (1 : ℂ)) =
      lp.single 2 q (1 : ℂ)) :
    D.hF.matrixUnit p p * D.levelUnit σ n w w' = D.hF.matrixUnit p q ∧
      D.levelUnit σ n w w' * D.hF.matrixUnit q q = D.hF.matrixUnit p q := by
  have hS := cuntzS_isCuntzPair σ
  have e1 : InnerProductSpace.rankOne ℂ (lp.single 2 p (1 : ℂ) : ℓ²(D.F, ℂ)) (lp.single 2 p 1) *
      (cuntzWord (cuntzS σ) n w * star (cuntzWord (cuntzS σ) n w')) =
      InnerProductSpace.rankOne ℂ (lp.single 2 p (1 : ℂ) : ℓ²(D.F, ℂ)) (lp.single 2 q 1) := by
    have h := rankOne_mul_word (W := cuntzWord (cuntzS σ) n w') (hS.star_word_mul_self w)
      (lp.single 2 (σ.symm 0) (1 : ℂ))
    simp only [hw, hw'] at h
    exact h
  have e2 : (cuntzWord (cuntzS σ) n w * star (cuntzWord (cuntzS σ) n w')) *
      InnerProductSpace.rankOne ℂ (lp.single 2 q (1 : ℂ) : ℓ²(D.F, ℂ)) (lp.single 2 q 1) =
      InnerProductSpace.rankOne ℂ (lp.single 2 p (1 : ℂ) : ℓ²(D.F, ℂ)) (lp.single 2 q 1) := by
    have h := word_mul_rankOne (V := cuntzWord (cuntzS σ) n w) (hS.star_word_mul_self w')
      (lp.single 2 (σ.symm 0) (1 : ℂ))
    simp only [hw, hw'] at h
    exact h
  constructor
  · calc D.hF.matrixUnit p p * D.levelUnit σ n w w'
        = ampConj D.U (InnerProductSpace.rankOne ℂ (lp.single 2 p (1 : ℂ) : ℓ²(D.F, ℂ))
            (lp.single 2 p 1)) *
          ampConj D.U (cuntzWord (cuntzS σ) n w * star (cuntzWord (cuntzS σ) n w')) := by
          rw [D.ampConj_rankOne p p]
          rfl
      _ = ampConj D.U (InnerProductSpace.rankOne ℂ (lp.single 2 p (1 : ℂ) : ℓ²(D.F, ℂ))
            (lp.single 2 p 1) *
          (cuntzWord (cuntzS σ) n w * star (cuntzWord (cuntzS σ) n w'))) :=
          (map_mul (ampConj D.U) _ _).symm
      _ = D.hF.matrixUnit p q := by rw [e1, D.ampConj_rankOne p q]
  · calc D.levelUnit σ n w w' * D.hF.matrixUnit q q
        = ampConj D.U (cuntzWord (cuntzS σ) n w * star (cuntzWord (cuntzS σ) n w')) *
          ampConj D.U (InnerProductSpace.rankOne ℂ (lp.single 2 q (1 : ℂ) : ℓ²(D.F, ℂ))
            (lp.single 2 q 1)) := by
          rw [D.ampConj_rankOne q q]
          rfl
      _ = ampConj D.U ((cuntzWord (cuntzS σ) n w * star (cuntzWord (cuntzS σ) n w')) *
          InnerProductSpace.rankOne ℂ (lp.single 2 q (1 : ℂ) : ℓ²(D.F, ℂ))
            (lp.single 2 q 1)) :=
          (map_mul (ampConj D.U) _ _).symm
      _ = D.hF.matrixUnit p q := by rw [e2, D.ampConj_rankOne p q]

/-- An operator commuting with all level matrix units commutes with every library matrix
unit `e_{pq}`. -/
lemma commute_matrixUnit_of_levels {T : H →L[ℂ] H}
    (hT : ∀ n w w', D.levelUnit σ n w w' * T = T * D.levelUnit σ n w w') (p q : D.F) :
    T * D.hF.matrixUnit p q = D.hF.matrixUnit p q * T := by
  refine commute_matrixUnit_of D.hF.matrixUnit D.matrixUnit_mul D.hres' ?_ ?_ p q
  · intro r p hrp
    obtain ⟨wr, hwr⟩ := exists_word_eq σ r (le_max_left (σ r) (σ p))
    obtain ⟨wp, hwp⟩ := exists_word_eq σ p (le_max_right (σ r) (σ p))
    have h_r := (D.matrixUnit_mul_levelUnit σ hwr hwr).1
    have h_p := (D.matrixUnit_mul_levelUnit σ hwp hwp).2
    have hne : wr ≠ wp := by
      rintro rfl
      exact hrp (single_one_injective (hwr.symm.trans hwp))
    have h0 : D.levelUnit σ _ wr wr * D.levelUnit σ _ wp wp = 0 := by
      rw [(D.levelUnit_isMatrixUnits σ _).mul_eq, ite_eq_right hne]
    calc D.hF.matrixUnit r r * T * D.hF.matrixUnit p p
        = (D.hF.matrixUnit r r * D.levelUnit σ _ wr wr) * T *
            (D.levelUnit σ _ wp wp * D.hF.matrixUnit p p) := by rw [h_r, h_p]
      _ = D.hF.matrixUnit r r * (D.levelUnit σ _ wr wr * T) * D.levelUnit σ _ wp wp *
            D.hF.matrixUnit p p := by simp only [mul_assoc]
      _ = D.hF.matrixUnit r r * T * (D.levelUnit σ _ wr wr * D.levelUnit σ _ wp wp) *
            D.hF.matrixUnit p p := by
          rw [hT]
          simp only [mul_assoc]
      _ = 0 := by rw [h0, mul_zero, zero_mul]
  · intro p q
    obtain ⟨wp, hwp⟩ := exists_word_eq σ p (le_max_left (σ p) (σ q))
    obtain ⟨wq, hwq⟩ := exists_word_eq σ q (le_max_right (σ p) (σ q))
    obtain ⟨h_l, h_r⟩ := D.matrixUnit_mul_levelUnit σ hwp hwq
    calc D.hF.matrixUnit p p * T * D.hF.matrixUnit p q
        = D.hF.matrixUnit p p * T * (D.levelUnit σ _ wp wq * D.hF.matrixUnit q q) := by
          rw [h_r]
      _ = D.hF.matrixUnit p p * (D.levelUnit σ _ wp wq * T) * D.hF.matrixUnit q q := by
          rw [hT]
          simp only [mul_assoc]
      _ = D.hF.matrixUnit p q * T * D.hF.matrixUnit q q := by
          rw [← h_l]
          simp only [mul_assoc]

/-- **Generation.** The level subfactors generate `X'`. -/
lemma level_generates : X' = generated (⋃ n, (D.level σ n : Set (H →L[ℂ] H))) := by
  apply le_antisymm
  · calc X' = generated (Set.range fun pq : D.F × D.F => D.hF.matrixUnit pq.1 pq.2) :=
          (D.hF.generated_matrixUnits_eq D.he D.htop).symm
      _ ≤ _ := by
          refine generated_le ?_
          rintro _ ⟨⟨p, q⟩, rfl⟩
          show D.hF.matrixUnit p q ∈ (commutantSet _).commutant
          rw [mem_commutant_iff]
          intro T hT
          exact D.commute_matrixUnit_of_levels σ (fun n w w' =>
            (mem_commutantSet_iff.mp hT _
              (Set.mem_iUnion.mpr ⟨n, D.levelUnit_mem_level σ n w w'⟩)).1) p q
  · exact generated_le (Set.iUnion_subset fun n => D.level_le σ n)

end TypeIData

end TypeIDataSection

/-! ### Internal main results (matrix-unit form) -/

/-- A type I factor on a separable Hilbert space is generated by an increasing sequence of
matrix-unit subfactors contained in it. -/
theorem exists_mu_approx [TopologicalSpace.SeparableSpace H]
    {N : VonNeumannAlgebra H} (hN : IsTypeIFactor N) :
    ∃ G : ℕ → VonNeumannAlgebra H, Monotone G ∧ (∀ n, ∃ d, IsMUSubfactor (G n) d) ∧
      (∀ n, G n ≤ N) ∧ N = generated (⋃ n, (G n : Set (H →L[ℂ] H))) := by
  classical
  rcases subsingleton_or_nontrivial H with hH | hH
  · exact ⟨fun _ => N, monotone_const, fun _ => ⟨0, isMUSubfactor_zero_of_subsingleton N⟩,
      fun _ => le_rfl, eq_of_subsingleton _ _⟩
  obtain ⟨D⟩ := exists_typeIData hN
  rcases finite_or_infinite D.F with hfin | hinf
  · have := Fintype.ofFinite D.F
    exact ⟨fun _ => N, monotone_const, fun _ => ⟨_, D.isMUSubfactor⟩, fun _ => le_rfl,
      (generated_iUnion_const N).symm⟩
  · have : Countable D.F := D.countable
    obtain ⟨σ⟩ : Nonempty (D.F ≃ ℕ) := inferInstance
    exact ⟨D.level σ, D.level_mono σ, fun n => ⟨_, D.level_isMUSubfactor σ n⟩,
      D.level_le σ, D.level_generates σ⟩

/-- **The relative commutant of a type I subfactor of a type I factor is a type I factor.** -/
theorem relCommutant_isTypeIFactor {X' X : VonNeumannAlgebra H} (hX' : IsTypeIFactor X')
    (hX : IsTypeIFactor X) (hle : X' ≤ X) : IsTypeIFactor (relCommutant X' X) := by
  rcases subsingleton_or_nontrivial H with _ | _
  · exact isTypeIFactor_of_subsingleton _
  obtain ⟨D⟩ := exists_typeIData hX'
  have hfac : IsFactor (relCommutant X' X) := fun z hz hz' =>
    hX.1 z (mem_relCommutant_iff.mp hz).2
      (D.mem_commutant_of_rel hle (mem_relCommutant_iff.mp hz).1 hz')
  obtain ⟨f₀, hf₀⟩ := hX.exists_isMinimalProjection
  obtain ⟨g, -, hgle, hf₀g⟩ := hf₀.mvNSub_of_isFactor hX.1 D.P_proj (hle D.P_mem) D.P_ne_zero
  have hg : IsMinimalProjection X g := hf₀.of_mvNEquiv hf₀g
  have hPg : D.P * g = g := (hg.1.le_iff_mul_eq_right D.P_proj).mp hgle
  have hgP : g * D.P = g := (hg.1.le_iff_mul_eq_left D.P_proj).mp hgle
  have hPgP : D.P * g * D.P = g := by rw [hPg, hgP]
  exact hfac.isTypeIFactor_of_isMinimalProjection (D.isMinimalProjection_lift hle hg hPgP)

/-- **Tensor splitting `X = X' ∨ (X'′ ∩ X)`** for a type I factor `X' ≤ X`. -/
theorem generated_union_relCommutant {X' X : VonNeumannAlgebra H} (hX' : IsTypeIFactor X')
    (hle : X' ≤ X) :
    X = generated ((X' : Set (H →L[ℂ] H)) ∪ (relCommutant X' X : Set (H →L[ℂ] H))) := by
  rcases subsingleton_or_nontrivial H with _ | _
  · exact eq_of_subsingleton _ _
  obtain ⟨D⟩ := exists_typeIData hX'
  apply le_antisymm
  · intro x hx
    show x ∈ (commutantSet _).commutant
    rw [mem_commutant_iff]
    intro T hT
    have hT1 : T ∈ X'.commutant :=
      mem_commutant_iff.mpr fun g hg => (mem_commutantSet_iff.mp hT g (Or.inl hg)).1
    have hT2 : T ∈ (relCommutant X' X).commutant :=
      mem_commutant_iff.mpr fun g hg => (mem_commutantSet_iff.mp hT g (Or.inr hg)).1
    exact (mem_commutant_iff.mp (D.mem_commutant_of_rel hle hT1 hT2) x hx).symm
  · exact generated_le (Set.union_subset hle fun z hz => (mem_relCommutant_iff.mp hz).2)

/-- Split form: increasing matrix-unit subfactors `P n ↑ X'` and `R n ↑ X'′ ∩ X`. -/
theorem exists_mu_approx_split [TopologicalSpace.SeparableSpace H]
    {X' X : VonNeumannAlgebra H} (hX' : IsTypeIFactor X') (hX : IsTypeIFactor X)
    (hle : X' ≤ X) :
    ∃ P R : ℕ → VonNeumannAlgebra H, Monotone P ∧ Monotone R ∧
      (∀ n, ∃ d, IsMUSubfactor (P n) d) ∧ (∀ n, ∃ d, IsMUSubfactor (R n) d) ∧
      (∀ n, P n ≤ X') ∧ (∀ n, R n ≤ relCommutant X' X) ∧
      X' = generated (⋃ n, (P n : Set (H →L[ℂ] H))) ∧
      relCommutant X' X = generated (⋃ n, (R n : Set (H →L[ℂ] H))) := by
  obtain ⟨P, hPm, hPd, hPle, hPgen⟩ := exists_mu_approx hX'
  obtain ⟨R, hRm, hRd, hRle, hRgen⟩ :=
    exists_mu_approx (relCommutant_isTypeIFactor hX' hX hle)
  exact ⟨P, R, hPm, hRm, hPd, hRd, hPle, hRle, hPgen, hRgen⟩

/-- Generation of `X` by `(P n ∪ R n)''` from the split data. -/
theorem generated_union_eq_of_split {X' X : VonNeumannAlgebra H} (hX' : IsTypeIFactor X')
    (hle : X' ≤ X) {P R : ℕ → VonNeumannAlgebra H} (hPle : ∀ n, P n ≤ X')
    (hRle : ∀ n, R n ≤ relCommutant X' X)
    (hPgen : X' = generated (⋃ n, (P n : Set (H →L[ℂ] H))))
    (hRgen : relCommutant X' X = generated (⋃ n, (R n : Set (H →L[ℂ] H)))) :
    X = generated (⋃ n, (generated ((P n : Set (H →L[ℂ] H)) ∪ R n) : Set (H →L[ℂ] H))) := by
  have hRX : ∀ n, R n ≤ X := fun n _ hx => (mem_relCommutant_iff.mp (hRle n hx)).2
  apply le_antisymm
  · calc X = generated ((X' : Set (H →L[ℂ] H)) ∪ (relCommutant X' X : Set (H →L[ℂ] H))) :=
          generated_union_relCommutant hX' hle
      _ ≤ _ := by
          refine generated_le (Set.union_subset ?_ ?_)
          · intro x hx
            rw [hPgen] at hx
            exact generated_mono (Set.iUnion_mono fun n => fun y hy =>
              mem_generated_of_mem (Or.inl hy)) hx
          · intro x hx
            rw [hRgen] at hx
            exact generated_mono (Set.iUnion_mono fun n => fun y hy =>
              mem_generated_of_mem (Or.inr hy)) hx
  · exact generated_le (Set.iUnion_subset fun n =>
      generated_le (Set.union_subset (fun _ hx => hle (hPle n hx)) (fun _ hx => hRX n hx)))

end T4

/-! ### Headline result -/

/-- **T4 (tensor-compatible).** For type I factors `X' ≤ X` on a separable Hilbert space there
are increasing sequences `P n ≤ X'` and `R n ≤ X ∩ X'′` (so `P n` and `R n` commute), each
`⋆`-isomorphic to some `B(ℂ^d)`, with `X' = (⋃ P n)''` and `X = (⋃ join (P n) (R n))''`. The `R n`
approximate the relative commutant `X'′ ∩ X` (`T4.exists_mu_approx_split`). -/
theorem exists_matrixSubfactor_seq_pair {H : Type*} [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [CompleteSpace H] [TopologicalSpace.SeparableSpace H]
    {X' X : VonNeumannAlgebra H} (hX' : IsTypeIFactor X') (hX : IsTypeIFactor X)
    (hle : X' ≤ X) :
    ∃ P R : ℕ → VonNeumannAlgebra H, Monotone P ∧ Monotone R ∧ (∀ n, P n ≤ X') ∧
      (∀ n, R n ≤ X) ∧ (∀ n, R n ≤ X'.commutant) ∧
      X' = generated (⋃ n, (P n : Set (H →L[ℂ] H))) ∧
      X = generated (⋃ n, (join (P n) (R n) : Set (H →L[ℂ] H))) ∧
      (∀ n, ∃ d, Nonempty (P n ≃⋆ₐ[ℂ]
        (EuclideanSpace ℂ (Fin d) →L[ℂ] EuclideanSpace ℂ (Fin d)))) ∧
      (∀ n, ∃ d, Nonempty (R n ≃⋆ₐ[ℂ]
        (EuclideanSpace ℂ (Fin d) →L[ℂ] EuclideanSpace ℂ (Fin d)))) := by
  rcases subsingleton_or_nontrivial H with hH | hH
  · have h0 : ∀ M : VonNeumannAlgebra H, ∃ d, Nonempty (M ≃⋆ₐ[ℂ]
        (EuclideanSpace ℂ (Fin d) →L[ℂ] EuclideanSpace ℂ (Fin d))) := fun M =>
      ⟨0, (T4.isMUSubfactor_zero_of_subsingleton M).nonempty_starAlgEquiv (Or.inr rfl)⟩
    exact ⟨fun _ => X', fun _ => X'.commutant, monotone_const, monotone_const,
      fun _ => le_rfl, fun _ => (T4.eq_of_subsingleton _ X).le, fun _ => le_rfl,
      T4.eq_of_subsingleton _ _, T4.eq_of_subsingleton _ _, fun _ => h0 _, fun _ => h0 _⟩
  obtain ⟨P, R, hPm, hRm, hPd, hRd, hPle, hRle, hPgen, hRgen⟩ :=
    T4.exists_mu_approx_split hX' hX hle
  refine ⟨P, R, hPm, hRm, hPle, fun n _ hx => (T4.mem_relCommutant_iff.mp (hRle n hx)).2,
    fun n _ hx => (T4.mem_relCommutant_iff.mp (hRle n hx)).1, hPgen,
    T4.generated_union_eq_of_split hX' hle hPle hRle hPgen hRgen, fun n => ?_, fun n => ?_⟩
  · obtain ⟨d, hd⟩ := hPd n
    exact ⟨d, hd.nonempty_starAlgEquiv (Or.inl hH)⟩
  · obtain ⟨d, hd⟩ := hRd n
    exact ⟨d, hd.nonempty_starAlgEquiv (Or.inl hH)⟩

end

end CTheorem
